local centreLobbyChams, prochainScanLobbyChams = nil, 0
local function estAuLobbyPourChams()
	local maintenant = os.clock()
	if maintenant >= prochainScanLobbyChams then
		prochainScanLobbyChams = maintenant + 1
		centreLobbyChams = nil
		local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("lobby")
		if lobby then
			local spawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
			if spawn then
				centreLobbyChams = spawn.Position
			else
				local ok, cf = pcall(function() return lobby:GetBoundingBox() end)
				if ok then centreLobbyChams = cf.Position end
			end
		end
	end
	if not centreLobbyChams or not racine then return false end
	return (racine.Position - centreLobbyChams).Magnitude < 80
end

local function aOutil(joueurCible, nom)
	local perso = joueurCible.Character
	local sac = joueurCible:FindFirstChildOfClass("Backpack")
	local attendu = string.lower(nom)
	local variantes = {
		[attendu] = true,
		[attendu .. "display"] = true,
		[attendu .. "_display"] = true,
		[attendu .. " display"] = true,
	}
	local function contient(container)
		if not container then return false end
		for _, objet in ipairs(container:GetChildren()) do
			if (objet:IsA("Tool") or objet:IsA("Model") or objet:IsA("Folder"))
				and variantes[string.lower(objet.Name)] then
				return true
			end
		end
		return false
	end
	return contient(perso) or contient(sac)
end

local function joueurVivant(p)
	if not p then return false end
	local perso = p.Character
	local hum = perso and perso:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function calculerRoles()

	if finMancheEnAttente then
		finMancheEnAttente = false
		armesVues = false
		tDerniereArme = 0
		sheriffOrigine = nil
	end
	if nouvelleMancheAnnoncee then
		nouvelleMancheAnnoncee = false
		armesVues = false
		tDerniereArme = 0
		sheriffOrigine = nil
		table.clear(joueursElimines)
	end

	if mancheTerminee then
		local tousInnocents = {}
		for _, p in ipairs(Players:GetPlayers()) do tousInnocents[p] = "innocent" end
		rolesParJoueur = tousInnocents
		infoManche, infoMurder, infoSherif, infoHeros = "Aucune", "—", "—", "—"
		return
	end

	local murder = nil
	local porteurs = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if joueurVivant(p) and not joueursElimines[p.Name] then
			if aOutil(p, "Knife") then murder = p end
			if aOutil(p, "Gun") then porteurs[#porteurs + 1] = p end
		end
	end

	local sheriffMort = sheriffOrigine ~= nil and not joueurVivant(sheriffOrigine)

	if not sheriffOrigine then
		for _, p in ipairs(Players:GetPlayers()) do
			if rolesServeur[p.Name] == "sherif" then
				sheriffOrigine = p
				break
			end
		end
	end

	if #porteurs > 0 and not sheriffOrigine then sheriffOrigine = porteurs[1] end

	if murder or #porteurs > 0 then
		armesVues = true
		tDerniereArme = os.clock()
	elseif armesVues and os.clock() - tDerniereArme > 3
		and os.clock() - dernierRoleServeur > 10 then

		armesVues = false
		table.clear(rolesServeur)
		table.clear(joueursElimines)
		sheriffOrigine = nil
	end

	local sherif, heros = nil, nil
	for _, p in ipairs(porteurs) do
		if p == sheriffOrigine and joueurVivant(p) then
			sherif = p
		else
			heros = p
		end
	end

	local nouveau = {}
	local srvActif = false
	for _, p in ipairs(Players:GetPlayers()) do
		local r = "innocent"
		local personnage = p.Character
		local hum = personnage and personnage:FindFirstChildOfClass("Humanoid")
		local personnageCharge = hum ~= nil
		local vivant = personnageCharge and hum.Health > 0
		local srv = rolesServeur[p.Name]

		if joueursElimines[p.Name] then
			r = "innocent"
		elseif not personnageCharge then

			if srv and srv ~= "innocent" then
				r = srv
				srvActif = true
			end
		elseif not vivant then

			rolesServeur[p.Name] = nil
			joueursElimines[p.Name] = true
			r = "innocent"
		elseif p == murder then
			r = "murder"
		elseif p == heros then
			r = "heros"
		elseif p == sherif then
			r = "sherif"
		end

		if personnageCharge and vivant and not joueursElimines[p.Name] and srv and srv ~= "innocent" then
			if r == "innocent" then r = srv end
			srvActif = true
		end
		nouveau[p] = r
	end
	rolesParJoueur = nouveau

	murder, sherif, heros = nil, nil, nil
	for p, r in pairs(nouveau) do
		if r == "murder" then murder = p
		elseif r == "sherif" then sherif = p
		elseif r == "heros" then heros = p end
	end

	infoManche = (srvActif or murder or #porteurs > 0) and "En cours" or "Aucune"
	infoMurder = murder and murder.Name or "—"
	infoSherif = sherif and sherif.Name or "—"
	infoHeros = heros and heros.Name or "—"
end

function couleurRole(role)
	if role == "murder" then return COL.COULEUR_MURDER end
	if role == "sherif" then return COL.COULEUR_SHERIF end
	if role == "heros" then return COL.COULEUR_HEROS end
	return COL.COULEUR_INNOCENT
end

