local armeCache, objetArmeCache, tRechercheArme = nil, nil, 0
local function trouverArmeTombee()

	if objetArmeCache and objetArmeCache.Parent
		and objetArmeCache:IsDescendantOf(workspace)
		and armeCache and armeCache.Parent and armeCache:IsA("BasePart") then
		return armeCache, objetArmeCache
	end

	local maintenant = os.clock()
	if maintenant - tRechercheArme < 0.25 then return nil, nil end
	tRechercheArme = maintenant
	armeCache, objetArmeCache = nil, nil

	local objet = workspace:FindFirstChild("GunDrop", true)
	if not objet then return nil, nil end

	if objet:IsA("BasePart") then
		armeCache = objet
	else
		armeCache = objet:FindFirstChildWhichIsA("BasePart", true)
	end
	if armeCache then objetArmeCache = objet end
	return armeCache, objetArmeCache
end

local function majArme()

    if not armeActive and not alerteArmeOn then
        infoArme = "Non"
        retirerArme()
        return
    end
    local partie, objetGun = trouverArmeTombee()
    infoArme = partie and "Oui" or "Non"

    if not armeActive or not partie or not objetGun then
        retirerArme()
        return
    end

    -- Portée maximale du chams pistolet
    if racine and (partie.Position - racine.Position).Magnitude > DISTANCE_MAX_CHAMS then
        retirerArme()
        return
    end

    if not haloArme or not haloArme.Parent
        or haloArme.Adornee ~= objetGun then

        retirerArme()

        haloArme = Instance.new("Highlight")
        haloArme.Name = "PistoletDore"
        haloArme.Adornee = objetGun
        haloArme.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        haloArme.FillColor = Color3.fromRGB(255, 195, 0)
        haloArme.OutlineColor = Color3.fromRGB(255, 255, 70)
        haloArme.FillTransparency = 0.08
        haloArme.OutlineTransparency = 0
        haloArme.Parent = workspace

        etiquetteArme = creerPastille(partie, partie, 2.4, 140, false)
        etiquetteArme.Size = UDim2.fromOffset(140, 24)
    end

    local nomArme = etiquetteArme and etiquetteArme:FindFirstChild("Nom")
    if nomArme then
        nomArme.Text = "Pistolet"
        nomArme.TextColor3 = Color3.fromRGB(255, 225, 25)
        nomArme.TextSize = 16
        nomArme.Font = Enum.Font.GothamBlack
        nomArme.TextStrokeColor3 = Color3.fromRGB(120, 65, 0)
        nomArme.TextStrokeTransparency = 0
    end
end

