do
local flyOn, flySpeed, noclipOn = flyControl.flyOn, flyControl.flySpeed, flyControl.noclipOn
local noclipTransparence = (flyControl.noclipTransp or 65) / 100
local flyVelocity, flyGyro = nil, nil
local flyKeys = {W=false, A=false, S=false, D=false, Up=false, Down=false}
local flyOldAutoRotate = nil

local flySonsSilences = {}
local flySonAjouteConnection = nil
local flySonsPersonnage = nil
local flySonsInitialises = false
local function appliquerSilencePas(instance)
    if not instance or not instance:IsA("Sound") then return end
    local nom = string.lower(instance.Name)
    if nom == "running" or nom == "walking" or nom == "footsteps" or nom == "footstep" then
        if flySonsSilences[instance] == nil then
            flySonsSilences[instance] = instance.Volume
        end
        pcall(function() instance.Volume = 0; instance:Stop() end)
    end
end
local function couperSonsPasFly()
    local personnage = joueur.Character
    if not personnage then return end

    -- Après un respawn, l'ancienne connexion ne doit pas empêcher le nouveau
    -- personnage d'être surveillé pour ses sons de marche.
    if flySonsPersonnage ~= personnage then
        if flySonAjouteConnection then
            pcall(function() flySonAjouteConnection:Disconnect() end)
            flySonAjouteConnection = nil
        end
        for son, volume in pairs(flySonsSilences) do
            if son and son.Parent then pcall(function() son.Volume = volume end) end
        end
        table.clear(flySonsSilences)
        flySonsPersonnage = personnage
        flySonsInitialises = false
    end

    -- Le scan initial est fait une seule fois par personnage. Ensuite,
    -- DescendantAdded prend en charge les nouveaux sons sans rescanner tout
    -- l'avatar à chaque frame du RenderStepped.
    if not flySonsInitialises then
        for _, objet in ipairs(personnage:GetDescendants()) do
            appliquerSilencePas(objet)
        end
        flySonsInitialises = true
    end
    if not flySonAjouteConnection then
        flySonAjouteConnection = connecter(personnage.DescendantAdded, function(objet)
            if flyOn and joueur.Character == personnage then appliquerSilencePas(objet) end
        end)
    end
end
local function restaurerSonsPasFly()
    if flySonAjouteConnection then pcall(function() flySonAjouteConnection:Disconnect() end); flySonAjouteConnection = nil end
    for son, volume in pairs(flySonsSilences) do
        if son and son.Parent then pcall(function() son.Volume = volume end) end
    end
    table.clear(flySonsSilences)
    flySonsPersonnage = nil
    flySonsInitialises = false
end
local noclipOriginal = {}
local noclipVisualOriginal = {}
local noclipAddedConnection = nil
local noclipCharacter = nil
local noclipRefY = nil

local CHUTE_MAX_NOCLIP = 80

local function nettoyerFly()
    restaurerSonsPasFly()
    if flyVelocity then pcall(function() flyVelocity:Destroy() end); flyVelocity = nil end
    if flyGyro then pcall(function() flyGyro:Destroy() end); flyGyro = nil end
    for key in pairs(flyKeys) do flyKeys[key] = false end

    if racine and racine.Parent then
        pcall(function()
            racine.AssemblyLinearVelocity = Vector3.zero
            racine.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if humanoide and humanoide.Parent then
        pcall(function()
            humanoide.PlatformStand = false
            humanoide.Sit = false
            if flyOldAutoRotate ~= nil then humanoide.AutoRotate = flyOldAutoRotate end
            humanoide:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.defer(function()
                if humanoide and humanoide.Parent and not flyOn
                    and not flyControl.farmActif and not flingActif then
                    pcall(function() humanoide:ChangeState(Enum.HumanoidStateType.Running) end)
                end
            end)
        end)
    end
    flyOldAutoRotate = nil
end

local function preparerFly()
    if not flyOn or flingActif or not racine or not racine.Parent then return end
    couperSonsPasFly()
    if not flyVelocity or flyVelocity.Parent ~= racine then
        if flyVelocity then pcall(function() flyVelocity:Destroy() end) end
        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.Name = "TenebresFlyVelocity"
        flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyVelocity.P = 2e4
        flyVelocity.Velocity = Vector3.zero
        flyVelocity.Parent = racine
    end
    if not flyGyro or flyGyro.Parent ~= racine then
        if flyGyro then pcall(function() flyGyro:Destroy() end) end
        flyGyro = Instance.new("BodyGyro")
        flyGyro.Name = "TenebresFlyGyro"
        flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyGyro.P = 2e4
        flyGyro.D = 800
        flyGyro.CFrame = racine.CFrame
        flyGyro.Parent = racine
    end
    if humanoide and flyOldAutoRotate == nil then
        flyOldAutoRotate = humanoide.AutoRotate
        humanoide.AutoRotate = false
    end
end

local function mettreAJourFly()
    if not flyOn or flingActif then return end
    if not racine or not racine.Parent then return end
    preparerFly()
    if not flyVelocity or not flyGyro then return end
    local camera = workspace.CurrentCamera
    if not camera then return end

    local avant = camera.CFrame.LookVector
    local droite = camera.CFrame.RightVector
    local direction = Vector3.zero
    if flyKeys.W or flyKeys.Up then direction += avant end
    if flyKeys.S or flyKeys.Down then direction -= avant end
    if flyKeys.D then direction += droite end
    if flyKeys.A then direction -= droite end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
        direction -= Vector3.yAxis
    end

    if direction.Magnitude > 0.001 then
        local vitesse = flySpeed
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vitesse = vitesse * 2 end
        flyVelocity.Velocity = direction.Unit * vitesse
    else
        flyVelocity.Velocity = Vector3.zero
        racine.AssemblyLinearVelocity = Vector3.zero
    end

    local look, up = camera.CFrame.LookVector, camera.CFrame.UpVector
    flyGyro.CFrame = CFrame.lookAt(racine.Position, racine.Position + look, up)

    if humanoide then
        pcall(function()
            humanoide.PlatformStand = true
            humanoide:ChangeState(Enum.HumanoidStateType.Physics)
        end)
    end
end

local function oublierNoclipPart(part, rendre)
    if rendre and part.Parent then
        local c = noclipOriginal[part]
        if c ~= nil then pcall(function() part.CanCollide = c end) end
        local v = noclipVisualOriginal[part]
        if v ~= nil then pcall(function() part.LocalTransparencyModifier = v end) end
    end
    noclipOriginal[part] = nil
    noclipVisualOriginal[part] = nil
end

local function viderNoclip()
    if noclipAddedConnection then noclipAddedConnection:Disconnect(); noclipAddedConnection = nil end
    for part in pairs(noclipOriginal) do oublierNoclipPart(part, true) end
    for part in pairs(noclipVisualOriginal) do oublierNoclipPart(part, true) end
    table.clear(noclipOriginal)
    table.clear(noclipVisualOriginal)
    noclipRefY = nil
    noclipCharacter = nil
end

local function appliquerNoclipPart(part)
    if not noclipOn or not part or not part:IsA("BasePart") then return end
    if noclipOriginal[part] == nil then noclipOriginal[part] = part.CanCollide end
    if noclipVisualOriginal[part] == nil then noclipVisualOriginal[part] = part.LocalTransparencyModifier end
    part.CanCollide = false
    part.LocalTransparencyModifier = noclipTransparence
end

local function attacherNoclip(character)
    viderNoclip()
    noclipCharacter = character
    if not noclipOn or not character then return end
    for _, part in ipairs(character:GetDescendants()) do appliquerNoclipPart(part) end
    noclipAddedConnection = connecter(character.DescendantAdded, appliquerNoclipPart)
    noclipRefY = racine and racine.Position.Y or nil
end

connecter(RunService.Stepped, function()
    if fermee or not noclipOn then return end

    for part in pairs(noclipOriginal) do
        if part.Parent then
            if part.CanCollide then part.CanCollide = false end
        else
            noclipOriginal[part] = nil
            noclipVisualOriginal[part] = nil
        end
    end

    if not racine or not racine.Parent then return end
    local y = racine.Position.Y
    if humanoide and humanoide.FloorMaterial ~= Enum.Material.Air then
        noclipRefY = y
    elseif flyControl.flyOn or flyControl.farmActif or flingActif then

        noclipRefY = y
    elseif noclipRefY and y < noclipRefY - CHUTE_MAX_NOCLIP then

        pcall(function()
            racine.AssemblyLinearVelocity = Vector3.zero
            racine.CFrame = CFrame.new(racine.Position.X, noclipRefY + 3, racine.Position.Z)
        end)
    end
end)

