-- Un seul tween actif par objet : un nouvel état remplace proprement l'ancien.
-- Les clés faibles évitent de retenir les composants détruits.
local tweensActifs = setmetatable({}, { __mode = "k" })
local function tw(o, props, t, style)
	if not o then return nil end
	local ancien = tweensActifs[o]
	if ancien then
		pcall(function() ancien:Cancel() end)
	end
	local ok, anim = pcall(function()
		return TweenService:Create(
			o,
			TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			props
		)
	end)
	if not ok or not anim then return nil end
	tweensActifs[o] = anim
	anim.Completed:Connect(function()
		if tweensActifs[o] == anim then
			tweensActifs[o] = nil
		end
	end)
	anim:Play()
	return anim
end
