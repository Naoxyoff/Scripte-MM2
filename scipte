        for _, nom in ipairs({"Map", "map", "Baseplate", "baseplate"}) do
            local objet = workspace:FindFirstChild(nom)
            if objet then
                if objet:IsA("BasePart") then return objet.Position end
                if objet:IsA("Model") then
                    local ok, cf = pcall(function() return objet:GetBoundingBox() end)
                    if ok and cf then return cf.Position end
                end
            end
        end
