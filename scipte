		if type(v) ~= "string" then return nil end
		local t = string.lower(v)
		t = string.gsub(t, "[%s_%-]", "")
		-- Correspondances exactes : ne pas confondre un texte descriptif
		-- contenant "murder" avec un véritable rôle.
		if t == "murder" or t == "murderer" then return "murder" end
		if t == "sheriff" or t == "sherif" then return "sherif" end
		if t == "hero" or t == "heros" then return "heros" end
		if t == "innocent" then return "innocent" end
		return nil
	end
	local function joueurDepuisCle(cle)
		if typeof(cle) == "Instance" and cle:IsA("Player") then
			return cle
		end
		if type(cle) ~= "string" and type(cle) ~= "number" then return nil end
		local texte = tostring(cle)
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name == texte or tostring(p.UserId) == texte then return p end
		end
		return nil
	end
	local function lireTable(t)
		if type(t) ~= "table" then return nil end
		local res, trouve, visites = {}, false, {}
		local function parcourir(tab, profondeur)
			if type(tab) ~= "table" or profondeur > 5 or visites[tab] then return end
			visites[tab] = true
			for k, v in pairs(tab) do
				local p = joueurDepuisCle(k)
				if type(v) == "table" then
					local r = normaliser(v.Role or v.role or v.RoleName or v.roleName or v.PlayerRole or v.playerRole)
					local identifiant = v.Player or v.player or v.PlayerId or v.playerId
						or v.UserId or v.userId or v.Username or v.username or v.PlayerName or v.playerName
					local joueurValeur = joueurDepuisCle(identifiant)
					if r and (p or joueurValeur) then
						res[(p or joueurValeur).Name] = r
						trouve = true
					else
						parcourir(v, profondeur + 1)
					end
				elseif p and type(v) == "string" then
					local r = normaliser(v)
					if r then res[p.Name] = r trouve = true end
				elseif type(v) == "table" then
