    pilule(rempli)
    creer("UIGradient", { Color = ColorSequence.new(COL.ROUGE, COL.ORCHIDEE) }, rempli)
    local rond = creer("Frame", {
        Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = COL.BLANC,
        BorderSizePixel = 0, ZIndex = 2,
    }, piste)
    pilule(rond)
    creer("UIStroke", { Thickness = 1.5, Color = COL.ROUGE, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, rond)
    local puce = creer("Frame", {
        Size = UDim2.fromOffset(64, 24), Position = UDim2.new(1, -80, 0, 55),
        BackgroundColor3 = COL.CARTE_CLAIRE, BorderSizePixel = 0,
    }, c)
    pilule(puce)
    local valeurLabel = creer("TextBox", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = formaterValeurCurseur(defaut, suffixe),
        Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center,
        TextColor3 = COL.ORCHIDEE, ClearTextOnFocus = false,
        TextEditable = true, MultiLine = false,
    }, puce)
    local zone = creer("TextButton", {
        Size = UDim2.new(1, -136, 0, 28), Position = UDim2.fromOffset(22, 53),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, c)
    local valeurActuelle = defaut
    local function placer(valeur)
        local rel = math.clamp((valeur - minimum) / math.max(maximum - minimum, 0.000001), 0, 1)
        rempli.Size = UDim2.new(rel, 0, 1, 0)
        rond.Position = UDim2.new(rel, 0, 0.5, 0)
    end
    local function appliquerValeur(valeur, sauvegarder)
        valeur = bornerValeurCurseur(valeur, minimum, maximum)
        valeurActuelle = valeur
        placer(valeur)
        valeurLabel.Text = formaterValeurCurseur(valeur, suffixe)
        if sauvegarder then enregistrerConfig(cleValeur, valeur) end
        if rappelValeur then pcall(rappelValeur, valeur) end
    end
    appliquerValeur(defaut, false)
    local function depuisX(x)
        local rel = math.clamp((x - piste.AbsolutePosition.X) / math.max(piste.AbsoluteSize.X, 1), 0, 1)
        appliquerValeur(minimum + (maximum - minimum) * rel, true)
    end
    local glisse = false
    connecter(zone.InputBegan, function(e)
        if e.UserInputType == Enum.UserInputType.MouseButton1 or e.UserInputType == Enum.UserInputType.Touch then
            glisse = true
            tw(rond, { Size = UDim2.fromOffset(14, 14) }, 0.1)
            depuisX(e.Position.X)
        end
    end)
    connecter(UserInputService.InputChanged, function(e)
        if glisse and (e.UserInputType == Enum.UserInputType.MouseMovement or e.UserInputType == Enum.UserInputType.Touch) then
            depuisX(e.Position.X)
        end
    end)
    connecter(UserInputService.InputEnded, function(e)
        if e.UserInputType == Enum.UserInputType.MouseButton1 or e.UserInputType == Enum.UserInputType.Touch then
            if glisse then tw(rond, { Size = UDim2.fromOffset(12, 12) }, 0.1) end
            glisse = false
        end
    end)
    connecter(valeurLabel.FocusLost, function()
        local saisie = tonumber((valeurLabel.Text or ""):gsub(",", "."))
        if saisie then
            appliquerValeur(saisie, true)
        else
            valeurLabel.Text = formaterValeurCurseur(valeurActuelle, suffixe)
        end
    end)
    return inter
end
