	local r = string.upper(txt)
	for min, maj in pairs({ ["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["ë"] = "Ë", ["à"] = "À", ["â"] = "Â",
		["î"] = "Î", ["ï"] = "Ï", ["ô"] = "Ô", ["ù"] = "Ù", ["û"] = "Û", ["ç"] = "Ç" }) do
		r = string.gsub(r, min, maj)
	end
	return r
end
local function section(page, titre)
