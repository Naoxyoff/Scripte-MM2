				pcall(function()
					h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not ancien or ancien.fallingDown == true)
					h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not ancien or ancien.ragdoll == true)
				end)
				etatHumanoideAvantFarm = nil
			end
		end)
	end
	if noclipParFarm then
		noclipParFarm = false
		if flyControl.noclipOn then flyControl.activerNoclip(false, true) end
	end
	if flyEtaitActif then
