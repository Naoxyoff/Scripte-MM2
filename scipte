local function majVisuel(joueurCible)
	local perso = joueurCible.Character
	local role = rolesParJoueur[joueurCible] or "innocent"
	if joueursElimines[joueurCible.Name] then role = "innocent" end
	local hum = perso and perso:FindFirstChildOfClass("Humanoid")
	if not hum then
		retirerHalo(joueurCible)
		retirerBoite(joueurCible)
		retirerEtiquette(joueurCible)
		return
	end
	local rp = perso:FindFirstChild("HumanoidRootPart")
	local distance = 0
	if rp and racine then
		distance = (racine.Position - rp.Position).Magnitude
	end

	-- Chams Classic : visibles aussi dans le lobby et hors manche.
	-- Les joueurs éliminés gardent la couleur des innocents (vert).
	-- Le mode Zombie conserve son affichage séparé.
	local enZombie = flyControl.Z.actif and modeZombie()
	local chamsPossibles = rolesActifs
		and not (rp and racine and distance > DISTANCE_MAX_CHAMS)
	if not chamsPossibles then
		retirerHalo(joueurCible)
	elseif enZombie then
		retirerHalo(joueurCible)
		retirerBoite(joueurCible)
	else
		local c = couleurRole(role)
		local h = halos[joueurCible]
		if not h or not h.Parent or h.Adornee ~= perso then
			if h then h:Destroy() end
			for _, enfant in ipairs(perso:GetChildren()) do
				if enfant:IsA("Highlight") and enfant.Name == "RoleHalo" then enfant:Destroy() end
			end
			h = Instance.new("Highlight")
			h.Name = "RoleHalo"
			h.Adornee = perso
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.OutlineTransparency = 0
			h.Parent = perso
			halos[joueurCible] = h
		end
		-- Écritures de propriétés seulement si la valeur change (évite du travail inutile à 5 Hz par joueur).
		if h.FillColor ~= c then h.FillColor = c end
		local couleurContour = (role == "heros") and c or c:Lerp(Color3.new(1, 1, 1), 0.3)
		if h.OutlineColor ~= couleurContour then h.OutlineColor = couleurContour end
		local transpChams = transparenceChams / 100
		if h.FillTransparency ~= transpChams then h.FillTransparency = transpChams end
		if h.OutlineTransparency ~= 0.05 then h.OutlineTransparency = 0.05 end
		if rp and estInvisible(perso) then
			local b = boites[joueurCible]
			if not b or not b.Parent or b.Adornee ~= rp then
				if b then b:Destroy() end
				b = Instance.new("BoxHandleAdornment")
				b.Name = "RoleBoite"
				b.Adornee = rp
				b.Size = Vector3.new(3, 5.5, 2)
				b.AlwaysOnTop = true
				b.ZIndex = 5
				b.Parent = rp
				boites[joueurCible] = b
			end
			b.Color3 = c
			b.Transparency = transparenceChams / 100
		else
			retirerBoite(joueurCible)
		end
	end

	-- Pseudos : indépendants des chams (fonctionnent même si Chams est désactivé).
	local tete = perso:FindFirstChild("Head") or rp
	local pseudoVisible = nomsActifs and tete ~= nil and racine ~= nil and not estAuLobbyPourChams()
		and hum.Health > 0 and distance <= DISTANCE_MAX_PSEUDO
	if pseudoVisible then
		local e = etiquettes[joueurCible]
		if not e or not e.Parent or e.Adornee ~= tete then
			if e then e:Destroy() end
			e = creerPastille(tete, tete, 2.5, 120, false)
			etiquettes[joueurCible] = e
		end
		local nom = e:FindFirstChild("Nom")
		if nom then nom.Text = joueurCible.Name end
	else
		retirerEtiquette(joueurCible)
	end
end
