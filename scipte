local function jouerDanseRoblox(nomDanse, libelle)
    local personnage = joueur.Character
    local humanoideDanse = personnage and personnage:FindFirstChildOfClass("Humanoid")
    if not humanoideDanse or humanoideDanse.Health <= 0 then
