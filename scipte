            local tNow = os.clock()
            local t = tNow - debut
            if tNow >= prochainPing then
                prochainPing = tNow + INTERVALLE_PING
                ping = lirePing()
            end
            local posCible = rp.Position
            local vCible = vitesseCible(rp, tNow)
            local vH = Vector3.new(vCible.X, 0, vCible.Z)
            local vitesseH = vH.Magnitude
            if not contactAt then
                local distance = (racineDepart.Position - posCible).Magnitude
                if distance <= DISTANCE_CONTACT then
                    contactAt = tNow
                    positionContact = posCible
                end
            end
            if contactAt and not envoiDetecte then
                local vitesse = rp.AssemblyLinearVelocity
                local etatCible = hum:GetState()
                local deplacement = positionContact and (posCible - positionContact).Magnitude or 0
                local projete =
                    vitesse.Magnitude > VITESSE_ENVOI
                    or vCible.Magnitude > VITESSE_ENVOI
                    or math.abs(vitesse.Y) > VITESSE_VERTICALE
                    or math.abs(vCible.Y) > VITESSE_VERTICALE
                    or ((etatCible == Enum.HumanoidStateType.FallingDown
                        or etatCible == Enum.HumanoidStateType.Ragdoll
                        or etatCible == Enum.HumanoidStateType.Physics)
                        and (vitesse.Magnitude > VITESSE_RAGDOLL
                            or vCible.Magnitude > VITESSE_RAGDOLL
                            or deplacement > 8))
                    or posCible.Y < centre.Y - CHUTE_CARTE
                if projete then
                    envoiDetecte = true
                    tEnvoi = tNow
                end
            end
            if posCible.Y < centre.Y - CHUTE_CARTE then
                return terminer("Cible projetée", COL.VERT)
            end
            if contactAt and not envoiDetecte and tNow - contactAt > 2.0 then
                local deplacement = positionContact and (posCible - positionContact).Magnitude or 0
                if deplacement < 2 and rp.AssemblyLinearVelocity.Magnitude < 10 then
                    return terminer("Cible protégée (anti-fling)", COL.ORANGE)
                end
            end
            if envoiDetecte and tNow - tEnvoi >= DUREE_APRES_ENVOI then
                return terminer("Cible projetée", COL.VERT)
            end
            if t >= DUREE_MAX then
                if envoiDetecte then
                    return terminer("Cible projetée", COL.VERT)
                end
                if contactAt then
                    return terminer("Fling terminé : cible non projetée", COL.ORANGE)
                end
                return terminer("Fling terminé : aucun contact", COL.MUET)
            end
            local lead = Vector3.zero
            if vitesseH > 1 then
                local horizon = math.clamp(ping * 0.5 + MARGE_ANTICIPATION, HORIZON_MIN, HORIZON_MAX)
                lead = vH * horizon
                if lead.Magnitude > LEAD_MAX then
                    lead = lead.Unit * LEAD_MAX
                end
