-- Dimensions de reference de la barre reduite (identiques sur PC et emulateur).
local BARRE_L, BARRE_H = 240, 42
local scaleFenetre = creer("UIScale", {Scale = 1}, nil)
local scaleBarre = nil
local appliquerHUD = nil
local conteneur = nil
local function calculerEchelleEcran()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local largeurCible = (conteneur and conteneur.Size.X.Offset > 0) and conteneur.Size.X.Offset or LARGEUR
    local hauteurCible = (conteneur and conteneur.Size.Y.Offset > 0) and conteneur.Size.Y.Offset or HAUTEUR
    -- La grande fenetre garde son adaptation propre.
    local auto = math.min(1, (viewport.X - 28) / (largeurCible + 20), (viewport.Y - 28) / (hauteurCible + 20))
    auto = math.clamp(auto, 0.58, 1)
    scaleFenetre.Scale = auto * (echelleInterface / 100)

    -- IMPORTANT : ne jamais reutiliser l'echelle de la grande fenetre pour
    -- la barre reduite. Sur BlueStacks, cela la rendait minuscule et floue.
    if scaleBarre then
        local echelleBarre = math.min(
            1,
            (viewport.X - 28) / (BARRE_L + 20),
            (viewport.Y - 28) / (BARRE_H + 20)
        )
        echelleBarre = math.clamp(echelleBarre, 0.5, 1)
        scaleBarre.Scale = echelleBarre
    end
end
