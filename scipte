flingGlobal = flingVers
local function teleporterVers(cible)
    local perso = cible.Character
    local rp = perso and perso:FindFirstChild("HumanoidRootPart")
    local tete = perso and perso:FindFirstChild("Head")
    local pointCible = tete or rp
    if not pointCible or not racine or not racine.Parent then
        if notifierInterface then
            notifierInterface(cible.DisplayName .. " est introuvable", COL.ROUGE, "tp_fail_" .. tostring(os.clock()))
        end
        return
    end
    flyControl.marquerArriveeManuelle()
    pcall(function()
        racine.AssemblyLinearVelocity = Vector3.zero
        racine.AssemblyAngularVelocity = Vector3.zero
        local position = pointCible.Position + Vector3.new(0, (pointCible.Size.Y / 2) + 2.5, 0)
        local rotation = racine.CFrame - racine.Position
        racine.CFrame = CFrame.new(position) * rotation
    end)
    if notifierInterface then
        notifierInterface("Téléporté au-dessus de la tête de " .. cible.DisplayName, COL.VERT, "tp_ok_" .. tostring(os.clock()))
    end
end
