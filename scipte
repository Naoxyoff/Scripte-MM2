-- Sauvegarde centralisée : chaque option de l'interface est enregistrée
-- sous une clé stable, puis restaurée au prochain lancement.
local configRuntime = {}
local sauvegardeEnAttente = false
local function cleConfigControle(page, nom, typeControle)
    local nomPage = "General"
    for nomCle, objet in pairs(pages) do
        if objet == page then nomPage = nomCle break end
    end
    return "ui|" .. tostring(typeControle or "option") .. "|" .. nomPage .. "|" .. nom
end

local function sauvegarderConfig(extra)
    local ok, erreur = pcall(function()
        if type(writefile) ~= "function" then error("writefile indisponible") end
        local donnees = {}
        for k, v in pairs(configChargee) do donnees[k] = v end
        for k, v in pairs(configRuntime) do donnees[k] = v end
        if type(extra) == "table" then
            for k, v in pairs(extra) do donnees[k] = v end
        end
        donnees.version = 5
        local http = game:GetService("HttpService")
        local json = http:JSONEncode(donnees)
        writefile(NOM_CONFIG, json)
        if type(readfile) == "function" then
            local verification = http:JSONDecode(readfile(NOM_CONFIG))
            if type(verification) ~= "table" then error("vérification du fichier échouée") end
        end
        configChargee = donnees
    end)
    return ok, erreur
end

