local function estInvisible(perso)
	local tete = perso:FindFirstChild("Head")
	if tete and tete:IsA("BasePart") and tete.Transparency >= 0.9 then return true end
	local torse = perso:FindFirstChild("UpperTorso") or perso:FindFirstChild("Torso")
	return (torse and torse:IsA("BasePart") and torse.Transparency >= 0.9) or false
end

local function majVisuel(joueurCible)
	local perso = joueurCible.Character
	local role = rolesParJoueur[joueurCible] or "innocent"
	local rp = perso and perso:FindFirstChild("HumanoidRootPart")
	local ok = rolesActifs and rp and (role ~= "innocent" or innocentsVisibles)

	local distance = 0
	if ok and racine then
		distance = (racine.Position - rp.Position).Magnitude
	end

	if not ok then
		retirerHalo(joueurCible)
		retirerEtiquette(joueurCible)
		return
	end

	local c = couleurRole(role)

	local h = halos[joueurCible]
	if not h or not h.Parent or h.Adornee ~= perso then
		if h then h:Destroy() end
		h = Instance.new("Highlight")
		h.Name = "RoleHalo"
		h.Adornee = perso
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.OutlineTransparency = 0
		h.Parent = perso
		halos[joueurCible] = h
	end
	h.FillColor = c
	h.OutlineColor = c:Lerp(Color3.new(1, 1, 1), 0.3)
	h.FillTransparency = opaciteChams / 100

	if estInvisible(perso) then
		local b = boites[joueurCible]
		if not b or not b.Parent or b.Adornee ~= rp then
			if b then b:Destroy() end
			b = Instance.new("BoxHandleAdornment")
			b.Name = "RoleBoite"
			b.Adornee = rp
			b.Size = Vector3.new(3, 5.5, 2)
			b.AlwaysOnTop = true
			b.ZIndex = 5
			b.Parent = rp
			boites[joueurCible] = b
		end
		b.Color3 = c
		b.Transparency = math.clamp(opaciteChams / 100, 0.3, 0.8)
	else
		retirerBoite(joueurCible)
	end

	if nomsActifs then
		local e = etiquettes[joueurCible]
		if not e or not e.Parent or e.Adornee ~= rp then
			if e then e:Destroy() end
			e = creerPastille(rp, rp, 3.8, 140, true)
			etiquettes[joueurCible] = e
		end
		local fond = e:FindFirstChild("Fond")
		if fond then
			fond.Contour.Color = c
			fond.Nom.Text = joueurCible.DisplayName
			fond.Sub.TextColor3 = c
			fond.Sub.Text = string.format("%s · %dm", NOMS_ROLES[role], math.floor(distance))
			local hum = perso:FindFirstChildOfClass("Humanoid")
			local rail = fond:FindFirstChild("Rail")
			if hum and rail then
				local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				rail.Vie.Size = UDim2.fromScale(ratio, 1)
				rail.Vie.BackgroundColor3 = Color3.fromRGB(239, 68, 68):Lerp(Color3.fromRGB(52, 199, 89), ratio)
			end
		end
	else
		retirerEtiquette(joueurCible)
	end
end

local function trouverArmeTombee()
	local objet = workspace:FindFirstChild("GunDrop", true)
	if not objet then return nil end
	if objet:IsA("BasePart") then return objet end
	return objet:FindFirstChildWhichIsA("BasePart", true)
end

function retirerArme()
	if haloArme then haloArme:Destroy() haloArme = nil end
	if boiteArme then boiteArme:Destroy() boiteArme = nil end
	if etiquetteArme then etiquetteArme:Destroy() etiquetteArme = nil end
end

local function majArme()
	local partie = trouverArmeTombee()
	infoArme = partie and "Oui" or "Non"

	if not armeActive or not partie then
		retirerArme()
		return
	end

	local distance = racine and (racine.Position - partie.Position).Magnitude or 0

	if not boiteArme or not boiteArme.Parent or boiteArme.Adornee ~= partie then
		retirerArme()

		boiteArme = Instance.new("SelectionBox")
		boiteArme.Name = "ArmeContour"
		boiteArme.Adornee = partie
		boiteArme.Color3 = COL.COULEUR_ARME
		boiteArme.LineThickness = 0.04
		boiteArme.SurfaceColor3 = COL.COULEUR_ARME
		boiteArme.SurfaceTransparency = 0.8
		boiteArme.Parent = partie

		etiquetteArme = creerPastille(partie, partie, 2.4, 100, false)
		etiquetteArme.Size = UDim2.fromOffset(100, 32)
		local fondArme = etiquetteArme.Fond
		fondArme.Contour.Color = COL.COULEUR_ARME
		fondArme.Nom.Text = "Gun"
		fondArme.Sub.TextColor3 = COL.COULEUR_ARME
	end

	local fondArme = etiquetteArme and etiquetteArme:FindFirstChild("Fond")
	if fondArme then fondArme.Sub.Text = string.format("Arme tombée · %dm", math.floor(distance)) end
end

function nettoyerChams()
	for p in pairs(halos) do retirerHalo(p) end
	for p in pairs(boites) do retirerBoite(p) end
	for p in pairs(etiquettes) do retirerEtiquette(p) end
	retirerArme()
end

