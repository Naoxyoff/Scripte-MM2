local function guiVisible(o)
	local p = o
	while p and not p:IsA("ScreenGui") do
		if p:IsA("GuiObject") and not p.Visible then return false end
		p = p.Parent
	end
	return true
end

local sacsCache, tRechercheSacs = nil, 0
local function sacPleinUI()
	local pg = joueur:FindFirstChildOfClass("PlayerGui")
	if not pg then return nil end
	local sacs = sacsCache
	if not (sacs and sacs:IsDescendantOf(pg)) then

		local t = os.clock()
		if t - tRechercheSacs < 3 then return nil end
		tRechercheSacs = t
		sacs = pg:FindFirstChild("CoinBags", true)
		sacsCache = sacs
		if not sacs then return nil end
	end
	for _, o in ipairs(sacs:GetDescendants()) do
		if o:IsA("GuiObject") then
			if string.lower(o.Name) == "full" and guiVisible(o) then return true end
			if o:IsA("TextLabel") and guiVisible(o) then
				local txt = string.lower(o.Text)
				if string.find(txt, "full", 1, true) then return true end
				local a, b = string.match(txt, "^%s*(%d+)%s*/%s*(%d+)%s*$")
				if a and b and tonumber(b) > 0 and tonumber(a) >= tonumber(b) then return true end
			end
		end
	end
	return false
end

local function sacPleinDetecte(h)
	if sacPlein then return end
	sacPlein = true
	notif("Sac plein", COL.ORANGE)

	-- Verrou partagé : une seule détection et un seul reset, même si
	-- plusieurs instances du script tournent en même temps.
	if etatResetSac.sacPlein then return end
	etatResetSac.sacPlein = true
	resetFaitManche = true

	if not farmCfg.resetPlein or etatResetSac.resetFait then return end

	local maintenant = os.clock()
	if (maintenant - (etatResetSac.dernierReset or 0)) <= COOLDOWN_RESET then
		return
	end

	-- Le verrou est posé AVANT de toucher à la vie du personnage.
	etatResetSac.resetFait = true
	etatResetSac.dernierReset = maintenant
	dernierReset = maintenant

	notif("Sac plein : reset", COL.ORANGE)
	warn(string.format("[Tenebres #%s] reset sac plein à %.1f s", ID_INSTANCE, maintenant))

	pcall(function()
		if h and h.Parent and h.Health > 0 then
			h.Health = 0
		end
	end)
end

local function pas(dt)
	if fermee or not armee then return end

	local perso = joueur.Character
	local h = perso and perso:FindFirstChildOfClass("Humanoid")
	local r = perso and perso:FindFirstChild("HumanoidRootPart")
	if not h or not r or not r.Parent or h.Health <= 0 then
		if enFarm then quitterFarm() end
		etatTexte = "En attente du personnage"
		return
	end
	if racine ~= r then racine, humanoide = r, h end

	if flingActif then
		if maintien then
			pcall(function() maintien:Destroy() end)
			maintien = nil
		end
		etatTexte = "Fling en cours"
		return
	end

	local t = os.clock()

	-- Réarmement du reset uniquement après une vraie transition de manche :
	-- événement de fin de manche, puis réception des rôles de la suivante.
	if generationManche ~= generationMancheVue then
		generationMancheVue = generationManche
		nouvelleManche()
	end
	-- Nouvelle manche réelle : des rôles arrivent plus de 8 s après la fin
	if latchFinManche and dernierRoleServeur > tFinManche + 8 then
		latchFinManche = false
		nouvelleManche()
	end

	if t >= prochaineAnalyse then
		prochaineAnalyse = t + 0.2
		DIAG.mesure("analyse", analyser, r.Position)
	end
	if t >= prochainCompact then
		prochainCompact = t + 5
		compacterListe()
	end

	local auLobby = estAuLobby()
	-- Verrou de fin de manche : levé au retour du lobby puis départ vers la map (modes sans rôles
	-- comme Zombie), ou par de nouveaux rôles, ou après 120 s au maximum.
	if latchFinManche then
		if auLobby then
			vuLobbyApresFin = true
		elseif (vuLobbyApresFin and t - tFinManche > 8) or t - tFinManche > 120 then
			latchFinManche, vuLobbyApresFin = false, false
			nouvelleManche()
		end
	end
	-- Correctif : le "sac plein" n'était jamais revérifié une fois posé (la vérification
	-- n'avait lieu que pendant le farm). Il se levait seulement à la manche suivante, ce qui
	-- bloquait le farm indéfiniment dans les modes sans changement de manche (Zombie).
	if sacPlein and t >= prochainVerifSacPlein then
		prochainVerifSacPlein = t + 0.5
		local ui = sacPleinUI()
		if ui == false then
			sacPlein = false
			resetFaitManche = false
			resetEffectue = false
			echecs = 0
			etatResetSac.sacPlein = false
			etatResetSac.resetFait = false
			notif("Sac vidé : farm repris", VERT_ON)
		elseif ui == true and farmCfg.resetPlein and not resetEffectue
			and (t - (etatResetSac.dernierReset or 0)) > COOLDOWN_RESET then
			-- Correctif : le reset ne dépend plus du verrou "une seule détection par manche".
			-- Il part dès que le sac est confirmé plein et que l'option est activée.
			resetEffectue = true
			etatResetSac.resetFait = true
			etatResetSac.dernierReset = t
			dernierReset = t
			notif("Sac plein : reset", COL.ORANGE)
			pcall(function()
				if h and h.Parent and h.Health > 0 then h.Health = 0 end
			end)
		end
	end
	local mort = joueursElimines[joueur.Name] == true

	-- Fin de manche : événement serveur (mancheTerminee) OU murder disparu après avoir été vu
	local finMurder = false
	if infoMurder ~= "—" then
		murderVu, tMurderAbsent = true, nil
	elseif murderVu then
		tMurderAbsent = tMurderAbsent or t
		if t - tMurderAbsent >= DELAI_MURDER_ABSENT then finMurder = true end
	end

	-- Sheriff/héros gagnent : le murder mémorisé est mort, parti ou sans personnage
	for nom, role in pairs(rolesServeur) do
		if role == "murder" then murderNom = nom end
	end
	for pj, role in pairs(rolesParJoueur) do
		if role == "murder" then murderNom = pj.Name end
	end
	if murderNom then
		local pm = Players:FindFirstChild(murderNom)
		local hm = pm and pm.Character and pm.Character:FindFirstChildOfClass("Humanoid")
		if joueursElimines[murderNom] or not pm or (hm and hm.Health <= 0) then
			finMurder = true
		end
	end

	local finManche = finMurder or latchFinManche

	-- Blocage : aucune pièce récoltée depuis trop longtemps -> pause puis nouvel essai
	if enFarm and t - derniereRecolte > DELAI_SANS_RECOLTE then
		pauseStallJusqua = t + 25
		derniereRecolte = t
	end

	local engage = restantes > 0 and not auLobby and distanceMin <= RAYON_ENGAGE and not sacPlein and not mort
		and not finManche and t >= pauseStallJusqua

	if not engage then
		if enFarm then quitterFarm() end
		if restantes == 0 then
			etatTexte = "En attente de la prochaine manche"
			if aFarme and not finTraitee then
				finTraitee = true
				actionFin()
			end
		elseif finManche then
			etatTexte = "Manche terminée : farm en pause jusqu'à la prochaine manche"
		elseif t < pauseStallJusqua then
			etatTexte = "Aucune pièce récoltable : pause avant nouvel essai"
		elseif mort then
			etatTexte = "Éliminé : collecte en pause jusqu'à la prochaine manche"
		elseif sacPlein then
			etatTexte = "Sac plein"
		elseif auLobby then
			etatTexte = "Au lobby, en attente de la manche"
		else
			etatTexte = "Trop loin des pièces, en attente"
		end
		return
	end

	if not enFarm then
		entrerFarm(r, h)
		derniereRecolte = t
		aFarme = true
		finTraitee = false
		notif("Collecte lancée", VERT_ON)
	end
	etatTexte = "Collecte en cours"

	if t >= prochainRafraichissement then
		prochainRafraichissement = t + 0.35
		rafraichirFarm(r, h)
	end

	if t >= prochainSac then
		prochainSac = t + 0.5
		local ui = sacPleinUI()
		uiSacDispo = ui ~= nil
		if ui == true or (ui == nil and echecs >= ECHECS_SAC_PLEIN and recoltesManche >= 40) then
			sacPleinDetecte(h)
		end
	end

	r.AssemblyAngularVelocity = Vector3.zero

	local murderPos = positionMurder()
	if cible and murderPos and (cible.Position - murderPos).Magnitude < RAYON_MURDER then
		cible = nil
		enContact = false
		tempsContact = 0
	end
	if cible and not recoltable(cible) then
		if enContact or (r.Position - cible.Position).Magnitude < 12 then succes() end
		cible = nil
		enContact = false
		tempsContact = 0
	end

	if not cible or t >= prochainRecheck then
		prochainRecheck = t + INTERVALLE_RECHECK
		local meilleure = choisirCible(r.Position, murderPos)
		if meilleure and meilleure ~= cible then
			if not cible then
				cible = meilleure
			elseif not enContact then
				local dActuelle = (cible.Position - r.Position).Magnitude
				local dNouvelle = (meilleure.Position - r.Position).Magnitude
				if dNouvelle < dActuelle * GAIN_HYSTERESIS then
					cible = meilleure
					tempsContact = 0
				end
			end
		end
	end
	if not cible then

		if t - dernierMouvementSansCible > 0.22 then
			vitesseActuelle = 0
			if maintien and maintien.Parent then maintien.Velocity = Vector3.zero end
		else
			if maintien and maintien.Parent then maintien.Velocity = derniereDirection * math.min(vitesseActuelle, farmCfg.vitesse) end
		end
		etatTexte = "Recherche de pièce"
		return
	end
	dernierMouvementSansCible = t

	local cp = cible.Position
	local pos = r.Position
	local distance = (cp - pos).Magnitude

	if cible ~= ancienneCible then
		ancienneCible = cible
		derniereDistance, tempsSansProgres = math.huge, 0
	end
	if distance < derniereDistance - 0.3 then
		derniereDistance = distance
		tempsSansProgres = 0
	elseif distance > DISTANCE_CONTACT then
		tempsSansProgres = tempsSansProgres + dt
		if tempsSansProgres >= DELAI_BLOCAGE then
			abandonnees[cible] = t + 5
			cible = nil
			enContact = false
			tempsContact = 0
			derniereDistance, tempsSansProgres = math.huge, 0
			return
		end
	end

	if distance <= DISTANCE_CONTACT then
		enContact = true
		tempsContact = tempsContact + dt
		if t >= prochainTouch then
			prochainTouch = t + INTERVALLE_TOUCH
			ramasser(cible)
		end
		if tempsContact >= DUREE_CONTACT then

			local connaissaitTI = avaitTI[cible]
			abandonnees[cible] = t + 0.45
			cible = choisirCible(pos, murderPos)
			enContact = false
			tempsContact = 0
			if connaissaitTI then echecs = echecs + 1 end

		else
		end
	else
		enContact = false
		tempsContact = 0
	end

	local visee = cp
	if farmCfg.hauteur == "sous" then

		local exclusions = {}
		if joueur.Character then table.insert(exclusions, joueur.Character) end
		if cible then table.insert(exclusions, cible) end
		PARAMS_RAYON_SOL.FilterDescendantsInstances = exclusions

		local origineRayon = cp + Vector3.new(0, 0.5, 0)
		local toucheSol = workspace:Raycast(origineRayon, Vector3.new(0, -8, 0), PARAMS_RAYON_SOL)
		if toucheSol then

			local yVise = math.max(toucheSol.Position.Y - 0.85, cp.Y - 2.5)
			visee = Vector3.new(cp.X, yVise, cp.Z)
		else

			visee = cp + Vector3.new(0, 2.5, 0)
		end
	end

	if distance <= DISTANCE_CONTACT then
		local directionHorizontale = Vector3.new(cp.X - pos.X, 0, cp.Z - pos.Z)
		if directionHorizontale.Magnitude < 0.05 then
			directionHorizontale = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
		end
		if directionHorizontale.Magnitude > 0.05 then
			local directionUnitaire = directionHorizontale.Unit
			visee = visee + directionUnitaire * 3.5
		end
	end
	local versVisee = visee - pos
	local distVisee = versVisee.Magnitude
	if distVisee > 0.05 then
		vitesseActuelle = math.min(farmCfg.vitesse, vitesseActuelle + ACCEL * dt)
		local pasDistance = math.min(vitesseActuelle * dt, distVisee)
		local nouvelle = pos + versVisee * (pasDistance / distVisee)
		if pasDistance > 0.001 then derniereDirection = (nouvelle - pos).Unit end
		if referenceY then
			local y = nouvelle.Y
			local yMin, yMax = referenceY - farmCfg.margeVerticale, referenceY + farmCfg.margeVerticale
			if y < yMin or y > yMax then
				nouvelle = Vector3.new(nouvelle.X, math.clamp(y, yMin, yMax), nouvelle.Z)
			end
		end

		if maintien and maintien.Parent then
			maintien.Velocity = (nouvelle - pos) / math.max(dt, 0.001)
		end
		r.CFrame = cframeOriente(r.Position)
	else
		if maintien and maintien.Parent then maintien.Velocity = Vector3.zero end
	end
end

