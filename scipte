local function estInvisible(perso)
	local tete = perso:FindFirstChild("Head")
	if tete and tete:IsA("BasePart") and tete.Transparency >= 0.9 then return true end
	local torse = perso:FindFirstChild("UpperTorso") or perso:FindFirstChild("Torso")
	return (torse and torse:IsA("BasePart") and torse.Transparency >= 0.9) or false
end

local function majVisuel(joueurCible)
	local perso = joueurCible.Character
	local role = rolesParJoueur[joueurCible] or "innocent"
	local hum = perso and perso:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then role = "innocent" end
	local rp = perso and perso:FindFirstChild("HumanoidRootPart")
	local ok = rolesActifs and rp

	local distance = 0
	if ok and racine then
		distance = (racine.Position - rp.Position).Magnitude
	end

	if not ok then
		retirerHalo(joueurCible)
		retirerEtiquette(joueurCible)
		return
	end

	-- Portée maximale : au-delà, ni chams ni pseudo
	if racine and distance > DISTANCE_MAX_CHAMS then
		retirerHalo(joueurCible)
		retirerEtiquette(joueurCible)
		return
	end

	local c = couleurRole(role)

	local h = halos[joueurCible]
	if not h or not h.Parent or h.Adornee ~= perso then
		if h then h:Destroy() end
		h = Instance.new("Highlight")
		h.Name = "RoleHalo"
		h.Adornee = perso
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.OutlineTransparency = 0
		h.Parent = perso
		halos[joueurCible] = h
	end
	h.FillColor = c
	h.OutlineColor = c:Lerp(Color3.new(1, 1, 1), 0.3)
	h.FillTransparency = transparenceChams / 100
	h.OutlineTransparency = 0.05

	if estInvisible(perso) then
		local b = boites[joueurCible]
		if not b or not b.Parent or b.Adornee ~= rp then
			if b then b:Destroy() end
			b = Instance.new("BoxHandleAdornment")
			b.Name = "RoleBoite"
			b.Adornee = rp
			b.Size = Vector3.new(3, 5.5, 2)
			b.AlwaysOnTop = true
			b.ZIndex = 5
			b.Parent = rp
			boites[joueurCible] = b
		end
		b.Color3 = c
		b.Transparency = transparenceChams / 100
	else
		retirerBoite(joueurCible)
	end

	local pseudoVisible = nomsActifs and racine ~= nil and not estAuLobbyPourChams()
		and hum ~= nil and hum.Health > 0 and distance <= DISTANCE_MAX_PSEUDO
	if pseudoVisible then
		local tete = perso:FindFirstChild("Head") or rp
		local e = etiquettes[joueurCible]
		if not e or not e.Parent or e.Adornee ~= tete then
			if e then e:Destroy() end
			e = creerPastille(tete, tete, 2.5, 120, false)
			etiquettes[joueurCible] = e
		end
		local nom = e:FindFirstChild("Nom")
		if nom then nom.Text = joueurCible.Name end
	else
		retirerEtiquette(joueurCible)
	end
end

local function marquerInnocentApresMort(p, personnage)
	if p.Character ~= personnage then return end
	joueursElimines[p.Name] = true
	rolesServeur[p.Name] = nil
	rolesParJoueur[p] = "innocent"
	pcall(function() majVisuel(p) end)
end

local function surveillerMortPersonnage(p, personnage)
	if not personnage or p.Character ~= personnage then return end
	local hum = personnage:FindFirstChildOfClass("Humanoid")
	if not hum then hum = personnage:WaitForChild("Humanoid", 10) end
	if not hum or p.Character ~= personnage then return end
	local ancienne = connexionsMort[p]
	if ancienne then pcall(function() ancienne:Disconnect() end) end
	connexionsMort[p] = connecter(hum.Died, function()
		marquerInnocentApresMort(p, personnage)
