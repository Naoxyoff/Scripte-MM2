local function calculerRoles()
	if finMancheEnAttente then
		finMancheEnAttente = false
		armesVues = false
		tDerniereArme = 0
		sheriffOrigine = nil
		herosRapide = nil
	end
	if nouvelleMancheAnnoncee then
		nouvelleMancheAnnoncee = false
		armesVues = false
		tDerniereArme = 0
		sheriffOrigine = nil
		herosRapide = nil
		table.clear(joueursElimines)
	end
	if mancheTerminee then
		herosRapide = nil
		local tousInnocents = {}
		for _, p in ipairs(Players:GetPlayers()) do tousInnocents[p] = "innocent" end
		rolesParJoueur = tousInnocents
		infoManche, infoMurder, infoSherif, infoHeros = "Aucune", "—", "—", "—"
		return
	end
	local porteursCouteau = {}
	local porteurs = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if joueurVivant(p) and not joueursElimines[p.Name] then
			if aOutil(p, "Knife") then porteursCouteau[#porteursCouteau + 1] = p end
			if aOutil(p, "Gun") then porteurs[#porteurs + 1] = p end
		end
	end
	-- Sans attribution serveur, un seul porteur de couteau est un indice exploitable.
	-- Plusieurs porteurs rendent le rôle ambigu : on ne colore personne au hasard.
	local murder = #porteursCouteau == 1 and porteursCouteau[1] or nil
	local sheriffMort = sheriffOrigine ~= nil and not joueurVivant(sheriffOrigine)
	if not sheriffOrigine then
		for _, p in ipairs(Players:GetPlayers()) do
			if rolesServeur[p.Name] == "sherif" then
				sheriffOrigine = p
				break
			end
		end
	end
	if #porteurs > 0 and not sheriffOrigine then sheriffOrigine = porteurs[1] end
	if murder or #porteurs > 0 then
		armesVues = true
		tDerniereArme = os.clock()
	elseif armesVues and os.clock() - tDerniereArme > 3
		and os.clock() - dernierRoleServeur > 10 then
		armesVues = false
		table.clear(rolesServeur)
		table.clear(joueursElimines)
		sheriffOrigine = nil
	end
	local sherif, heros = nil, nil
	for _, p in ipairs(porteurs) do
		if p == sheriffOrigine and joueurVivant(p) then
			sherif = p
		elseif not heros then
			heros = p
		end
	end
	-- Héros déduit instantanément du ramassage du pistolet (le Backpack des autres
	-- joueurs n'est pas toujours visible tant que l'arme n'est pas équipée).
	if not heros and herosRapide then
		if herosRapide.Parent == Players and joueurVivant(herosRapide)
			and not joueursElimines[herosRapide.Name]
			and not (herosRapide == sheriffOrigine) then
			heros = herosRapide
		else
			herosRapide = nil
		end
	end
		local nouveau = {}
	local srvActif = false
	for _, p in ipairs(Players:GetPlayers()) do
		local r = "innocent"
		local personnage = p.Character
		local hum = personnage and personnage:FindFirstChildOfClass("Humanoid")
		local personnageCharge = hum ~= nil
		local vivant = personnageCharge and hum.Health > 0
		local srv = rolesServeur[p.Name]
		local auLobby = personnageCharge and estDansLobby(personnage)
		if srv and srv ~= "innocent" and not joueursElimines[p.Name] then
			local ref = persoDuRole[p.Name]
			if personnageCharge and vivant then
				if not ref or ref.role ~= srv then
					persoDuRole[p.Name] = { perso = personnage, role = srv }
				elseif ref.perso ~= personnage then
					if auLobby then
						persoDuRole[p.Name] = { perso = personnage, role = srv }
					else
						joueursElimines[p.Name] = true
						rolesServeur[p.Name] = nil
						srv = nil
					end
				end
			elseif ref and (not personnageCharge or ref.perso ~= personnage) then
				if auLobby and personnageCharge and vivant then
					persoDuRole[p.Name] = { perso = personnage, role = srv }
				else
					joueursElimines[p.Name] = true
					rolesServeur[p.Name] = nil
					srv = nil
				end
			end
		elseif not srv then
			persoDuRole[p.Name] = nil
		end
		if joueursElimines[p.Name] then
			r = "innocent"
		elseif auLobby then
			if srv and srv ~= "innocent" then
				r = srv
				srvActif = true
			else
				r = "innocent"
			end
		elseif not personnageCharge then
			if srv and srv ~= "innocent" then
				r = srv
				srvActif = true
			end
		elseif not vivant then
			rolesServeur[p.Name] = nil
			joueursElimines[p.Name] = true
			r = "innocent"
		elseif srv and not (srv == "innocent" and p == heros) then
			-- Une attribution serveur valide prime sur les indices d'inventaire,
			-- sauf « innocent » : un innocent qui ramasse le pistolet devient Héros.
			r = srv
			srvActif = srvActif or srv ~= "innocent"
		elseif p == murder then
			r = "murder"
		elseif p == heros then
			r = "heros"
		elseif p == sherif then
			r = "sherif"
		end
		nouveau[p] = r
	end
	rolesParJoueur = nouveau
	murder, sherif, heros = nil, nil, nil
	for p, r in pairs(nouveau) do
		if r == "murder" then murder = p
		elseif r == "sherif" then sherif = p
		elseif r == "heros" then heros = p end
	end
	infoManche = (srvActif or murder or #porteurs > 0) and "En cours" or "Aucune"
	infoMurder = murder and murder.Name or "—"
	infoSherif = sherif and sherif.Name or "—"
	infoHeros = heros and heros.Name or "—"
	if infoManche == "En cours" then
		if murder then suiviManche.murderNom = murder.Name end
		local moi = nouveau[joueur]
		if moi == "murder" or moi == "sherif" then
			suiviManche.role, suiviManche.participe = moi, true
		elseif moi == "heros" then
			suiviManche.role = suiviManche.role or "heros"
			suiviManche.participe = true
		end
	end
end
