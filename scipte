local modeZombieCache, tModeZombie = false, 0
function modeZombie()
    local t = os.clock()
    if t - tModeZombie > 0.5 then
        tModeZombie = t
        local n = 0
        for _, q in ipairs(Players:GetPlayers()) do
            if joueurVivant(q) and not estDansLobby(q.Character) and possedeCouteauZombie(q) then n = n + 1 end
        end
        flyControl.Z.nbCouteaux = n
        for _, role in pairs(rolesServeur) do
            if role == "sherif" then flyControl.Z.classiqueGen = generationManche break end
        end
        local trouve = false
        for _, q in ipairs(Players:GetPlayers()) do
