            flyControl.prochainZombieListe = tZ + 0.4
            local modeZ = (flyControl.Z.mode and flyControl.Z.mode()) == true
            flyControl.modeZListe = modeZ
            local etats = {}
            local raisons = {}
            if modeZ and flyControl.Z.estZombie then
                for autre in pairs(entrees) do
                    local ok, vivant = pcall(flyControl.Z.vivant, autre)
                    if ok and vivant then
                        local ok2, etat = pcall(flyControl.Z.estZombie, autre)
                        if ok2 then etats[autre] = etat end
                        if ok2 and etat == nil then raisons[autre] = "Au lobby" end
                    else
                        raisons[autre] = "Mort ou hors de portée"
                    end
                end
            end
            flyControl.etatZListe = etats
            flyControl.raisonZListe = raisons
        end
        local etatsZ = flyControl.etatZListe or {}
        for autre, e in pairs(entrees) do
            if e.sub and e.sub.Parent then
                local role = rolesParJoueur[autre]
                local texteRole = (role and role ~= "innocent") and (NOMS_ROLES[role] or "") or ""
                local couleur = texteRole ~= "" and couleurRole(role) or COL.MUET
                local zEtat = etatsZ[autre]
                if flyControl.modeZListe and zEtat ~= nil then
                    texteRole = zEtat and "Zombie" or "Survivant"
                    couleur = zEtat and COL.COULEUR_MURDER or COL.COULEUR_INNOCENT
                elseif flyControl.modeZListe then
                    local raison = (flyControl.raisonZListe or {})[autre]
                    if raison then
                        texteRole = raison
                        couleur = COL.MUET
                    end
                end
                local positionTitre = texteRole ~= "" and 10 or 19
                if e.roleTexte ~= texteRole then
                    e.sub.Text = texteRole
                    e.roleTexte = texteRole
                end
                if e.roleCouleur ~= couleur then
                    e.sub.TextColor3 = couleur
                    e.roleCouleur = couleur
                end
                if e.titre and e.titrePosition ~= positionTitre then
                    e.titre.Position = UDim2.fromOffset(56, positionTitre)
                    e.titrePosition = positionTitre
                end
            end
        end
        task.wait(0.15)
    end
end)
