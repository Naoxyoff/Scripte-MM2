local function possedeCouteauZombie(p)
    if not p then return false end
    local function chercher(conteneur)
        if not conteneur then return false end
        for _, objet in ipairs(conteneur:GetChildren()) do
            if objet:IsA("Tool") then
                local nom = string.lower(objet.Name)
                if (nom == "knife" or string.find(nom, "knife", 1, true))
                    and not string.find(nom, "display", 1, true)
                    and not string.find(nom, "skin", 1, true) then
                    return true
                end
            end
        end
        return false
    end
    return chercher(p.Character) or chercher(p:FindFirstChildOfClass("Backpack"))
end

local modeZombie
local function estZombieOuSurvivant(p)
    if not p then return nil end

    local perso = p.Character

    if perso and estDansLobby(perso) then
        return nil
    end

    if p.Team and estNomZombie(p.Team.Name) then
        return true
    end

    -- Indices explicites et fiables (attribut « infecté » vrai).
    for _, objet in ipairs({ p, perso }) do
        if objet then
            for nomAttr, valeur in pairs(objet:GetAttributes()) do
                local cle = string.lower(tostring(nomAttr))
                if (cle == "iszombie" or cle == "infected" or cle == "isinfected") and valeur == true then
                    return true
                end
            end
        end
    end

    -- Mode infection détecté par les couteaux : le couteau fait foi, et lui seul.
    -- Les anciennes heuristiques (noms d'outils / attributs « claw », « bite »...)
    -- étaient trop larges et marquaient des survivants en rouge.
    if flyControl.Z.modeCouteau then
        return possedeCouteauZombie(p)
    end

    -- Hors détection par couteau : heuristiques larges conservées.
    if attributZombie(p) or attributZombie(perso) then
        return true
    end
    for _, conteneur in ipairs({ perso, p:FindFirstChildOfClass("Backpack") }) do
        if conteneur then
            for _, objet in ipairs(conteneur:GetChildren()) do
                if objet:IsA("Tool") and estNomZombie(objet.Name) then
                    return true
                end
            end
        end
    end

    return false
end
