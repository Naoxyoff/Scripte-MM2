                    end
                    if racineDepart.Transparency ~= 1 then racineDepart.Transparency = 1 end
                    if racineDepart.LocalTransparencyModifier ~= 1 then
                        racineDepart.LocalTransparencyModifier = 1
                    end
                    local props = racineDepart.CustomPhysicalProperties
                    if not props or math.abs(props.Density - DENSITE_IMPACT) > 0.01 then
                        racineDepart.CustomPhysicalProperties =
