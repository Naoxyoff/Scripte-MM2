do
local discoOriginal = nil
local trainee, att0, att1 = nil, nil, nil
function retirerTrainee()
	if trainee then trainee:Destroy() trainee = nil end
	if att0 then att0:Destroy() att0 = nil end
	if att1 then att1:Destroy() att1 = nil end
end
local function creerTrainee()
	if not racine then return end
	retirerTrainee()
	att0 = Instance.new("Attachment")
	att0.Position = Vector3.new(0, 1, 0)
	att0.Parent = racine
	att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, -1, 0)
