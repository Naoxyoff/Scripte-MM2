-- ============================ ANTI-FLING ============================
do
local VITESSE_HORIZONTALE_MAX = 120
local VITESSE_CHUTE_MAX = 450
local ROTATION_MAX = 60
local DISTANCE_RETOUR = 15
local PAS_POSITION_SURE = 0.25
local derniereSure = nil
local derniereMaj = 0
local suivis = {}

local function desactiverPiece(info, p)
	if info.parts[p] == nil then
		info.parts[p] = p.CanCollide
		info.liste[#info.liste + 1] = p
	end
	p.CanCollide = false
end

-- `infoAttendue` empêche le gestionnaire AncestryChanged d'un ancien
-- personnage de supprimer le suivi du nouveau personnage du même joueur.
local function oublier(autre, infoAttendue)
	local info = suivis[autre]
	if not info then return end
	if infoAttendue and info ~= infoAttendue then return end
	for _, c in ipairs(info.conns) do c:Disconnect() end
	for p, original in pairs(info.parts) do
		-- On restaure même pendant l'anti-fling : le personnage est en train
		-- d'être retiré et ses collisions ne doivent pas rester bloquées.
		if p.Parent then p.CanCollide = original end
	end
	suivis[autre] = nil
end

local function suivre(autre, perso)
	oublier(autre)
	local info = { parts = {}, liste = {}, conns = {}, perso = perso }
	suivis[autre] = info

	local function ajouter(p)
		if p:IsA("BasePart") then
			if actif then
				desactiverPiece(info, p)
			elseif info.parts[p] == nil then
				info.parts[p] = p.CanCollide
				info.liste[#info.liste + 1] = p
			end
		end
	end

	for _, p in ipairs(perso:GetDescendants()) do ajouter(p) end
	table.insert(info.conns, perso.DescendantAdded:Connect(ajouter))
	table.insert(info.conns, perso.DescendantRemoving:Connect(function(p)
		if info.parts[p] ~= nil then
			info.parts[p] = nil
			for i = #info.liste, 1, -1 do
				if info.liste[i] == p then table.remove(info.liste, i) break end
			end
		end
	end))
	table.insert(info.conns, perso.AncestryChanged:Connect(function(_, parent)
		if not parent then oublier(autre, info) end
	end))
end

local function surveillerJoueur(autre)
	if autre == joueur or fermee then return end
	autre.CharacterAdded:Connect(function(perso)
		if fermee then return end
		suivre(autre, perso)
	end)
	autre.CharacterRemoving:Connect(function(perso)
		local info = suivis[autre]
		if info and info.perso == perso then oublier(autre, info) end
	end)
	if autre.Character then suivre(autre, autre.Character) end
end

for _, autre in ipairs(Players:GetPlayers()) do surveillerJoueur(autre) end
Players.PlayerAdded:Connect(surveillerJoueur)
Players.PlayerRemoving:Connect(oublier)

local function restaurerCollisions()
	for _, info in pairs(suivis) do
		for p, original in pairs(info.parts) do
			if p.Parent then p.CanCollide = original end
		end
	end
end

local function nouveauPersonnage(perso)
	racine, humanoide = nil, nil
	derniereSure = nil
	local r = perso:WaitForChild("HumanoidRootPart", 10)
	local h = perso:WaitForChild("Humanoid", 10)
	if not r or not h or joueur.Character ~= perso then return end
	racine, humanoide = r, h
	if actif then derniereSure = r.CFrame end
end

joueur.CharacterAdded:Connect(nouveauPersonnage)
joueur.CharacterRemoving:Connect(function()
	racine, humanoide = nil, nil
	derniereSure = nil
end)
if joueur.Character then task.spawn(nouveauPersonnage, joueur.Character) end

function definirActif(valeur)
	actif = valeur == true
	if actif then
		-- Application immédiate : le premier pas physique ne doit pas encore
		-- laisser les collisions actives après l'activation de l'option.
		for _, info in pairs(suivis) do
			for p in pairs(info.parts) do
				if p.Parent then p.CanCollide = false end
			end
		end
		derniereSure = racine and racine.CFrame or nil
		derniereMaj = os.clock()
	else
		restaurerCollisions()
	end
end

-- Utilisé par la téléportation : sans cela, la position "sûre" mémorisée
-- avant le TP peut déclencher un retour arrière au premier pic de vitesse.
reinitialiserAntiFling = function()
	if actif then
		derniereSure = racine and racine.CFrame or nil
		derniereMaj = os.clock()
	end
end

RunService.Stepped:Connect(function()
	if not actif then return end

	for _, info in pairs(suivis) do
		local liste = info.liste
		for i = 1, #liste do
			local p = liste[i]
			if p.CanCollide then p.CanCollide = false end
		end
	end

	if not racine or not racine.Parent or not humanoide then return end

	local etat = humanoide:GetState()
	if humanoide.Health <= 0
		or etat == Enum.HumanoidStateType.Dead
		or etat == Enum.HumanoidStateType.FallingDown
		or etat == Enum.HumanoidStateType.Ragdoll then
		return
	end

	-- Fly, farm et fling pilotent volontairement la position et la vitesse :
	-- l'anti-fling ne doit pas les faire revenir en arrière. On recale la
	-- position "sûre" pour ne pas déclencher un retour au moment où ils
	-- s'arrêtent.
	if flingActif or (flyControl and (flyControl.flyOn or flyControl.farmActif)) then
		derniereSure = racine.CFrame
		derniereMaj = os.clock()
		return
	end

	local vel = racine.AssemblyLinearVelocity
	local vitesseHorizontale = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local montee = vel.Y
	local chute = -vel.Y

	if vitesseHorizontale > VITESSE_HORIZONTALE_MAX
		or montee > VITESSE_HORIZONTALE_MAX
		or chute > VITESSE_CHUTE_MAX
		or racine.AssemblyAngularVelocity.Magnitude > ROTATION_MAX then
		racine.AssemblyLinearVelocity = Vector3.zero
		racine.AssemblyAngularVelocity = Vector3.zero
		if derniereSure and (racine.Position - derniereSure.Position).Magnitude > DISTANCE_RETOUR then
			racine.CFrame = derniereSure
		end
	else
		local t = os.clock()
		if t - derniereMaj >= PAS_POSITION_SURE
			and humanoide.FloorMaterial ~= Enum.Material.Air then
			derniereSure = racine.CFrame
			derniereMaj = t
		end
	end
end)

end
