local function tw(o, props, t, style)
	local anim = TweenService:Create(o, TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	anim:Play()
	return anim
end

local function texte(parent, props)
