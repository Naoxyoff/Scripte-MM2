					if not reduit then conteneur.Visible = true end
					tw(cadre, { GroupTransparency = (100 - opaciteFenetre) / 100 }, 0.45)
				end)
			end
			task.wait(0.6)
			pcall(function() carte:Destroy() end)
		end)
	end)
	if not ok then
		if not reduit then conteneur.Visible = true end
		tw(cadre, { GroupTransparency = (100 - opaciteFenetre) / 100 }, 0.4)
	end
end)()
do
	local derniere = os.clock()
	local dernierGel = 0
	connecter(RunService.Heartbeat, function()
		local t = os.clock()
		local dt = t - derniere
		derniere = t
		if fermee then return end
		if dt > 0.35 and t - dernierGel > 5 then
			dernierGel = t
			local suspect = (t - DIAG.tSuspect < 1.5) and DIAG.suspect or "aucun"
			DIAG.consigner(string.format("Gel %d ms · évts %d ms (%d) · suspect %s · farm %s fly %s noclip %s anti %s",
				math.floor(dt * 1000), math.floor(DIAG.msEvts), DIAG.nbEvts, suspect,
				flyControl.farmActif and "ON" or "off", flyControl.flyOn and "ON" or "off",
				flyControl.noclipOn and "ON" or "off", actif and "ON" or "off"))
		end
		DIAG.msEvts, DIAG.nbEvts = 0, 0
	end)
