        local function vitesseCible(rp, tNow)
            local pos = rp.Position
            local dernier = historique[#historique]
            if not dernier or tNow - dernier.t >= 0.01 then
                historique[#historique + 1] = { t = tNow, p = pos }
            end
            while #historique > 1 and tNow - historique[1].t > 0.20 do
                table.remove(historique, 1)
            end
            local v = Vector3.zero
            local premier = historique[1]
            local dt = tNow - premier.t
            if dt > 0.04 then
                v = (pos - premier.p) / dt
            end
            local rapportee = rp.AssemblyLinearVelocity
            if rapportee.Magnitude > v.Magnitude and rapportee.Magnitude < 250 then
                v = rapportee
            end
            return v
