	if not piecesConnues[obj] then return end
	task.defer(function()
		if obj:IsDescendantOf(workspace) then return end
		if not piecesConnues[obj] then return end
		piecesConnues[obj] = nil
		avaitTI[obj] = nil
		piecesVivantes = math.max(0, piecesVivantes - 1)
	end)
end)

local function compacterListe()
	if #piecesListe < 80 then return end
	local neuve = {}
	for i = 1, #piecesListe do
		local p = piecesListe[i]
		if piecesConnues[p] then neuve[#neuve + 1] = p end
	end
	piecesListe = neuve
end

-- Une pièce est récoltable si elle est dans le monde et si son TouchInterest
-- (qui disparaît quand elle est ramassée) est toujours là.
local function recoltable(p)
	if not piecesConnues[p] or not p:IsDescendantOf(workspace) then return false end
	if avaitTI[p] and not p:FindFirstChildOfClass("TouchTransmitter") then return false end
	return true
end

local function analyser(position)
	local n, dMin = 0, math.huge
	for i = 1, #piecesListe do
		local p = piecesListe[i]
		if recoltable(p) then
			n = n + 1
			local d = (p.Position - position).Magnitude
			if d < dMin then dMin = d end
		end
	end
	restantes, distanceMin = n, dMin
end

local function positionMurder()
	if not farmCfg.eviterMurder then return nil end
	for p, role in pairs(rolesParJoueur) do
		if role == "murder" and p ~= joueur then
			local rp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if rp then return rp.Position end
		end
	end
	return nil
end

local function choisirCible(position, murderPos)
	local meilleure, meilleureD = nil, math.huge
	local t = os.clock()
	for i = 1, #piecesListe do
		local p = piecesListe[i]
		local finAbandon = abandonnees[p]
		if recoltable(p) and not (finAbandon and finAbandon > t) then
			local pp = p.Position
			if math.abs(pp.Y - referenceY) <= farmCfg.margeVerticale then
				if not (murderPos and (pp - murderPos).Magnitude < RAYON_MURDER) then
					local d = (pp - position).Magnitude
					if d < meilleureD then meilleure, meilleureD = p, d end
				end
			end
		end
	end
	return meilleure
end

-- ------------------------------ Lobby ------------------------------
local lobbyCentreCache = nil
local prochainCalculLobby = 0

local function centreLobby()
	for _, nom in ipairs({ "Lobby", "lobby" }) do
		local lobby = workspace:FindFirstChild(nom)
		if lobby then
			local spawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
			if spawn then return spawn.Position end
			local ok, cf = pcall(function() return lobby:GetBoundingBox() end)
			if ok and cf then return cf.Position end
		end
	end
	return nil
end

local function estAuLobby()
	if not racine or not racine.Parent then return false end
	local t = os.clock()
	if t > prochainCalculLobby then
		prochainCalculLobby = t + 3
		lobbyCentreCache = centreLobby()
	end
	if not lobbyCentreCache then return false end
	return (racine.Position - lobbyCentreCache).Magnitude < RAYON_LOBBY
end

local function trouverLobby()
	local centre = centreLobby()
	if centre then return CFrame.new(centre + Vector3.new(0, 5, 0)) end
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then return CFrame.new(spawn.Position + Vector3.new(0, 5, 0)) end
	return CFrame.new(-6, 10, 2)
end

-- ------------------------------ Contact / mouvement ------------------------------
-- Le perso reste couché à plat avec une orientation FIXE (la direction est ignorée).
local ROT_FIXE = CFrame.fromMatrix(
	Vector3.zero,
	Vector3.new(0, 0, -1):Cross(Vector3.new(0, -1, 0)),
	Vector3.new(0, 0, -1),
	Vector3.new(0, -1, 0)
)
local function cframeOriente(position)
	return CFrame.new(position) * ROT_FIXE
end

local function ramasser(piece)
	if not racine or not racine.Parent then return end
	if not firetouchinterest then return end
	pcall(firetouchinterest, racine, piece, 0)
	pcall(firetouchinterest, racine, piece, 1)
	local perso = racine.Parent
	local torse = perso:FindFirstChild("UpperTorso") or perso:FindFirstChild("Torso")
	if torse then
		pcall(firetouchinterest, torse, piece, 0)
		pcall(firetouchinterest, torse, piece, 1)
	end
end

local function creerMaintien(r)
	if maintien then pcall(function() maintien:Destroy() end) end
	maintien = Instance.new("BodyVelocity")
	maintien.Name = "TenebresFarmMaintien"
	maintien.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	maintien.P = 1e5
	maintien.Velocity = Vector3.zero
	maintien.Parent = r
end

local function entrerFarm(r, h)
	if enFarm then return end
	enFarm = true
	flyControl.farmActif = true
	flyEtaitActif = flyControl.flyOn
	if flyEtaitActif then flyControl.activerFly(false) end
	if not flyControl.noclipOn then
		noclipParFarm = true
		flyControl.activerNoclip(true, true)
	end
	referenceY = r.Position.Y
	r.Anchored = false
	pcall(function()
		h.AutoRotate = false
		h.PlatformStand = true
		h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		h:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	creerMaintien(r)
end

local function quitterFarm()
	if not enFarm then return end
	enFarm = false
	flyControl.farmActif = false
	cible = nil
	enContact = false
	tempsContact = 0
	vitesseActuelle = 0
	if maintien then
		pcall(function() maintien:Destroy() end)
		maintien = nil
	end
	local r, h = racine, humanoide
	if r and r.Parent then
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
			-- Remet le perso debout, un peu au-dessus, avant de rendre les collisions.
			r.CFrame = CFrame.new(r.Position + Vector3.new(0, 3, 0))
		end)
	end
	if h and h.Parent then
		pcall(function()
			h.PlatformStand = false
			h.AutoRotate = true
			h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
			h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	if noclipParFarm then
		noclipParFarm = false
		if flyControl.noclipOn then flyControl.activerNoclip(false, true) end
	end
	if flyEtaitActif then
		flyEtaitActif = false
		flyControl.activerFly(true)
	end
end

local function rafraichirFarm(r, h)
	pcall(function()
		if not h.PlatformStand then h.PlatformStand = true end
		if h:GetState() ~= Enum.HumanoidStateType.Physics then
			h:ChangeState(Enum.HumanoidStateType.Physics)
		end
	end)
	if not maintien or not maintien.Parent then creerMaintien(r) end
	-- Le noclip est indispensable pendant le farm : on le remet s'il a été coupé.
	if not flyControl.noclipOn then
		noclipParFarm = true
		flyControl.activerNoclip(true, true)
	end
end

local function nouvelleManche()
	recoltesManche = 0
	finTraitee = false
	aFarme = false
	sacPlein = false
	echecs = 0
	table.clear(abandonnees)
end

local function succes()
	recoltesManche = recoltesManche + 1
	recolteesSession = recolteesSession + 1
	recolteesTotal = recolteesTotal + 1
	echecs = 0
end

local function actionFin()
	if estAuLobby() then return end
	local r = racine
	if farmCfg.tpLobbyFin then
		if r and r.Parent then
			pcall(function()
				r.AssemblyLinearVelocity = Vector3.zero
				r.CFrame = trouverLobby()
			end)
		end
	elseif farmCfg.flingFin and flingGlobal then
		for p, role in pairs(rolesParJoueur) do
			if role == "murder" and p ~= joueur and p.Parent == Players then
				flingGlobal(p)
				break
			end
		end
	end
end

-- Lit l'interface du sac du jeu (GUI "CoinBags").
-- Renvoie true (plein), false (pas plein) ou nil (interface introuvable).
local function guiVisible(o)
	local p = o
	while p and not p:IsA("ScreenGui") do
		if p:IsA("GuiObject") and not p.Visible then return false end
		p = p.Parent
	end
	return true
end

local function sacPleinUI()
	local pg = joueur:FindFirstChildOfClass("PlayerGui")
	if not pg then return nil end
	local sacs = pg:FindFirstChild("CoinBags", true)
	if not sacs then return nil end
	for _, o in ipairs(sacs:GetDescendants()) do
		if o:IsA("GuiObject") then
			if string.lower(o.Name) == "full" and guiVisible(o) then return true end
			if o:IsA("TextLabel") and guiVisible(o) then
				local txt = string.lower(o.Text)
				if string.find(txt, "full", 1, true) then return true end
				local a, b = string.match(txt, "^%s*(%d+)%s*/%s*(%d+)%s*$")
				if a and b and tonumber(b) > 0 and tonumber(a) >= tonumber(b) then return true end
			end
		end
	end
	return false
end

local function sacPleinDetecte(h)
	if sacPlein then return end
	sacPlein = true
	notif("Sac plein", COL.ORANGE)
	if farmCfg.resetPlein and (os.clock() - dernierReset) > COOLDOWN_RESET then
		dernierReset = os.clock()
		notif("Sac plein : reset", COL.ORANGE)
		pcall(function() h.Health = 0 end)
	end
end

-- ------------------------------ Boucle principale ------------------------------
local function pas(dt)
	if fermee or not armee then return end

	local perso = joueur.Character
	local h = perso and perso:FindFirstChildOfClass("Humanoid")
	local r = perso and perso:FindFirstChild("HumanoidRootPart")
	if not h or not r or not r.Parent or h.Health <= 0 then
		if enFarm then quitterFarm() end
		etatTexte = "En attente du personnage"
		return
	end
	if racine ~= r then racine, humanoide = r, h end

	-- Un fling manuel ou de fin de manche est prioritaire : on lâche le maintien.
	if flingActif then
		if maintien then
			pcall(function() maintien:Destroy() end)
			maintien = nil
		end
		etatTexte = "Fling en cours"
		return
	end

	local t = os.clock()

	if t >= prochaineAnalyse then
		prochaineAnalyse = t + 0.2
		analyser(r.Position)
		if restantes > 0 and restantesAvant == 0 then nouvelleManche() end
		restantesAvant = restantes
	end
	if t >= prochainCompact then
		prochainCompact = t + 5
		compacterListe()
	end

	local auLobby = estAuLobby()
	local engage = restantes > 0 and not auLobby and distanceMin <= RAYON_ENGAGE and not sacPlein

	if not engage then
		if enFarm then quitterFarm() end
		if restantes == 0 then
			etatTexte = "En attente de la prochaine manche"
			if aFarme and not finTraitee then
				finTraitee = true
				actionFin()
			end
		elseif sacPlein then
			etatTexte = "Sac plein"
		elseif auLobby then
			etatTexte = "Au lobby, en attente de la manche"
		else
			etatTexte = "Trop loin des pièces, en attente"
		end
		return
	end

	if not enFarm then
		entrerFarm(r, h)
		aFarme = true
		finTraitee = false
		notif("Collecte lancée", VERT_ON)
	end
	etatTexte = "Collecte en cours"

	if t >= prochainRafraichissement then
		prochainRafraichissement = t + 0.35
		rafraichirFarm(r, h)
	end

	-- Sac plein : on lit l'interface du jeu. Si elle est introuvable, on exige
	-- au moins 40 pièces récoltées ET plusieurs échecs de suite.
	if t >= prochainSac then
		prochainSac = t + 0.5
		local ui = sacPleinUI()
		if ui == true or (ui == nil and echecs >= ECHECS_SAC_PLEIN and recoltesManche >= 40) then
			sacPleinDetecte(h)
		end
	end
	-- Maintien : pas de pcall/closure par frame
	r.AssemblyLinearVelocity = Vector3.zero
	r.AssemblyAngularVelocity = Vector3.zero

	-- Choix / validité de la cible
	local murderPos = positionMurder()
	if cible and murderPos and (cible.Position - murderPos).Magnitude < RAYON_MURDER then
		cible = nil
		enContact = false
		tempsContact = 0
	end
	if cible and not recoltable(cible) then
		if enContact or (r.Position - cible.Position).Magnitude < 12 then succes() end
		cible = nil
		enContact = false
		tempsContact = 0
	end

	-- Recherche de cible avec hystérésis (évite de zigzaguer entre deux pièces)
	if not cible or t >= prochainRecheck then
		prochainRecheck = t + INTERVALLE_RECHECK
		local meilleure = choisirCible(r.Position, murderPos)
		if meilleure and meilleure ~= cible then
			if not cible then
				cible = meilleure
			elseif not enContact then
				local dActuelle = (cible.Position - r.Position).Magnitude
				local dNouvelle = (meilleure.Position - r.Position).Magnitude
				if dNouvelle < dActuelle * GAIN_HYSTERESIS then
					cible = meilleure
					tempsContact = 0
				end
			end
		end
	end
	if not cible then
		vitesseActuelle = 0
		etatTexte = "Aucune pièce atteignable (murder ou hauteur)"
		return
	end

	local cp = cible.Position
	local pos = r.Position
	local distance = (cp - pos).Magnitude

	-- Contact : on ramasse EN PASSANT, sans s'arrêter ni se téléporter sur la pièce
	if distance <= DISTANCE_CONTACT then
		enContact = true
		tempsContact = tempsContact + dt
		if t >= prochainTouch then
			prochainTouch = t + INTERVALLE_TOUCH
			ramasser(cible)
		end
		if tempsContact >= DUREE_CONTACT then
			-- La pièce est toujours là : échec (sac plein ou pièce inutilisable).
			local connaissaitTI = avaitTI[cible]
			abandonnees[cible] = t + DELAI_ABANDON
			cible = nil
			enContact = false
			tempsContact = 0
			if connaissaitTI then echecs = echecs + 1 end
			return
		end
	else
		enContact = false
		tempsContact = 0
	end

	-- Déplacement lissé : accélération progressive, vitesse conservée entre deux pièces
	local visee = cp
	if farmCfg.hauteur == "sous" then
		visee = visee - Vector3.new(0, PROFONDEUR_SOUS_PIECE, 0)
	end
	local versVisee = visee - pos
	local distVisee = versVisee.Magnitude
	if distVisee > 0.05 then
		vitesseActuelle = math.min(farmCfg.vitesse, vitesseActuelle + ACCEL * dt)
		local pasDistance = math.min(vitesseActuelle * dt, distVisee)
		local nouvelle = pos + versVisee * (pasDistance / distVisee)
		if referenceY then
			local y = nouvelle.Y
			local yMin, yMax = referenceY - farmCfg.margeVerticale, referenceY + farmCfg.margeVerticale
			if y < yMin or y > yMax then
				nouvelle = Vector3.new(nouvelle.X, math.clamp(y, yMin, yMax), nouvelle.Z)
			end
		end
		r.CFrame = cframeOriente(nouvelle)
	end
end

