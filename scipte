local traceurs = {}
local function retirerTraceur(p)
	local t = traceurs[p]
	if t then t:Destroy() end
	traceurs[p] = nil
end
local accumulateurTraceurs = 0
connecter(RunService.RenderStepped, function(dt)
	if fermee then return end
    accumulateurTraceurs = accumulateurTraceurs + dt
    if accumulateurTraceurs < (1 / 15) then return end
    accumulateurTraceurs = 0
	local cam = workspace.CurrentCamera
	if not tracersActifs or not rolesActifs or not cam then
        if next(traceurs) ~= nil then
            for p in pairs(traceurs) do retirerTraceur(p) end
        end
		return
	end
	for p in pairs(traceurs) do
		if not p.Parent then retirerTraceur(p) end
	end
	local taille = cam.ViewportSize
	local depart = Vector2.new(taille.X / 2, taille.Y)
	for _, p in ipairs(Players:GetPlayers()) do
		local role = rolesParJoueur[p]
		local rp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		local voulu = p ~= joueur and rp and (role == "murder" or role == "sherif" or role == "heros")
		local dessine = false
		if voulu then
			local pt, devant = cam:WorldToViewportPoint(rp.Position)
			if devant then
				dessine = true
				local arrivee = Vector2.new(pt.X, pt.Y)
				local t = traceurs[p]
				if not t then
					t = creer("Frame", {
						Name = "Traceur", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 0,
					}, gui)
					traceurs[p] = t
				end
				local delta = arrivee - depart
				t.BackgroundColor3 = couleurRole(role)
				t.BackgroundTransparency = 0.35
				t.Size = UDim2.fromOffset(delta.Magnitude, 2)
				t.Position = UDim2.fromOffset((depart.X + arrivee.X) / 2, (depart.Y + arrivee.Y) / 2)
				t.Rotation = math.deg(math.atan2(delta.Y, delta.X))
			end
		end
		if not dessine then retirerTraceur(p) end
	end
end)
end
