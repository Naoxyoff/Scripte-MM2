local derniereAlerte = {}
local DELAI_ANTI_SPAM = 2.5

-- Les notifications sont enregistrées uniquement dans l'historique
-- du Centre de notifications de TÉNÈBRES : aucun toast à l'écran.
local function notifier(message, couleur, cle)
    if fermee then return end
    message = tostring(message or "Notification")
    cle = tostring(cle or message)

    local maintenant = os.clock()
    local precedent = derniereAlerte[cle]
    if precedent and maintenant - precedent < DELAI_ANTI_SPAM then return end
    derniereAlerte[cle] = maintenant

    if DIAG and DIAG.consigner then
        pcall(DIAG.consigner, message)
    end
end
