		Text = description, TextColor3 = COL.MUET, TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local b = creer("TextButton", {
		Size = UDim2.fromOffset(100, 28), Position = UDim2.new(1, -116, 0.5, -14),
		BackgroundColor3 = COL.CARTE_CLAIRE, Text = lire().Name, TextColor3 = COL.TEXTE,
		Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = false,
	}, c)
	coins(b, 8)
	creer("UIStroke", { Thickness = 1, Color = COL.BORDURE, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	connecter(b.MouseEnter, function()
		if not captureEnCours then tw(b, { BackgroundColor3 = COL.ROUGE }, 0.12) end
	end)
	connecter(b.MouseLeave, function()
		if not captureEnCours then tw(b, { BackgroundColor3 = COL.CARTE_CLAIRE }, 0.12) end
	end)
	local connexion = nil
	local function arreterCapture()
		if connexion then connexion:Disconnect() connexion = nil end
		captureEnCours = false
		b.Text = lire().Name
		tw(b, { BackgroundColor3 = COL.CARTE_CLAIRE }, 0.12)
	end
	connecter(b.Activated, function()
		if captureEnCours then arreterCapture() return end
		captureEnCours = true
		b.Text = "Appuie..."
		tw(b, { BackgroundColor3 = COL.ROUGE }, 0.12)
		connexion = connecter(UserInputService.InputBegan, function(entree)
			if entree.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if entree.KeyCode == Enum.KeyCode.Escape then arreterCapture() return end
			ecrire(entree.KeyCode)
            enregistrerConfig("toucheReduireP", entree.KeyCode.Name)
            arreterCapture()
		end)
		task.delay(8, function()
			if captureEnCours then arreterCapture() end
		end)
	end)
end
