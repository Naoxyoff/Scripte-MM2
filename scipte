local farmeursCache, tFarmeurs = {}, 0
local historiqueFarmeurs = setmetatable({}, { __mode = "k" })
local INTERVALLE_SCAN_FARMEURS = 0.40
local CONFIANCE_FARMEUR_MIN = 0.68
local function positionsFarmeurs()
	if not farmCfg.eviterFarmeurs then
		table.clear(farmeursCache)
		return farmeursCache
	end
	local t = os.clock()
	if t - tFarmeurs < INTERVALLE_SCAN_FARMEURS then return farmeursCache end
	tFarmeurs = t
	local liste, presents = {}, {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= joueur then
			local perso = p.Character
			local rp = perso and perso:FindFirstChild("HumanoidRootPart")
			local hum = perso and perso:FindFirstChildOfClass("Humanoid")
			if rp and hum and hum.Health > 0 and not flyControl.Z.dansLobby(perso) then
				presents[p] = true
				local pos = rp.Position
				local hist = historiqueFarmeurs[p]
				if not hist or hist.personnage ~= perso then
					hist = { personnage = perso, position = pos, temps = t, confiance = 0,
						observations = 0, direction = nil, vitesse = Vector3.zero, derniereActivite = t }
					historiqueFarmeurs[p] = hist
				else
					local deltaTemps = math.max(0.05, t - hist.temps)
					local delta = pos - hist.position
					local horizontal = Vector3.new(delta.X, 0, delta.Z)
					local distance = horizontal.Magnitude
					local vitesse = distance / deltaTemps
					local direction = distance > 0.05 and horizontal.Unit or nil
					if distance > 45 then
						hist.confiance = math.min(1, hist.confiance + 0.12)
						hist.vitesse = Vector3.zero
						hist.derniereActivite = t
					elseif vitesse >= 6 then
						hist.confiance = math.min(1, hist.confiance + 0.24)
						hist.derniereActivite = t
						if direction and hist.direction and direction:Dot(hist.direction) > 0.72 then
							hist.confiance = math.min(1, hist.confiance + 0.12)
						end
						hist.vitesse = delta / deltaTemps
					elseif vitesse >= 1.5 then
						hist.confiance = math.min(1, hist.confiance + 0.04)
						hist.derniereActivite = t
						hist.vitesse = delta / deltaTemps
					else
						hist.confiance = math.max(0, hist.confiance - 0.16)
						hist.vitesse = Vector3.zero
					end
					hist.observations = hist.observations + 1
					if direction then hist.direction = direction end
					hist.position, hist.temps = pos, t
				end
				if hist.observations >= 3 and hist.confiance >= CONFIANCE_FARMEUR_MIN
					and t - hist.derniereActivite <= 1.25 then
					local projection = Vector3.new(hist.vitesse.X, 0, hist.vitesse.Z) * 0.30
					if projection.Magnitude > 12 then projection = projection.Unit * 12 end
					liste[#liste + 1] = { joueur = p, position = pos,
						positionPrevue = pos + projection, confiance = hist.confiance }
				end
			else
				historiqueFarmeurs[p] = nil
			end
		end
	end
	for p in pairs(historiqueFarmeurs) do
		if not presents[p] or p.Parent ~= Players then historiqueFarmeurs[p] = nil end
	end
	farmeursCache = liste
	return liste
end
local RAYON_EXCLUSION_JOUEUR = 24
local RAYON_EXCLUSION_FARMEUR = 32

local function pieceVolee(piece, pos, farmeurs)
    if not farmCfg.eviterFarmeurs or not piece or not piece.Parent then
        return false
    end

    local pp = piece.Position
    local dMoi = (pp - pos).Magnitude
    local seuil = dMoi - 8

    if seuil <= 0 then
        return false
    end

    local seuilCarre = seuil * seuil
    farmeurs = farmeurs or positionsFarmeurs()

    for i = 1, #farmeurs do
        local f = farmeurs[i]

        local deltaActuelle = pp - f.position
        local deltaPrevue = pp - f.positionPrevue

        local distanceActuelle = deltaActuelle:Dot(deltaActuelle)
        local distancePrevue = deltaPrevue:Dot(deltaPrevue)

        if math.min(distanceActuelle, distancePrevue) < seuilCarre then
            return true
        end
    end

    return false
end
local function choisirCible(position, murderPos)
	local t = os.clock()
	local meilleure, meilleureDCarree = nil, math.huge
	local meilleureDifferee, meilleureDiffereeScore = nil, math.huge
	local farmeurs = farmCfg.eviterFarmeurs and positionsFarmeurs() or {}
	for i = 1, #piecesListe do
		local p = piecesListe[i]
		local finAbandon = abandonnees[p]
		local enDelai = finAbandon and finAbandon > t
		if recoltable(p) then
			local pp = p.Position
			if math.abs(pp.Y - referenceY) <= farmCfg.margeVerticale
				and not pieceDangereuse(pp, murderPos) then
				local delta = pp - position
				local distanceCarree = delta:Dot(delta)
				local volee = pieceVolee(p, position, farmeurs)
				local penalite = (enDelai and 12 or 0) + (volee and 12 or 0)
				if penalite == 0 then
					if distanceCarree < meilleureDCarree then
						meilleure, meilleureDCarree = p, distanceCarree
					end
				elseif meilleureDiffereeScore > penalite
					and distanceCarree < (meilleureDiffereeScore - penalite) ^ 2 then
					meilleureDifferee = p
					meilleureDiffereeScore = math.sqrt(distanceCarree) + penalite
				end
			end
		end
	end
	return meilleure or meilleureDifferee
end
