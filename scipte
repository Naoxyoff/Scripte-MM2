-- Registre central des connexions : permet de couper proprement tous les
-- événements de cette exécution et d'éviter les doublons lors d'un relancement.
local environnementGlobal = getgenv and getgenv() or _G
local connexionsGlobales = environnementGlobal.__TENEBRES_CONNEXIONS
if type(connexionsGlobales) ~= "table" then
    connexionsGlobales = setmetatable({}, { __mode = "k" })
    environnementGlobal.__TENEBRES_CONNEXIONS = connexionsGlobales
end

local function connecter(signal, rappel)
    local connexion = signal:Connect(rappel)
    connexionsGlobales[connexion] = true
    return connexion
end


