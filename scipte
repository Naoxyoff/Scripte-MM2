				local yVise = math.max(toucheSol.Position.Y - 1.25, cp.Y - 3)
				viseeSolCachee = yVise
			else
				viseeSolCachee = cp.Y + 2.5
			end
		end
		visee = Vector3.new(cp.X, viseeSolCachee or (cp.Y + 2.5), cp.Z)
	end
	if distance <= DISTANCE_CONTACT then
		local directionHorizontale = Vector3.new(cp.X - pos.X, 0, cp.Z - pos.Z)
		if directionHorizontale.Magnitude < 0.05 then
