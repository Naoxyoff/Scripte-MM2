connecter(RunService.Stepped, function()
	if not actif then return end
	local maintenant = os.clock()
	if maintenant >= prochainControleCollisionsAntiFling then
		prochainControleCollisionsAntiFling = maintenant + 0.12
		for _, info in pairs(suivis) do
			local liste = info.liste
			for i = 1, #liste do
				local p = liste[i]
				if p and p.Parent and p.CanCollide then p.CanCollide = false end
			end
		end
	end
	if not racine or not racine.Parent or not humanoide then return end
	local etat = humanoide:GetState()
	if humanoide.Health <= 0
		or etat == Enum.HumanoidStateType.Dead
		or etat == Enum.HumanoidStateType.FallingDown
		or etat == Enum.HumanoidStateType.Ragdoll then
		return
	end
	if flingActif or (flyControl and (flyControl.flyOn or flyControl.farmActif)) then
		derniereSure = racine.CFrame
		derniereMaj = os.clock()
		return
	end
	local vel = racine.AssemblyLinearVelocity
	local vitesseHorizontale = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local montee = vel.Y
	local chute = -vel.Y
	if vitesseHorizontale > VITESSE_HORIZONTALE_MAX
		or montee > VITESSE_HORIZONTALE_MAX
		or chute > VITESSE_CHUTE_MAX
		or racine.AssemblyAngularVelocity.Magnitude > ROTATION_MAX then
		racine.AssemblyLinearVelocity = Vector3.zero
		racine.AssemblyAngularVelocity = Vector3.zero
		if derniereSure and (racine.Position - derniereSure.Position).Magnitude > DISTANCE_RETOUR then
			racine.CFrame = derniereSure
		end
	else
		local t = os.clock()
		if t - derniereMaj >= PAS_POSITION_SURE
			and humanoide.FloorMaterial ~= Enum.Material.Air then
			derniereSure = racine.CFrame
			derniereMaj = t
		end
	end
end)
