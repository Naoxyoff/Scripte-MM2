                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
                    if humanoideDepart:GetState() ~= Enum.HumanoidStateType.Physics then
                        humanoideDepart:ChangeState(Enum.HumanoidStateType.Physics)
                    end
