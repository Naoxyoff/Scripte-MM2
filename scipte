        local cleActivation = cleConfigControle(page, nom, "enabled")
        etatInitial = valeurConfig(cleActivation, etatInitial)
        inter = creerInterrupteurDans(c, -62, 18, etatInitial, function(v)
            enregistrerConfig(cleActivation, v)
            pcall(rappelInterrupteur, v)
        end)
        pcall(rappelInterrupteur, etatInitial)
    end
    local piste = creer("Frame", {
        Size = UDim2.new(1, -136, 0, 6), Position = UDim2.fromOffset(22, 64),
