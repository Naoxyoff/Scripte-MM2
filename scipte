local sonsPasFarm, volumesPasFarm, connPasFarm = {}, {}, nil
local prochainControleSonsFarm = 0
local function couperPasFarm(perso)
	if not perso then return end
	if not connPasFarm then
		local function ajouter(o)
			if o:IsA("Sound") then
				local n = string.lower(o.Name)
				if n == "running" or n == "walking" or n == "footsteps" or n == "footstep" then
					if volumesPasFarm[o] == nil then
						volumesPasFarm[o] = o.Volume
						sonsPasFarm[#sonsPasFarm + 1] = o
					end
					pcall(function() o.Volume = 0; o:Stop() end)
				end
			end
		end
		for _, o in ipairs(perso:GetDescendants()) do ajouter(o) end
		connPasFarm = connecter(perso.DescendantAdded, ajouter)
	end
	-- Le scan de maintien n'a pas besoin de tourner à 90 Hz : les nouveaux sons
	-- sont coupés immédiatement par DescendantAdded, puis les sons connus sont
	-- recontrôlés à 8 Hz pour neutraliser ceux relancés par le jeu.
	local maintenant = os.clock()
	if maintenant < prochainControleSonsFarm then return end
	prochainControleSonsFarm = maintenant + 0.12
	for i = 1, #sonsPasFarm do
		local s = sonsPasFarm[i]
		if s.Parent and (s.Volume ~= 0 or s.Playing) then
			pcall(function() s.Volume = 0; s:Stop() end)
		end
	end
end
local function restaurerPasFarm()
	if connPasFarm then deconnecter(connPasFarm); connPasFarm = nil end
	for _, s in ipairs(sonsPasFarm) do
		if s.Parent and volumesPasFarm[s] ~= nil then
			pcall(function() s.Volume = volumesPasFarm[s] end)
		end
	end
	sonsPasFarm, volumesPasFarm = {}, {}
	prochainControleSonsFarm = 0
end
local function figerAnimations(perso, h)
	couperPasFarm(perso)
