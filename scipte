local function creerInterrupteurDans(c, x, y, defaut, rappel)
	local piste = creer("TextButton", {
		Size = UDim2.fromOffset(46, 24), Position = UDim2.new(1, x, 0, y),
		Text = "", AutoButtonColor = false, BackgroundColor3 = COL.GRIS,
	}, c)
	pilule(piste)
	local rond = creer("Frame", {
		Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = COL.BLANC, BorderSizePixel = 0,
	}, piste)
	pilule(rond)
	local etat = defaut
	local function afficher()
		tw(piste, { BackgroundColor3 = etat and COL.ROUGE or Color3.fromRGB(55, 48, 52) }, 0.15)
		tw(rond, { Position = UDim2.fromOffset(etat and 25 or 3, 3) }, 0.2, Enum.EasingStyle.Back)
	end
	connecter(piste.Activated, function()
		etat = not etat
		afficher()
		rappel(etat)
	end)
	afficher()
	return {
		get = function() return etat end,
		set = function(valeur)
			if etat == valeur then return end
			etat = valeur
			afficher()
			rappel(etat)
		end,
	}
end
