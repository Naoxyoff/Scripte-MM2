local modeZombieCache, tModeZombie = false, 0
-- Une manche est « réelle » quand le compte à rebours est terminé : le joueur local n'est
-- plus au lobby et au moins un autre joueur vivant est en jeu, hors du lobby.
-- Rien n'est donc verrouillé pendant le lobby ni pendant le compte à rebours.
local mancheReelleCache, tMancheReelle = false, 0
local function mancheReelle()
    local t = os.clock()
    if t - tMancheReelle < 0.2 then return mancheReelleCache end
    tMancheReelle = t
    local resultat = false
    if not estAuLobbyPourChams() then
        for _, q in ipairs(Players:GetPlayers()) do
            if q ~= joueur then
                local persoQ = q.Character
                local humQ = persoQ and persoQ:FindFirstChildOfClass("Humanoid")
                if humQ and humQ.Health > 0 and not estDansLobby(persoQ) then
                    resultat = true
                    break
                end
            end
        end
    end
    mancheReelleCache = resultat
    return resultat
end
function modeZombie()
    local t = os.clock()
    if t - tModeZombie > 0.5 then
        tModeZombie = t
        local Z = flyControl.Z
        local precedent = modeZombieCache
        local trouve = false
        if mancheReelle() then
            local n = 0
            for _, q in ipairs(Players:GetPlayers()) do
                if joueurVivant(q) and not estDansLobby(q.Character) and possedeCouteauZombie(q) then n = n + 1 end
            end
            Z.nbCouteaux = n
            for _, role in pairs(rolesServeur) do
                if role == "sherif" then Z.classiqueGen = generationManche break end
            end
            -- Infection détectée par les couteaux : 2 couteaux ou plus en partie, sans Sheriff
            -- classique dans cette manche. Verrouillé pour la manche (le 1er zombie compris).
            if n == 0 or Z.classiqueGen == generationManche then
                Z.infectionGen = nil
            elseif n >= 2 then
                Z.infectionGen = generationManche
            end
            Z.modeCouteau = Z.infectionGen ~= nil and Z.infectionGen == generationManche
            if Z.classiqueGen == generationManche then
                -- Un Sheriff existe dans cette manche : c'est du Classic, jamais de chams zombie.
                trouve = false
            elseif Z.modeCouteau then
                trouve = true
            else
                -- Indice explicite (équipe zombie / attribut infecté) sans Sheriff connu.
                for _, q in ipairs(Players:GetPlayers()) do
                    local persoQ = q.Character
                    if (q.Team and estNomZombie(q.Team.Name))
                        or attributZombieExplicite(q) or attributZombieExplicite(persoQ) then
                        trouve = true
                        break
                    end
                end
            end
        end
        modeZombieCache = trouve
        if trouve ~= precedent then
            -- Changement de mode : on purge l'autre système pour éviter tout résidu de couleur.
            if trouve then
                for p in pairs(halos) do retirerHalo(p) end
                for p in pairs(boites) do retirerBoite(p) end
            else
                for p in pairs(flyControl.Z.halos) do flyControl.Z.retirer(p) end
            end
        end
    end
    return modeZombieCache
end
