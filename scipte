                pcall(function()
                    humanoideDepart.PlatformStand = false
                    humanoideDepart.AutoRotate = true
                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                    humanoideDepart:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
            if poussoir then pcall(function() poussoir:Destroy() end) end
            task.spawn(function()
                for _ = 1, 12 do
                    if not (racineDepart and racineDepart.Parent) then break end
                    pcall(function()
                        racineDepart.CFrame = origine + Vector3.new(0, 3, 0)
                        for _, pp in ipairs(racineDepart.Parent:GetDescendants()) do
                            if pp:IsA("BasePart") then
                                pp.AssemblyLinearVelocity = Vector3.zero
                                pp.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end)
                    RunService.Heartbeat:Wait()
                end
                pcall(function() workspace.FallenPartsDestroyHeight = ancienFPDH end)
            end)
            if antiFlingEtait then definirActif(true) end
            if flyEtait then flyControl.activerFly(true) end
            if noclipEtait then flyControl.activerNoclip(true) end
            if notifierInterface then
                notifierInterface(message, couleur, "fling_fin_" .. tostring(os.clock()))
            end
        end

        local cycle = 0
        local angle = 0
        local DECALAGES = {
            Vector3.new(0, 1.5, 0), Vector3.new(0, -1.5, 0),
            Vector3.new(2.25, 1.5, -2.25), Vector3.new(-2.25, -1.5, 2.25),
            Vector3.new(0, 1.5, 2.25), Vector3.new(0, -1.5, -2.25),
        }
        -- CORRECTION : le cube d'impact mesure 10 studs de côté, soit une demi-largeur de 5.
        -- Tant que le centre du cube reste à moins de PORTEE_VERROU du HumanoidRootPart visé,
        -- la cible est forcément à l'intérieur du cube et la pénétration est créée. Au-delà,
        -- le cube passe à côté : c'était la cause exacte des flings qui rataient les cibles rapides.
        local PORTEE_VERROU = 4.5
        -- Anticipation exprimée en nombre de pas physiques, et non en studs absolus.
        local HORIZON_ANTICIPATION = 1.5
        -- Plafond de l'anticipation seule, pour qu'elle ne consomme jamais tout le verrou.
        local ANTICIPATION_MAX = 3
        conn = RunService.Heartbeat:Connect(function(dt)
            if fini then return end
            if fermee then return terminer("Fling arrêté", COL.ORANGE) end
            if racine ~= racineDepart or not racineDepart.Parent then
                return terminer("Fling arrêté : perso changé", COL.ORANGE)
            end
            local t = os.clock() - debut

            local perso = cible.Character
            local rp = perso and perso:FindFirstChild("HumanoidRootPart")
            if not rp or not rp:IsDescendantOf(workspace) then
                return terminer("Cible perdue", COL.ROUGE)
            end
            derniere = rp.Position

            -- Cible déjà éjectée : on arrête.
            if t > 0.25 and (rp.AssemblyLinearVelocity.Magnitude > 500 or (rp.Position - departCible).Magnitude > 250) then
                touche = true
                return terminer("Cible percutée", COL.VERT)
            end
            if t >= DUREE_MAX then
                return terminer("Fling terminé sans effet visible", COL.MUET)
            end

            -- Collision continue : on s'accroche à la cible en tournoyant autour d'elle.
            cycle = cycle % #DECALAGES + 1
            angle = angle + 100
            local tete = perso:FindFirstChild("Head")
            local base = ((cycle % 3 == 0) and tete and tete:IsA("BasePart")) and tete or rp
            local hum = perso:FindFirstChildOfClass("Humanoid")

            -- CORRECTION : l'anticipation est calculée sur la VRAIE vitesse horizontale de la
            -- cible (et non sur MoveDirection, qui décrit l'entrée clavier et pointe à l'opposé
            -- quand la cible est projetée), sur un horizon court d'un peu plus d'un pas physique,
            -- puis bornée pour ne jamais dépasser le rayon de recouvrement à elle seule.
            local vitesseCible = rp.AssemblyLinearVelocity
            local vitesseHorizontale = Vector3.new(vitesseCible.X, 0, vitesseCible.Z)
            local directionCible = Vector3.zero
            if vitesseHorizontale.Magnitude > 0.5 then
                directionCible = vitesseHorizontale.Unit
            elseif hum then
                directionCible = hum.MoveDirection
            end
            local pas = math.clamp(dt or 0, 0, 0.1)
            local anticipation = directionCible
                * math.min(vitesseHorizontale.Magnitude * pas * HORIZON_ANTICIPATION, ANTICIPATION_MAX)

            -- CORRECTION : le décalage total (offset de cycle + anticipation) est ramené dans le
            -- rayon de verrou, ce qui garantit le recouvrement géométrique quelle que soit la vitesse.
            local decalage = DECALAGES[cycle] + anticipation
            if decalage.Magnitude > PORTEE_VERROU then
                decalage = decalage.Unit * PORTEE_VERROU
            end

            pcall(function()
                racineDepart.CFrame = CFrame.new(base.Position + decalage)
                    * CFrame.Angles(math.rad(angle), math.rad(math.random(0, 360)), math.rad(math.random(0, 360)))
                racineDepart.AssemblyLinearVelocity = Vector3.new(9e7, 9e7 * 10, 9e7) * puissanceFling
                racineDepart.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
            end)
        end)

        if notifierInterface then notifierInterface("FLING sur " .. cible.DisplayName, COL.ROUGE, "fling_debut_" .. tostring(os.clock())) end
    end
end
