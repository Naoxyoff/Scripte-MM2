	local function nettoyer()
		if termine then return end
		termine = true
		if connexionAjout then deconnecter(connexionAjout); connexionAjout = nil end
		if connexionMort then deconnecter(connexionMort); connexionMort = nil end
		for son, volume in pairs(volumesOriginaux) do
			if son and son.Parent then pcall(function() son.Volume = volume end) end
		end
		resetAutoSilencieuxActif = false
	end
	for _, objet in ipairs(personnage:GetDescendants()) do neutraliser(objet) end
	connexionAjout = connecter(personnage.DescendantAdded, neutraliser)
	connexionMort = connecter(h.Died, function()
		for _, objet in ipairs(personnage:GetDescendants()) do neutraliser(objet) end
