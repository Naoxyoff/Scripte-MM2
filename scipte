-- Verrou central : aucun callback ni traitement différé ne s'exécute avant
-- la fin réelle de l'initialisation. Le BindableEvent évite toute boucle d'attente.
local chargementTermine = false
local chargementAnnule = false
local signalFinChargement = Instance.new("BindableEvent")
local restaurationsEnAttente = {}
if type(connexionsGlobales) ~= "table" then
    connexionsGlobales = setmetatable({}, { __mode = "k" })
    environnementGlobal.__TENEBRES_CONNEXIONS = connexionsGlobales
end

local function connecter(signal, rappel)
    local connexion = signal:Connect(function(...)
        if not chargementTermine or environnementGlobal.__TENEBRES_FERMER == true then
            return
        end
        rappel(...)
    end)
    connexionsGlobales[connexion] = true
    return connexion
end

local function attendreChargement()
    if not chargementTermine and not chargementAnnule then
        signalFinChargement.Event:Wait()
    end
    return chargementTermine and not chargementAnnule
        and environnementGlobal.__TENEBRES_FERMER ~= true
end

local function lancerTache(fonction, ...)
    local args = table.pack(...)
    task.spawn(function()
        if not attendreChargement() then return end
        local ok, erreur = xpcall(function()
            fonction(table.unpack(args, 1, args.n))
        end, debug.traceback)
        if not ok then
            warn("[Les Ténèbres] Tâche interrompue : " .. tostring(erreur))
        end
    end)
end

local function restaurerApresChargement(fonction)
    if type(fonction) ~= "function" then return end
    if chargementTermine then
        pcall(fonction)
    else
        restaurationsEnAttente[#restaurationsEnAttente + 1] = fonction
    end
end

local function terminerChargement()
    if chargementTermine or chargementAnnule then return end
    chargementTermine = true
    for i = 1, #restaurationsEnAttente do
        local ok, erreur = pcall(restaurationsEnAttente[i])
        if not ok then
            warn("[Les Ténèbres] Restauration ignorée : " .. tostring(erreur))
        end
    end
    table.clear(restaurationsEnAttente)
    signalFinChargement:Fire()
end
local function deconnecter(connexion)
    if not connexion then return end
    connexionsGlobales[connexion] = nil
    pcall(function() connexion:Disconnect() end)
end
