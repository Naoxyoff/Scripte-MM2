local persoDuRole = {}
local centreLobbyJoueurs, tCentreLobby = nil, 0
local function obtenirCentreLobby()
	local maintenant = os.clock()
	if maintenant - tCentreLobby < (centreLobbyJoueurs and 30 or 2) then return centreLobbyJoueurs end
	tCentreLobby = maintenant
	centreLobbyJoueurs = nil
	local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("lobby")
	if lobby then
		local spawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
		if spawn then
			centreLobbyJoueurs = spawn.Position
		else
			local ok, cf = pcall(function() return lobby:GetBoundingBox() end)
			if ok then centreLobbyJoueurs = cf.Position end
		end
	end
	return centreLobbyJoueurs
end
local function estDansLobby(personnage)
	local centre = obtenirCentreLobby()
	local rp = personnage and personnage:FindFirstChild("HumanoidRootPart")
	if not centre or not rp then return false end
	return (rp.Position - centre).Magnitude < 80
end
