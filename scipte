do
	local RS = game:GetService("ReplicatedStorage")
	local function normaliser(v)
		if type(v) ~= "string" then return nil end
		local t = string.lower(v)
		if string.find(t, "murder", 1, true) then return "murder" end

		if string.find(t, "sher", 1, true) then return "sherif" end
		if string.find(t, "hero", 1, true) then return "heros" end
		if string.find(t, "innocent", 1, true) then return "innocent" end
		return nil
	end

	local function resoudreNomJoueur(cle)
		if typeof(cle) == "Instance" and cle:IsA("Player") then
			return cle.Name
		end
		local texte = tostring(cle)
		local correspondance, nb = nil, 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name == texte or tostring(p.UserId) == texte then
				return p.Name
			elseif p.DisplayName == texte then
				correspondance = p.Name
				nb = nb + 1
			end
		end
		if nb == 1 then return correspondance end
		return nil
	end
	local function lireTable(t)
		if type(t) ~= "table" then return nil end
		local res, trouve, visites = {}, false, {}
		local function parcourir(tab, profondeur)
			if type(tab) ~= "table" or profondeur > 6 or visites[tab] then return end
			visites[tab] = true
			local roleDirect = normaliser(tab.Role or tab.role or tab.RoleName or tab.roleName or tab.PlayerRole or tab.playerRole)
			if roleDirect and (tab.Dead == true or tab.Killed == true or tab.dead == true or tab.killed == true) then roleDirect = "innocent" end
			local joueurDirect = tab.Player or tab.player or tab.UserId or tab.userId or tab.Name or tab.name or tab.DisplayName or tab.displayName
			if roleDirect and joueurDirect ~= nil then
				local nomDirect = resoudreNomJoueur(joueurDirect)
				if nomDirect then res[nomDirect] = roleDirect; trouve = true end
			end
			for k, v in pairs(tab) do
				local role = nil
				local cleJoueur = nil
				local roleDansCle = normaliser(k)
				if type(v) == "table" then
					role = normaliser(v.Role or v.role or v.RoleName or v.roleName or v.PlayerRole or v.playerRole)
					if role and (v.Dead == true or v.Killed == true or v.dead == true or v.killed == true) then role = "innocent" end
					local identite = v.Player or v.player or v.UserId or v.userId or v.Name or v.name or v.DisplayName or v.displayName
					if identite ~= nil then cleJoueur = resoudreNomJoueur(identite) end
				elseif type(v) == "string" then
					role = normaliser(v)
				end
				if role then
					local nom = cleJoueur or resoudreNomJoueur(k)
					if nom then res[nom] = role; trouve = true end
				elseif roleDansCle then
					-- Certains paquets serveur rangent directement le joueur sous la clé Murderer/Sheriff.
					local nom = resoudreNomJoueur(v)
					if nom then res[nom] = roleDansCle; trouve = true
					elseif type(v) == "table" then
						for _, identite in pairs(v) do
							local nomListe = resoudreNomJoueur(identite)
							if nomListe then res[nomListe] = roleDansCle; trouve = true end
						end
					end
				elseif type(v) == "table" then
					parcourir(v, profondeur + 1)
				end
			end
		end
		parcourir(t, 0)
		return trouve and res or nil
	end

	-- Un Murder / Sheriff verrouillé ne peut être remplacé que si son détenteur
