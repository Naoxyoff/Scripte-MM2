local variantesOutilCache = {}
local function aOutil(joueurCible, nom)
	local perso = joueurCible.Character
	local sac = joueurCible:FindFirstChildOfClass("Backpack")
	local attendu = string.lower(nom)
	local variantes = variantesOutilCache[attendu]
	if not variantes then
		variantes = {
			[attendu] = true,
			[attendu .. "display"] = true,
			[attendu .. "_display"] = true,
			[attendu .. " display"] = true,
		}
		if attendu == "gun" then
			variantes.revolver = true
			variantes.sheriffgun = true
			variantes.sheriff_gun = true
			variantes.pistol = true
		end
		variantesOutilCache[attendu] = variantes
	end
	local function contient(container)
		if not container then return false end
		for _, objet in ipairs(container:GetChildren()) do
			if objet:IsA("Tool") then
				local bas = string.lower(objet.Name)
				if variantes[bas] then return true end
				if string.find(bas, "[%s%-]") then
					local nomObjet = string.gsub(bas, "[%s%-]", "_")
					if variantes[nomObjet] then return true end
				end
			end
		end
		return false
	end
	return contient(perso) or contient(sac)
end

local function possedeVraiCouteau(joueurCible)
	local perso = joueurCible.Character
	local sac = joueurCible:FindFirstChildOfClass("Backpack")
	local function contient(container)
		if not container then return false end
		for _, objet in ipairs(container:GetChildren()) do
			if objet:IsA("Tool") and string.lower(objet.Name) == "knife" then
				return true
			end
		end
		return false
	end
	return contient(perso) or contient(sac)
end

local function joueurVivant(p)
	if not p then return false end
	local perso = p.Character
	local hum = perso and perso:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

calculerRoles = function()
	if finMancheEnAttente then
		finMancheEnAttente = false
		armesVues = false
		tDerniereArme = 0
		sheriffOrigine = nil
		herosOrigine = nil
		gunDropVu = false
		flyControl.Z.infectionGen = nil
		flyControl.Z.classiqueGen = nil
		flyControl.Z.modeCouteau = false
	end
	if nouvelleMancheAnnoncee then
		nouvelleMancheAnnoncee = false
		armesVues = false
		tDerniereArme = 0
		sheriffOrigine = nil
		herosOrigine = nil
		gunDropVu = false
		table.clear(joueursElimines)
		table.clear(persoDuRole)
		flyControl.Z.infectionGen = nil
		flyControl.Z.classiqueGen = nil
		flyControl.Z.modeCouteau = false
	end

	if mancheTerminee then
		local tousInnocents = {}
		for _, p in ipairs(Players:GetPlayers()) do tousInnocents[p] = "innocent" end
		rolesParJoueur = tousInnocents
		infoManche, infoMurder, infoSherif, infoHeros = "Aucune", "—", "—", "—"
		return
	end

	local listeJoueurs = Players:GetPlayers()
	local vuEnMap = flyControl.vuEnMap
	if not vuEnMap then vuEnMap = {}; flyControl.vuEnMap = vuEnMap end

	-- Mort = Humanoid à 0 PV. Un personnage absent (téléportation, rechargement) n'est PAS une mort.
	local function estMort(p)
		local perso = p and p.Character
		local hum = perso and perso:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.Health <= 0
	end

	-- RÈGLE : un rôle détecté (Murder / Sheriff / Héros) est conservé jusqu'à la mort de
	-- son porteur. Ensuite il redevient innocent jusqu'à la prochaine manche.
	for _, p in ipairs(listeJoueurs) do
		if estMort(p) and not joueursElimines[p.Name] then
			joueursElimines[p.Name] = true
			rolesServeur[p.Name] = nil
			persoDuRole[p.Name] = nil
			if p == herosOrigine then herosOrigine = nil end
		end
	end

	local porteurs = {}
	for _, p in ipairs(listeJoueurs) do
		if p.Character and not estMort(p) and not joueursElimines[p.Name] and aOutil(p, "Gun")
			and not estDansLobby(p.Character) then
			porteurs[#porteurs + 1] = p
		end
	end

	-- Murder et Sheriff proviennent exclusivement du rôle transmis par le serveur.
	local murder = nil
	for _, p in ipairs(listeJoueurs) do
		if not joueursElimines[p.Name] and rolesServeur[p.Name] == "murder" then
			murder = p
			break
		end
	end

	if not sheriffOrigine then
		for _, p in ipairs(listeJoueurs) do
			if rolesServeur[p.Name] == "sherif" then
				sheriffOrigine = p
				break
			end
		end
	end

	local gunDropPresent = flyControl.trouverGunDrop() ~= nil
	if gunDropPresent then gunDropVu = true end
	local sheriffMort = sheriffOrigine ~= nil and (joueursElimines[sheriffOrigine.Name] == true
		or estMort(sheriffOrigine) or sheriffOrigine.Parent == nil)

	-- Le Héros est mémorisé au premier ramassage du pistolet après la mort du Sheriff,
	-- et le garde jusqu'à sa propre mort.
	if sheriffMort and not herosOrigine then
		for _, p in ipairs(porteurs) do
			if p ~= sheriffOrigine and p ~= murder then
				herosOrigine = p
				break
			end
		end
	end
	if herosOrigine and (joueursElimines[herosOrigine.Name] or estMort(herosOrigine) or herosOrigine.Parent == nil) then
		herosOrigine = nil
	end

	if murder or sheriffOrigine or #porteurs > 0 or gunDropPresent then
		armesVues = true
		tDerniereArme = os.clock()
	elseif armesVues and os.clock() - tDerniereArme > 30
		and os.clock() - dernierRoleServeur > 10 then
		armesVues = false
		table.clear(rolesServeur)
		verrouRoles.murder, verrouRoles.sherif = nil, nil
		table.clear(joueursElimines)
		table.clear(persoDuRole)
		sheriffOrigine = nil
		herosOrigine = nil
		gunDropVu = false
	end

	local sherif = (sheriffOrigine and not sheriffMort) and sheriffOrigine or nil
	local heros = herosOrigine

	local nouveau = {}
	local srvActif = false
	for _, p in ipairs(listeJoueurs) do
		local r = "innocent"
		local personnage = p.Character
		local hum = personnage and personnage:FindFirstChildOfClass("Humanoid")
		local srv = rolesServeur[p.Name]
		local auLobby = hum ~= nil and estDansLobby(personnage)
		if p == joueur and flyControl.arriveeManuelle
			and (auLobby or generationManche ~= flyControl.genArrivee) then
			flyControl.arriveeManuelle = false
		end

		-- Le lobby n'efface le rôle que si le joueur a déjà été vu en map pendant cette manche
		-- (retour au lobby = fin de manche). Avant la téléportation, le rôle est déjà affiché.
		if srv and srv ~= "innocent" and hum ~= nil and not auLobby then
			vuEnMap[p.Name] = generationManche
		end
		local retourLobby = auLobby and vuEnMap[p.Name] == generationManche

		if joueursElimines[p.Name] or retourLobby then
			r = "innocent"
		elseif p == murder then
			r = "murder"
		elseif p == sheriffOrigine and not sheriffMort then
			r = "sherif"
		elseif p == herosOrigine then
			r = "heros"
		elseif srv and srv ~= "innocent" then
			r = srv
		end

		if r ~= "innocent" then srvActif = true end
		nouveau[p] = r
	end
	rolesParJoueur = nouveau

	murder, sherif, heros = nil, nil, nil
	for p, r in pairs(nouveau) do
		if r == "murder" then murder = p
		elseif r == "sherif" then sherif = p
		elseif r == "heros" then heros = p end
	end

	infoManche = (srvActif or murder or sheriffOrigine or #porteurs > 0 or gunDropPresent) and "En cours" or "Aucune"
	infoMurder = murder and murder.Name or "—"
	infoSherif = sherif and sherif.Name or "—"
	infoHeros = heros and heros.Name or "—"

	if infoManche == "En cours" then
