	for i = 1, #MOTS_PIECE do
		if string.find(n, MOTS_PIECE[i], 1, true) then return true end
	end
	return false
end

local function dansPersonnage(obj)
	local p = obj.Parent
	while p and p ~= workspace do
		if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return true end
		p = p.Parent
	end
	return false
end

local function estPiece(obj)
	if not obj:IsA("BasePart") then return false end

	if obj.Transparency >= 0.98 and not obj:FindFirstChildOfClass("TouchTransmitter") then return false end
	local s = obj.Size
	if math.max(s.X, s.Y, s.Z) > TAILLE_MAX_PIECE then return false end
	if nomValide(obj.Name) then return true end
	local parent = obj.Parent
	if parent and parent ~= workspace and parent:IsA("Model") and nomValide(parent.Name) then return true end
	return false
end

local function ajouterPiece(obj)
	if piecesConnues[obj] then
		if not avaitTI[obj] and obj:FindFirstChildOfClass("TouchTransmitter") then avaitTI[obj] = true end
		return false
	end
	if piecesVivantes >= MAX_INDEX then return false end
	if dansPersonnage(obj) then return false end
	if not estPiece(obj) then return false end
	piecesConnues[obj] = true
	avaitTI[obj] = obj:FindFirstChildOfClass("TouchTransmitter") ~= nil
	piecesVivantes = piecesVivantes + 1
	piecesListe[#piecesListe + 1] = obj
	return true
end

local function nomPieceRapide(nom)
	return string.find(nom, "[Cc][Oo][Ii][Nn]") ~= nil or string.find(nom, "[Cc][Aa][Nn][Dd][Yy]") ~= nil
end
local function candidatPiece(obj)
	if nomPieceRapide(obj.Name) then return true end
	local p = obj.Parent
	return p ~= nil and p ~= workspace and nomPieceRapide(p.Name)
end

local indexDemande = false
local fileAjouts = {}
local ajoutsEnFile = {}
local traitementAjouts = false
local connexionIndexAjout, connexionIndexSuppression = nil, nil
local mettreEnFile
local generationIndex = 0
local verifierLobbyPourIndex = nil

local function deconnecterIndexWorkspace()

	generationIndex = generationIndex + 1
	indexDemande = false
	if connexionIndexAjout then connexionIndexAjout:Disconnect(); connexionIndexAjout = nil end
	if connexionIndexSuppression then connexionIndexSuppression:Disconnect(); connexionIndexSuppression = nil end
	table.clear(fileAjouts)
	table.clear(ajoutsEnFile)
	traitementAjouts = false
	constructionIndex = false
end

local function connecterIndexWorkspace()
	if connexionIndexAjout then return end
	indexDemande = true
	connexionIndexAjout = connecter(workspace.DescendantAdded, function(obj)

		if not armee or fermee then return end
		if obj:IsA("BasePart") then
			if candidatPiece(obj) then mettreEnFile(obj) end
		elseif obj:IsA("TouchTransmitter") then
			local p = obj.Parent
			if p and candidatPiece(p) then mettreEnFile(obj) end
		end
	end)
	connexionIndexSuppression = connecter(workspace.DescendantRemoving, function(obj)
		if not armee or not piecesConnues[obj] then return end
		task.defer(function()
			if obj:IsDescendantOf(workspace) or not piecesConnues[obj] then return end
			piecesConnues[obj] = nil
			avaitTI[obj] = nil
			piecesVivantes = math.max(0, piecesVivantes - 1)
		end)
	end)
end

mettreEnFile = function(obj)
	if not indexDemande or not armee or fermee or not obj then return end
	if fileAjouts[obj] then return end
	fileAjouts[obj] = true
	ajoutsEnFile[#ajoutsEnFile + 1] = obj
	if traitementAjouts then return end
	traitementAjouts = true
	local generation = generationIndex
	task.spawn(function()
		local tete = 1
		while tete <= #ajoutsEnFile and not fermee and armee and generation == generationIndex do

			local t0 = os.clock()
			while tete <= #ajoutsEnFile and os.clock() - t0 < 0.002 and armee and generation == generationIndex do
				local item = ajoutsEnFile[tete]
				tete = tete + 1
				fileAjouts[item] = nil
				if item and item.Parent then
					if item:IsA("BasePart") then
						ajouterPiece(item)
					elseif item:IsA("TouchTransmitter") and item.Parent then
						ajouterPiece(item.Parent)
					end
				end
			end
			if tete <= #ajoutsEnFile then task.wait() end
		end
		if generation == generationIndex then
			table.clear(ajoutsEnFile)
			traitementAjouts = false
		end
	end)
end

local function construireIndex()
	if constructionIndex then return end
	constructionIndex = true
	local generation = generationIndex
	task.spawn(function()

		while not fermee and armee and generation == generationIndex
			and (not racine or not racine.Parent or (verifierLobbyPourIndex and verifierLobbyPourIndex())) do
			task.wait(0.5)
		end
		if fermee or not armee or generation ~= generationIndex then
			if generation == generationIndex then constructionIndex = false end
			return
		end
		task.wait(1.5)
		if fermee or not armee or generation ~= generationIndex then
			if generation == generationIndex then constructionIndex = false end
			return
		end
		connecterIndexWorkspace()
		local pile = { workspace }
		local t0 = os.clock()
		while #pile > 0 and not fermee and armee and generation == generationIndex do
			local conteneur = table.remove(pile)
			if conteneur and conteneur.Parent then
				local enfants = conteneur:GetChildren()
				for _, obj in ipairs(enfants) do
					if not armee or generation ~= generationIndex then break end
					if obj:IsA("BasePart") then
						if candidatPiece(obj) then ajouterPiece(obj) end
					elseif obj:IsA("Model") or obj:IsA("Folder") then
						if not (obj:IsA("Model") and Players:GetPlayerFromCharacter(obj)) then
							pile[#pile + 1] = obj
						end
					end
					if os.clock() - t0 > 0.002 then
						task.wait()
						t0 = os.clock()
					end
				end
			end
		end
		if generation == generationIndex then constructionIndex = false end
	end)
end

local function compacterListe()
	if #piecesListe < 80 then return end
	local neuve = {}
	for i = 1, #piecesListe do
		local p = piecesListe[i]
