local function entrerFarm(r, h)
	if enFarm then return end
	enFarm = true
	flyControl.farmActif = true
	flyEtaitActif = flyControl.flyOn
	if flyEtaitActif then flyControl.activerFly(false) end
	if not flyControl.noclipOn then
		noclipParFarm = true
		flyControl.activerNoclip(true, true)
	end
	referenceY = r.Position.Y
	r.Anchored = false
	pcall(function()
		h.AutoRotate = false
		h.PlatformStand = true
		h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		h:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	creerMaintien(r)
end

local function rayonSolide(origine, direction, params)
	local exclusions = params.FilterDescendantsInstances
	for _ = 1, 6 do
		local hit = workspace:Raycast(origine, direction, params)
		if not hit then return nil end
		if hit.Instance.CanCollide then return hit end
		table.insert(exclusions, hit.Instance)
		params.FilterDescendantsInstances = exclusions
	end
	return nil
end

local function posePropre(r)
	local pos = r.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local exclusions = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(exclusions, p.Character) end
	end
	params.FilterDescendantsInstances = exclusions

	local y
	local sol = rayonSolide(pos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), params)
	if sol then
		y = sol.Position.Y + 3
	else
		local haut = rayonSolide(pos, Vector3.new(0, 80, 0), params)
		if haut then
			y = haut.Instance.Position.Y + haut.Instance.Size.Y / 2 + 3
		else
			y = (referenceY or pos.Y) + 3
		end
	end

	local cam = workspace.CurrentCamera
	local regard = cam and Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) or Vector3.new(0, 0, -1)
	if regard.Magnitude < 0.05 then regard = Vector3.new(0, 0, -1) end
	local p = Vector3.new(pos.X, y, pos.Z)
	return CFrame.lookAt(p, p + regard.Unit)
end

local function quitterFarm()
	if not enFarm then return end
	enFarm = false
	flyControl.farmActif = false
	cible = nil
	enContact = false
	tempsContact = 0
	vitesseActuelle = 0
	if maintien then
		pcall(function() maintien:Destroy() end)
		maintien = nil
	end
	local r, h = racine, humanoide
	if r and r.Parent then
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero

			r.CFrame = posePropre(r)
		end)
	end
	if h and h.Parent then
		pcall(function()
			-- Correctif sortie douce : FallingDown/Ragdoll restent désactivés ~1,5 s
			-- pour éviter que le personnage s'effondre au sol en quittant le farm.
			h.PlatformStand = false
			h.AutoRotate = true
			h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
			h.Sit = false
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
		task.spawn(function()
			for _ = 1, 8 do
				task.wait(0.05)
				if enFarm or flyControl.flyOn or flingActif then return end
				if r and r.Parent then
					pcall(function()
						r.AssemblyLinearVelocity = Vector3.zero
						r.AssemblyAngularVelocity = Vector3.zero
					end)
				end
			end
		end)
		task.delay(0.1, function()
			if h and h.Parent and not enFarm and not flyControl.flyOn and not flingActif then
				pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
			end
		end)
		task.delay(1.5, function()
			if h and h.Parent and not enFarm then
				pcall(function()
					h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
					h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
				end)
			end
		end)
	end
	if noclipParFarm then
		noclipParFarm = false
		if flyControl.noclipOn then flyControl.activerNoclip(false, true) end
	end
	if flyEtaitActif then
		flyEtaitActif = false
		flyControl.activerFly(true)
	end
end

local function rafraichirFarm(r, h)
	pcall(function()
		if not h.PlatformStand then h.PlatformStand = true end
		if h:GetState() ~= Enum.HumanoidStateType.Physics then
			h:ChangeState(Enum.HumanoidStateType.Physics)
		end
	end)
	if not maintien or not maintien.Parent then creerMaintien(r) end

	if not flyControl.noclipOn then
		noclipParFarm = true
		flyControl.activerNoclip(true, true)
	end
end

-- Correctif : fin de manche / blocage. Le farm sort du sol dès que la manche est finie
-- (murder mort, sheriff/héros/murder vainqueur) ou qu'aucune pièce n'est récoltée depuis longtemps.
local murderVu, tMurderAbsent = false, nil
local murderNom = nil
local vuLobbyApresFin = false
local prochainVerifSacPlein = 0
local resetEffectue = false
local pauseStallJusqua, derniereRecolte = 0, 0
local DELAI_SANS_RECOLTE = 25
local DELAI_MURDER_ABSENT = 2.5

local function nouvelleManche()
	murderVu, tMurderAbsent = false, nil
	resetEffectue = false
	murderNom = nil
	pauseStallJusqua, derniereRecolte = 0, os.clock()
