do
local pageTP = pages["Joueur"]
section(pageTP, "Liste des joueurs")

local puissanceFling = 1
local avanceFling = 1

local entrees = {}

local flingVers
do

    local TAILLE_IMPACT      = Vector3.new(7, 7, 7)
    local DENSITE_IMPACT     = 120
    local VITESSE_IMPACT     = 400
    local VITESSE_IMPACT_MAX = 1200

    local DUREE_MAX          = 6.0
    local DUREE_APRES_ENVOI  = 2.00
    local VITESSE_ENVOI      = 150
    local VITESSE_VERTICALE  = 60
    local VITESSE_RAGDOLL    = 50
    local DISTANCE_CONTACT   = 8
    local CHUTE_CARTE        = 80

    local MARGE_ANTICIPATION = 0.06
    local HORIZON_MIN        = 0.03
    local HORIZON_MAX        = 0.18
    local LEAD_MAX           = 5
    local PORTEE_VERROU      = 6
    local HAUTEUR_CONTACT    = 1.8
    local DECALAGE_ARRIERE   = 1.0
    local INTERVALLE_PING    = 1.0
    local INTERVALLE_ETAT    = 0.1

    local Stats = game:GetService("Stats")

    local flingEnCours = false
    local jeton = 0

    local function notifier(message, couleur)
        if notifierInterface then
            pcall(notifierInterface, message, couleur, "fling_" .. tostring(os.clock()))
        end
    end

    local function centreCarte()
        for _, nom in ipairs({"Map", "map", "Baseplate", "baseplate"}) do
            local objet = workspace:FindFirstChild(nom)
            if objet then
                if objet:IsA("BasePart") then
                    return objet.Position
                elseif objet:IsA("Model") then
                    local ok, cf = pcall(function() return objet:GetBoundingBox() end)
                    if ok and cf then return cf.Position end
                end
            end
        end

        local somme, n = Vector3.zero, 0
        for _, p in ipairs(Players:GetPlayers()) do
            local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if r and r:IsA("BasePart") then
                somme = somme + r.Position
                n = n + 1
            end
        end
        if n > 0 then return somme / n end
        return Vector3.zero
    end

    local function lirePing()
        local ms
        pcall(function()
            ms = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if type(ms) ~= "number" then return 0.08 end
        return math.clamp(ms, 0, 600) / 1000
    end

    local function directionImpact(posCible, posLocale, centre)
        local ext = posCible - centre
        ext = Vector3.new(ext.X, 0, ext.Z)

        local direction
        if ext.Magnitude > 1 then
            direction = ext.Unit
        else
            local ecart = posCible - posLocale
            ecart = Vector3.new(ecart.X, 0, ecart.Z)
            direction = ecart.Magnitude > 0.5 and ecart.Unit or Vector3.new(0, 0, -1)
        end

        return (direction + Vector3.yAxis * 0.7).Unit
    end

    local function capturerEtat(personnage, r, h)
        local etat = {
            personnage = personnage,
            racine = r,
            humanoide = h,

            cframe = r.CFrame,
            velocite = r.AssemblyLinearVelocity,
            angulaire = r.AssemblyAngularVelocity,

            ancre = r.Anchored,
            collision = r.CanCollide,
            massless = r.Massless,
            taille = r.Size,
            forme = r.Shape,
            physique = r.CustomPhysicalProperties,
            transparence = r.Transparency,
            transparenceLocale = r.LocalTransparencyModifier,

            parties = {},

            plateforme = h.PlatformStand,
            autoRotate = h.AutoRotate,
            walkSpeed = h.WalkSpeed,
            jumpPower = h.JumpPower,
            jumpHeight = h.JumpHeight,
            useJumpPower = h.UseJumpPower,
            sit = h.Sit,
            hipHeight = h.HipHeight,
            etatHumanoide = h:GetState(),
            etats = {},
        }

        for _, e in ipairs({
            Enum.HumanoidStateType.FallingDown,
            Enum.HumanoidStateType.Ragdoll,
            Enum.HumanoidStateType.Physics,
            Enum.HumanoidStateType.GettingUp,
            Enum.HumanoidStateType.Running,
            Enum.HumanoidStateType.Jumping,
            Enum.HumanoidStateType.Freefall,
        }) do
            local ok, v = pcall(function() return h:GetStateEnabled(e) end)
            if ok then etat.etats[e] = v end
        end

        for _, p in ipairs(personnage:GetDescendants()) do
            if p:IsA("BasePart") then
                etat.parties[p] = {
                    collision = p.CanCollide,
                    massless = p.Massless,
                }
            end
        end

        return etat
    end

    local function restaurerEtat(etat)
        local r, h = etat.racine, etat.humanoide

        for p, s in pairs(etat.parties) do
            if p.Parent then
                pcall(function() p.CanCollide = s.collision end)
                pcall(function() p.Massless = s.massless end)
            end
        end

        for p in pairs(etat.parties) do
            if p.Parent then
                pcall(function()
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end

        if r and r.Parent then
            pcall(function() r.Anchored = etat.ancre end)
            pcall(function() r.Size = etat.taille end)
            pcall(function() r.Shape = etat.forme end)
            pcall(function() r.CanCollide = etat.collision end)
            pcall(function() r.Massless = etat.massless end)
            pcall(function()
                if etat.physique then
                    r.CustomPhysicalProperties = etat.physique
                else
                    r.CustomPhysicalProperties = nil
                end
            end)
            pcall(function() r.Transparency = etat.transparence end)
            pcall(function() r.LocalTransparencyModifier = etat.transparenceLocale end)
            pcall(function() r.CFrame = etat.cframe end)
            pcall(function() r.AssemblyLinearVelocity = etat.velocite end)
            pcall(function() r.AssemblyAngularVelocity = etat.angulaire end)
        end

        if h and h.Parent then
            pcall(function() h.PlatformStand = etat.plateforme end)
            pcall(function() h.AutoRotate = etat.autoRotate end)
            pcall(function() h.WalkSpeed = etat.walkSpeed end)
            pcall(function() h.JumpPower = etat.jumpPower end)
            pcall(function() h.JumpHeight = etat.jumpHeight end)
            pcall(function() h.UseJumpPower = etat.useJumpPower end)
            pcall(function() h.Sit = etat.sit end)
            pcall(function() h.HipHeight = etat.hipHeight end)

            for e, v in pairs(etat.etats) do
                pcall(function() h:SetStateEnabled(e, v) end)
            end

            if h.Health > 0 then
                local voulu = etat.etatHumanoide
                if not voulu or voulu == Enum.HumanoidStateType.Dead then
                    voulu = Enum.HumanoidStateType.GettingUp
                end
                pcall(function() h:ChangeState(voulu) end)
            end
        end
    end

    local function preparerImpact(personnage, r, h)
        pcall(function()
            r.Anchored = false
            r.Massless = false
            r.CanCollide = true
            r.Size = TAILLE_IMPACT
            r.Transparency = 1
            r.LocalTransparencyModifier = 1
            r.CustomPhysicalProperties = PhysicalProperties.new(DENSITE_IMPACT, 0, 0, 1, 1)
        end)

        pcall(function()
            if r:IsA("Part") then
                r.Shape = Enum.PartType.Ball
            end
        end)

        for _, p in ipairs(personnage:GetDescendants()) do
            if p:IsA("BasePart") and p ~= r then
                pcall(function()
                    p.CanCollide = false
                    p.Massless = true
                end)
            end
        end

        pcall(function()
            h.PlatformStand = true
            h.AutoRotate = false
            h.Sit = false
            h.WalkSpeed = 0
            h.JumpPower = 0
            h.JumpHeight = 0
            h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            h:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
            h:ChangeState(Enum.HumanoidStateType.Physics)
        end)
    end

    flingVers = function(cible)
        if fermee then return end
        if flingEnCours then
            notifier("Un fling est déjà en cours", COL.ORANGE)
            return
        end
        if not cible or cible.Parent ~= Players then return end
        if cible == joueur then
            notifier("Impossible de te fling toi-même", COL.ORANGE)
            return
        end

        local persoCible = cible.Character
        local rpCible = persoCible and persoCible:FindFirstChild("HumanoidRootPart")
        local humCible = persoCible and persoCible:FindFirstChildOfClass("Humanoid")
        if not rpCible or not rpCible:IsA("BasePart")
            or not rpCible:IsDescendantOf(workspace)
            or not humCible or humCible.Health <= 0 then
            notifier("Cible introuvable", COL.ROUGE)
            return
        end
        if not racine or not racine.Parent or not racine:IsDescendantOf(workspace)
            or not humanoide or humanoide.Health <= 0 then
            notifier("Ton personnage n'est pas prêt", COL.ROUGE)
            return
        end

        flingEnCours = true
        jeton = jeton + 1
        local monJeton = jeton
        flingActif = true

        local flyEtait = flyControl and flyControl.flyOn == true
        local noclipEtait = flyControl and flyControl.noclipOn == true
        local antiFlingEtait = actif == true

        local racineDepart = racine
        local humanoideDepart = humanoide
        local personnage = racineDepart and racineDepart.Parent
        local etat = nil
        local ancienFPDH = workspace.FallenPartsDestroyHeight
        local connA, connB = nil, nil
        local fini = false

        local contactAt, positionContact = nil, nil
        local envoiDetecte, tEnvoi = false, nil
        local debut = os.clock()
        local prochainPing = 0
        local prochainEtat = 0
        local ping = 0.08
        local angleX, angleY, angleZ = 0, 0, 0
        local centre = Vector3.zero
        local historique = {}

        local function terminer(message, couleur)
            if fini then return end
            fini = true

            if connA then connA:Disconnect(); connA = nil end
            if connB then connB:Disconnect(); connB = nil end

            if etat then pcall(restaurerEtat, etat) end
            pcall(function() workspace.FallenPartsDestroyHeight = ancienFPDH end)

            if monJeton == jeton then

                flingEnCours = false
                flingActif = false

                if antiFlingEtait then pcall(definirActif, true) end
                if flyEtait then pcall(flyControl.activerFly, true) end
                if noclipEtait then pcall(flyControl.activerNoclip, true) end
            end

            notifier(message, couleur)
        end

        local okPreparation, errPreparation = pcall(function()

            if noclipEtait then flyControl.activerNoclip(false) end
            if flyEtait then flyControl.activerFly(false) end
            if antiFlingEtait then definirActif(false) end

            racineDepart, humanoideDepart = racine, humanoide
            personnage = racineDepart and racineDepart.Parent
            if not racineDepart or not racineDepart.Parent or not humanoideDepart then
                error("personnage indisponible")
            end

            etat = capturerEtat(personnage, racineDepart, humanoideDepart)
            centre = centreCarte()
            ping = lirePing()

            workspace.FallenPartsDestroyHeight = -1e9

            preparerImpact(personnage, racineDepart, humanoideDepart)

            local directionInitiale = directionImpact(rpCible.Position, racineDepart.Position, centre)
            racineDepart.CFrame = CFrame.new(
                rpCible.Position
                + Vector3.new(0, HAUTEUR_CONTACT, 0)
                - directionInitiale * DECALAGE_ARRIERE
            )
            racineDepart.AssemblyLinearVelocity = directionInitiale * VITESSE_IMPACT
            racineDepart.AssemblyAngularVelocity = Vector3.zero
        end)

        if not okPreparation then
            return terminer("Fling impossible : " .. tostring(errPreparation), COL.ROUGE)
        end

        local function vitesseCible(rp, tNow)
            local pos = rp.Position
            local dernier = historique[#historique]
            if not dernier or tNow - dernier.t >= 0.01 then
                historique[#historique + 1] = { t = tNow, p = pos }
            end
            while #historique > 1 and tNow - historique[1].t > 0.20 do
                table.remove(historique, 1)
            end

            local v = Vector3.zero
            local premier = historique[1]
            local dt = tNow - premier.t
            if dt > 0.04 then
                v = (pos - premier.p) / dt
            end

            local rapportee = rp.AssemblyLinearVelocity
            if rapportee.Magnitude > v.Magnitude and rapportee.Magnitude < 250 then
                v = rapportee
            end
            return v
        end

        local function etape()
            if fini then return end
            if monJeton ~= jeton then
                return terminer("Fling remplacé", COL.ORANGE)
            end
            if fermee then
                return terminer("Fling arrêté", COL.ORANGE)
            end
            if racine ~= racineDepart or not racineDepart.Parent then
                return terminer("Fling arrêté : personnage changé", COL.ORANGE)
            end
            if not humanoideDepart or not humanoideDepart.Parent or humanoideDepart.Health <= 0 then
                return terminer("Fling arrêté : tu es mort", COL.ORANGE)
            end

            if actif then pcall(definirActif, false) end

            if cible.Character ~= persoCible then
                return terminer("Cible perdue", COL.ROUGE)
            end

            local rp = persoCible:FindFirstChild("HumanoidRootPart")
            local hum = persoCible:FindFirstChildOfClass("Humanoid")
            if not rp or not rp:IsA("BasePart")
                or not rp:IsDescendantOf(workspace)
                or not hum or hum.Health <= 0 then
                if contactAt then
                    return terminer("Cible éjectée", COL.VERT)
                end
                return terminer("Cible perdue", COL.ROUGE)
            end

            local tNow = os.clock()
            local t = tNow - debut

            if tNow >= prochainPing then
                prochainPing = tNow + INTERVALLE_PING
                ping = lirePing()
            end

            local posCible = rp.Position
            local vCible = vitesseCible(rp, tNow)
            local vH = Vector3.new(vCible.X, 0, vCible.Z)
            local vitesseH = vH.Magnitude

            if not contactAt then
                local distance = (racineDepart.Position - posCible).Magnitude
                if distance <= DISTANCE_CONTACT then
                    contactAt = tNow
                    positionContact = posCible
                end
            end

            if contactAt and not envoiDetecte then
                local vitesse = rp.AssemblyLinearVelocity
                local etatCible = hum:GetState()
                local deplacement = positionContact and (posCible - positionContact).Magnitude or 0

                local projete =
                    vitesse.Magnitude > VITESSE_ENVOI
                    or vCible.Magnitude > VITESSE_ENVOI
                    or math.abs(vitesse.Y) > VITESSE_VERTICALE
                    or math.abs(vCible.Y) > VITESSE_VERTICALE
                    or ((etatCible == Enum.HumanoidStateType.FallingDown
                        or etatCible == Enum.HumanoidStateType.Ragdoll
                        or etatCible == Enum.HumanoidStateType.Physics)
                        and (vitesse.Magnitude > VITESSE_RAGDOLL
                            or vCible.Magnitude > VITESSE_RAGDOLL
                            or deplacement > 8))
                    or posCible.Y < centre.Y - CHUTE_CARTE

                if projete then
                    envoiDetecte = true
                    tEnvoi = tNow
                end
            end

            if posCible.Y < centre.Y - CHUTE_CARTE then
                return terminer("Cible projetée", COL.VERT)
            end

            if contactAt and not envoiDetecte and tNow - contactAt > 2.0 then
                local deplacement = positionContact and (posCible - positionContact).Magnitude or 0
                if deplacement < 2 and rp.AssemblyLinearVelocity.Magnitude < 10 then
                    return terminer("Cible protégée (anti-fling)", COL.ORANGE)
                end
            end

            if envoiDetecte and tNow - tEnvoi >= DUREE_APRES_ENVOI then
                return terminer("Cible projetée", COL.VERT)
            end

            if t >= DUREE_MAX then
                if envoiDetecte then
                    return terminer("Cible projetée", COL.VERT)
                end
                if contactAt then
                    return terminer("Fling terminé : cible non projetée", COL.ORANGE)
                end
                return terminer("Fling terminé : aucun contact", COL.MUET)
            end

            local lead = Vector3.zero
            if vitesseH > 1 then
                local horizon = math.clamp(ping * 0.5 + MARGE_ANTICIPATION, HORIZON_MIN, HORIZON_MAX)
                lead = vH * horizon
                if lead.Magnitude > LEAD_MAX then
                    lead = lead.Unit * LEAD_MAX
                end
            end

            local leadY = math.clamp(vCible.Y * 0.08, -3, 3)
            lead = lead + Vector3.new(0, leadY, 0)
            if lead.Magnitude > PORTEE_VERROU then
                lead = lead.Unit * PORTEE_VERROU
            end

            local direction = directionImpact(posCible, racineDepart.Position, centre)

            local positionBase = posCible + lead
                + Vector3.new(0, HAUTEUR_CONTACT, 0)
                - direction * DECALAGE_ARRIERE

            if vitesseH > 4 then
                local lateral = Vector3.new(-vH.Z, 0, vH.X) / vitesseH
                positionBase = positionBase + lateral * (math.sin(tNow * 25) * 0.6)
            end

            angleX = (angleX + 137) % 360
            angleY = (angleY + 191) % 360
            angleZ = (angleZ + 239) % 360
            local rotation = CFrame.Angles(math.rad(angleX), math.rad(angleY), math.rad(angleZ))
            local cframeImpact = CFrame.new(positionBase) * rotation

            if tNow >= prochainEtat then
                prochainEtat = tNow + INTERVALLE_ETAT
                pcall(function()
                    if racineDepart.Anchored then racineDepart.Anchored = false end
                    if not racineDepart.CanCollide then racineDepart.CanCollide = true end
                    if racineDepart.Massless then racineDepart.Massless = false end
                    if racineDepart.Size ~= TAILLE_IMPACT then racineDepart.Size = TAILLE_IMPACT end
                    if racineDepart:IsA("Part") and racineDepart.Shape ~= Enum.PartType.Ball then
                        racineDepart.Shape = Enum.PartType.Ball
                    end
                    if racineDepart.Transparency ~= 1 then racineDepart.Transparency = 1 end
                    if racineDepart.LocalTransparencyModifier ~= 1 then
                        racineDepart.LocalTransparencyModifier = 1
                    end
                    local props = racineDepart.CustomPhysicalProperties
                    if not props or math.abs(props.Density - DENSITE_IMPACT) > 0.01 then
                        racineDepart.CustomPhysicalProperties =
                            PhysicalProperties.new(DENSITE_IMPACT, 0, 0, 1, 1)
                    end

                    if not humanoideDepart.PlatformStand then humanoideDepart.PlatformStand = true end
                    if humanoideDepart.AutoRotate then humanoideDepart.AutoRotate = false end
                    if humanoideDepart.Sit then humanoideDepart.Sit = false end
                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    humanoideDepart:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
                    if humanoideDepart:GetState() ~= Enum.HumanoidStateType.Physics then
                        humanoideDepart:ChangeState(Enum.HumanoidStateType.Physics)
                    end
                end)
            end

            local intensite = VITESSE_IMPACT
            if contactAt and not envoiDetecte then
                intensite = math.min(
                    VITESSE_IMPACT_MAX,
                    VITESSE_IMPACT + math.max(0, tNow - contactAt) * 300
                )
            end

            pcall(function()
                racineDepart.CFrame = cframeImpact
                racineDepart.AssemblyLinearVelocity = direction * intensite

                racineDepart.AssemblyAngularVelocity = Vector3.zero
            end)
        end

        local function protege()
            if fini then return end
            local ok, err = pcall(etape)
            if not ok and not fini then
                pcall(terminer, "Fling arrêté (erreur)", COL.ROUGE)
                warn("[FLING] " .. tostring(err))
                if DIAG and DIAG.consigner then
                    pcall(DIAG.consigner, "FLING : " .. tostring(err))
                end
            end
        end

        local okConnexion, errConnexion = pcall(function()
            -- Une seule mise à jour physique par frame : évite le double traitement.
            connA = connecter(RunService.Heartbeat, protege)
        end)
        if not okConnexion then
            return terminer("Fling impossible : " .. tostring(errConnexion), COL.ROUGE)
        end

        notifier("FLING sur " .. cible.DisplayName, COL.ROUGE)
    end
end

