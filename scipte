-- Coupe uniquement le son de mort Roblox du personnage local ("uuh/ouh").
-- Cela ne corrige pas les resets : cela empêche simplement d'entendre ce son.
local connexionsSilenceMort = {}
local function couperSonMort(objet)
    if not objet or not objet:IsA("Sound") then return end
    local nom = string.lower(objet.Name or "")
    local id = string.lower(objet.SoundId or "")
    if nom == "died" or nom == "death" or string.find(id, "uuh", 1, true) then
        pcall(function()
            objet.Volume = 0
            objet:Stop()
        end)
    end
end
local function appliquerSilenceMort(personnage)
    if not personnage then return end
    for _, objet in ipairs(personnage:GetDescendants()) do
        couperSonMort(objet)
    end
    local connexion = connecter(personnage.DescendantAdded, couperSonMort)
    table.insert(connexionsSilenceMort, connexion)
end
if joueur.Character then appliquerSilenceMort(joueur.Character) end
connecter(joueur.CharacterAdded, appliquerSilenceMort)


