	local function verrouPeutChanger(nomVerrou)
		if not nomVerrou then return true end
		local joueurVerrou = Players:FindFirstChild(nomVerrou)
		if not joueurVerrou or joueursElimines[nomVerrou] then return true end
		local perso = joueurVerrou.Character
		local hum = perso and perso:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return true end
		local dansLobby = flyControl.Z and flyControl.Z.dansLobby
		if dansLobby and dansLobby(perso) then return true end
		return false
	end

	local function traiterRoles(res)

						if mancheTerminee then
							mancheTerminee = false
							nouvelleMancheAnnoncee = true
							generationManche = generationManche + 1
						end
						dernierRoleServeur = os.clock()

						-- Nouveau Murder annoncé alors que l'ancien n'est plus en partie : nouvelle manche.
						local murderAnnonce = nil
						for nom, role in pairs(res) do
							if role == "murder" then murderAnnonce = tostring(nom) break end
						end
						if murderAnnonce and verrouRoles.murder and murderAnnonce ~= verrouRoles.murder
							and verrouPeutChanger(verrouRoles.murder) then
							table.clear(rolesServeur)
							table.clear(joueursElimines)
							verrouRoles.murder, verrouRoles.sherif = nil, nil
							nouvelleMancheAnnoncee = true
							generationManche = generationManche + 1
						end

						local nouvelleDistribution = false
						for nom, role in pairs(res) do
							if role ~= "innocent" and joueursElimines[tostring(nom)]
								and (verrouRoles.murder == nil or joueursElimines[verrouRoles.murder]
									or Players:FindFirstChild(verrouRoles.murder) == nil) then
								nouvelleDistribution = true
								break
							end
						end
						if nouvelleDistribution and not mancheTerminee then
							table.clear(joueursElimines)
							table.clear(rolesServeur)
							verrouRoles.murder, verrouRoles.sherif = nil, nil
							nouvelleMancheAnnoncee = true
							generationManche = generationManche + 1
						end

						for nom, role in pairs(res) do

                            local nomOriginal = tostring(nom)
                            local joueurCorrespondant = nil
                            local correspondancesDisplay = 0
                            for _, pActuel in ipairs(Players:GetPlayers()) do
                                if tostring(pActuel.UserId) == nomOriginal or pActuel.Name == nomOriginal then
                                    joueurCorrespondant = pActuel
                                    correspondancesDisplay = 1
                                    break
                                elseif pActuel.DisplayName == nomOriginal then
                                    joueurCorrespondant = pActuel
                                    correspondancesDisplay = correspondancesDisplay + 1
                                end
                            end
                            if correspondancesDisplay == 1 and joueurCorrespondant then
                                nom = joueurCorrespondant.Name
                            elseif correspondancesDisplay > 1 then
                                nom = nil
                            end
							if nom and role ~= "innocent" then flyControl.tRoleRecu[nom] = os.clock() end
							if nom and not joueursElimines[nom] then
								if role == "murder" or role == "sherif" then
									-- Rôle donné en début de manche : verrouillé jusqu'à la fin de la manche.
									local ancien = verrouRoles[role]
									if ancien and ancien ~= nom and not verrouPeutChanger(ancien) then
										-- ignoré : le rôle de cette manche est déjà attribué
									else
										if ancien and ancien ~= nom then rolesServeur[ancien] = nil end
										verrouRoles[role] = nom
										rolesServeur[nom] = role
									end
								else
									local actuel = rolesServeur[nom]
									if actuel ~= "murder" and actuel ~= "sherif" then rolesServeur[nom] = role end
								end
							end
							if nom and role == "murder" and rolesServeur[nom] == "murder" then suiviManche.murderNom = nom end
						end
						local moi = res[joueur.Name]
                        if not moi then
                            for cle, role in pairs(res) do
                                if tostring(cle) == tostring(joueur.UserId) or tostring(cle) == joueur.DisplayName then
                                    moi = role
                                    break
                                end
                            end
                        end
						if moi then
							suiviManche.participe = true
							if moi == "murder" or moi == "sherif" then
								suiviManche.role = moi
							elseif not suiviManche.role then
								suiviManche.role = moi
							end
						end
						if calculerRoles then calculerRoles() end
						if flyControl.majVisuelsMaintenant then flyControl.majVisuelsMaintenant() end
	end

	local function brancher(o)
		if not o:IsA("RemoteEvent") then return end
		local nomEvt = string.lower(o.Name)
		local finManche = string.find(nomEvt, "roundend", 1, true) or string.find(nomEvt, "endround", 1, true)
			or string.find(nomEvt, "winner", 1, true) or string.find(nomEvt, "gameover", 1, true)

		local pieceRemote = (string.find(nomEvt, "coin", 1, true) or string.find(nomEvt, "candy", 1, true))
			and string.find(nomEvt, "collect", 1, true)
		pcall(function()
			connecter(o.OnClientEvent, function(...)
				if fermee then return end
				if pieceRemote then
					remoteCoinVu = true

					local courant = nil
					for i = 1, select("#", ...) do
						local a = select(i, ...)
						if type(a) == "number" then courant = a break end
					end
					local gain = 1
					if courant then
						if courant > dernierSacPieces then
							gain = courant - dernierSacPieces
						elseif courant < dernierSacPieces then
							gain = courant
						else
							gain = 0
						end
						dernierSacPieces = courant
						if gain > 10 then gain = 1 end
					end
					ajouterPiecesStats(gain)
					return
				end
				if finManche then

					if latchFinManche and os.clock() - tFinManche < 10 then return end
                    statsMM2.manches = statsMM2.manches + 1

                    local roleGagnant = nil
                    for i = 1, select("#", ...) do
                        local arg = select(i, ...)
                        if type(arg) == "string" then
                            local txt = string.lower(arg)
                            if string.find(txt, "murder", 1, true) then roleGagnant = "murder"
                            elseif string.find(txt, "sheriff", 1, true) or string.find(txt, "sherif", 1, true) then roleGagnant = "sherif"
                            elseif string.find(txt, "innocent", 1, true) or string.find(txt, "hero", 1, true) then roleGagnant = "innocent" end
                        elseif type(arg) == "table" then
                            local txt = string.lower(tostring(arg.Winner or arg.winner or arg.WinningRole or arg.winningRole or ""))
                            if string.find(txt, "murder", 1, true) then roleGagnant = "murder"
                            elseif string.find(txt, "sheriff", 1, true) or string.find(txt, "sherif", 1, true) then roleGagnant = "sherif"
                            elseif string.find(txt, "innocent", 1, true) or string.find(txt, "hero", 1, true) then roleGagnant = "innocent" end
                        end
                    end

                    enregistrerFinManche(roleGagnant)
					mancheTerminee = true
					latchFinManche, tFinManche = true, os.clock()
					finMancheEnAttente = true

					task.delay(0.25, function()
						if restaurerPositionFinManche then restaurerPositionFinManche() end
					end)
					table.clear(rolesServeur)
					verrouRoles.murder, verrouRoles.sherif = nil, nil
					table.clear(joueursElimines)
					-- Fin de manche : aucun chams (zombie ou classique) ne doit rester affiché,
					-- et la détection de mode est remise à zéro pour la manche suivante.
					if flyControl.Z then
						flyControl.Z.infectionGen = nil
						flyControl.Z.classiqueGen = nil
						flyControl.Z.modeCouteau = false
						for p in pairs(flyControl.Z.halos) do pcall(flyControl.Z.retirer, p) end
					end
					for _, p in ipairs(Players:GetPlayers()) do
						rolesParJoueur[p] = "innocent"
						local h = halos[p]
						if h and h.Parent then
							h.FillColor = COL.COULEUR_INNOCENT
							h.OutlineColor = COL.COULEUR_INNOCENT:Lerp(Color3.new(1, 1, 1), 0.3)
						end
						local b = boites[p]
						if b and b.Parent then b.Color3 = COL.COULEUR_INNOCENT end
					end
					return
				end
				for i = 1, select("#", ...) do
					local res = lireTable((select(i, ...)))
					if res then traiterRoles(res) end
				end
			end)
		end)
	end
	lancerTache(function()
		local remotes = RS:WaitForChild("Remotes", 15)
		if not remotes then return end
		for _, o in ipairs(remotes:GetDescendants()) do brancher(o) end
		connecter(remotes.DescendantAdded, brancher)
	end)
	-- Lecture active des rôles : au lancement du script (même en pleine manche) puis
	-- régulièrement tant que le Murder ou le Sheriff n'est pas connu. Le serveur
	-- n'envoie les rôles qu'en début de manche ou à chaque mort : sans ça, rien ne
	-- s'affiche tant que personne ne meurt.
	lancerTache(function()
		local fonction, derniereRecherche, avertit = nil, 0, false
		while not fermee do
			local murderConnu, sherifConnu = false, false
			for _, r in pairs(rolesServeur) do
				if r == "murder" then murderConnu = true elseif r == "sherif" then sherifConnu = true end
			end
			if not mancheTerminee and not (murderConnu and sherifConnu) then
				if not fonction or not fonction.Parent then
					fonction = nil
					if os.clock() - derniereRecherche > 3 then
						derniereRecherche = os.clock()
						local direct = RS:FindFirstChild("GetPlayerData", true)
						if direct and direct:IsA("RemoteFunction") then
							fonction = direct
						else
							for _, o in ipairs(RS:GetDescendants()) do
								if o:IsA("RemoteFunction") and string.lower(o.Name) == "getplayerdata" then
									fonction = o
									break
								end
							end
						end
						if not fonction and not avertit then
							avertit = true
							warn("[Les Ténèbres] GetPlayerData introuvable : lecture active des rôles indisponible")
						end
					end
				end
				local res = nil
				if fonction then
					local ok, donnees = pcall(function() return fonction:InvokeServer() end)
					if ok and type(donnees) == "table" then res = lireTable(donnees) end
				else
					-- Secours : le Murder est le joueur qui tient réellement son couteau en main.
					for _, p in ipairs(Players:GetPlayers()) do
						local perso = p.Character
						local outil = perso and perso:FindFirstChild("Knife")
						if outil and outil:IsA("Tool") then
							res = res or {}
							res[p.Name] = "murder"
							break
						end
					end
				end
				if res and not fermee and not mancheTerminee then
					-- On ignore les joueurs encore au lobby (anciennes données d'une manche passée).
					local dansLobby = flyControl.Z and flyControl.Z.dansLobby
					if dansLobby then
						for nom in pairs(res) do
							local p = Players:FindFirstChild(tostring(nom))
							if p and p.Character and dansLobby(p.Character) then res[nom] = nil end
						end
					end
					if next(res) ~= nil then traiterRoles(res) end
				end
			end
			task.wait(2)
		end
	end)
end
local infoManche, infoMurder, infoSherif, infoHeros, infoArme = "Aucune", "—", "—", "—", "Non"
local couleurRole, retirerBoite, retirerHalo, retirerEtiquette, retirerArme, nettoyerChams
flyControl.Z = { actif = false, halos = {} }
-- Recherche de GunDrop mise en cache : la recherche récursive dans tout le workspace
-- (très coûteuse en partie) n'a lieu qu'une fois, puis les événements alimentent le cache.
do
	local cache, derniereRecherche = nil, -1000
	flyControl.trouverGunDrop = function()
		if cache and cache.Parent then return cache end
		cache = nil
		-- Recherche directe (instantanée) d'abord ; la recherche récursive de tout le
		-- workspace (gel de plusieurs ms) est espacée, les événements alimentent déjà le cache.
		local direct = workspace:FindFirstChild("GunDrop")
		if direct then
			cache = direct
			return cache
		end
		local t = os.clock()
		if t - derniereRecherche < 30 then return nil end
		derniereRecherche = t
		cache = workspace:FindFirstChild("GunDrop", true)
		return cache
	end
	connecter(workspace.DescendantAdded, function(o)
		if o.Name == "GunDrop" then
			cache = o
			derniereRecherche = os.clock()
		end
	end)
end
do
local haloArme, boiteArme, etiquetteArme = nil, nil, nil
local auraAttachement, fumeeArme, lumiereArme = nil, nil, nil
