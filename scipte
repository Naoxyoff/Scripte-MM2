local spinOn, spinVitesse = false, valeurConfig("spinVitesse", 10)
local arcOn, traineeOn, discoOn = false, false, false
local arcHalo = nil
local retirerTrainee, activerDisco
do
local discoOriginal = nil
local trainee, att0, att1 = nil, nil, nil
function retirerTrainee()
	if trainee then trainee:Destroy() trainee = nil end
	if att0 then att0:Destroy() att0 = nil end
	if att1 then att1:Destroy() att1 = nil end
end
local function creerTrainee()
	if not racine then return end
	retirerTrainee()
	att0 = Instance.new("Attachment")
	att0.Position = Vector3.new(0, 1, 0)
	att0.Parent = racine
	att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, -1, 0)
	att1.Parent = racine
	trainee = Instance.new("Trail")
	trainee.Attachment0 = att0
	trainee.Attachment1 = att1
	trainee.Lifetime = 0.8
	trainee.LightEmission = 1
	trainee.Transparency = NumberSequence.new(0.1, 1)
	trainee.Parent = racine
end
function activerDisco(v)
	discoOn = v
	if v then
		discoOriginal = { Lighting.Ambient, Lighting.OutdoorAmbient }
	elseif discoOriginal then
		pcall(function()
			Lighting.Ambient = discoOriginal[1]
			Lighting.OutdoorAmbient = discoOriginal[2]
		end)
		discoOriginal = nil
	end
end
connecter(RunService.RenderStepped, function(dt)
	if fermee or (not spinOn and not arcOn and not traineeOn and not discoOn) then return end
	local teinte, arc
	if arcOn or traineeOn or discoOn then
		teinte = (os.clock() * 0.4) % 1
		arc = Color3.fromHSV(teinte, 1, 1)
	end
	if spinOn and racine then
		racine.CFrame = racine.CFrame * CFrame.Angles(0, math.rad(spinVitesse * 72 * dt), 0)
	end
	if arcOn and joueur.Character then
		if not arcHalo or not arcHalo.Parent then
			arcHalo = Instance.new("Highlight")
			arcHalo.Name = "MoiArc"
			arcHalo.FillTransparency = 0.55
			arcHalo.OutlineTransparency = 0
			arcHalo.Adornee = joueur.Character
			arcHalo.Parent = joueur.Character
		end
		arcHalo.FillColor = arc
		arcHalo.OutlineColor = arc
	elseif arcHalo then
		arcHalo:Destroy()
		arcHalo = nil
	end
	if traineeOn then
		if not trainee or not trainee.Parent then creerTrainee() end
		if trainee then
			trainee.Color = ColorSequence.new(arc, Color3.fromHSV((teinte + 0.3) % 1, 1, 1))
		end
	elseif trainee then
		retirerTrainee()
	end
	if discoOn and arc then
		if Lighting.Ambient ~= arc then Lighting.Ambient = arc end
		if Lighting.OutdoorAmbient ~= arc then Lighting.OutdoorAmbient = arc end
	end
end)
end
