		Size = UDim2.new(1, 0, 0, hauteur), BackgroundColor3 = Color3.fromRGB(16, 16, 16), BorderSizePixel = 0,
		LayoutOrder = ordre(page), ClipsDescendants = false,
	}, page)
	coins(c, 16)
	-- Fond uni et bordure fixe : le dégradé et l'animation au survol faisaient
	-- clignoter les cartes sous BlueStacks (le survol se déclenche en boucle au défilement).
	c.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
	creer("UIStroke", { Thickness = 1, Color = Color3.fromRGB(80, 38, 44), Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, c)
	creer("Frame", { Name = "AccentCarte", Size = UDim2.new(0, 3, 1, -30), Position = UDim2.fromOffset(0, 15), BackgroundColor3 = COL.ROUGE, BorderSizePixel = 0 }, c)
	return c
end
local function creerInterrupteurDans(c, x, y, defaut, rappel)
	local piste = creer("TextButton", {
		Size = UDim2.fromOffset(46, 24), Position = UDim2.new(1, x, 0, y),
		Text = "", AutoButtonColor = false, BackgroundColor3 = COL.GRIS,
	}, c)
	pilule(piste)
	local rond = creer("Frame", {
		Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = COL.BLANC, BorderSizePixel = 0,
	}, piste)
	pilule(rond)
	local etat = defaut
	local contourPiste = creer("UIStroke", {
		Thickness = 1, Color = Color3.fromRGB(90, 90, 96), Transparency = 0.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, piste)
	local accentCarte = c:FindFirstChild("AccentCarte")
	local function afficher()
		tw(piste, { BackgroundColor3 = etat and COL.ROUGE or Color3.fromRGB(46, 46, 50) }, 0.18)
		tw(contourPiste, {
			Color = etat and Color3.fromRGB(255, 90, 110) or Color3.fromRGB(90, 90, 96),
			Transparency = etat and 0.25 or 0.5,
		}, 0.18)
		tw(rond, {
			Position = UDim2.fromOffset(etat and 25 or 3, 3),
			BackgroundColor3 = etat and COL.BLANC or Color3.fromRGB(190, 190, 195),
		}, 0.22, Enum.EasingStyle.Back)
		if accentCarte then
			tw(accentCarte, { BackgroundColor3 = etat and Color3.fromRGB(255, 30, 60) or Color3.fromRGB(62, 46, 50) }, 0.18)
		end
	end
	connecter(piste.Activated, function()
		etat = not etat
		afficher()
		rappel(etat)
	end)
	afficher()
	return {
		get = function() return etat end,
		set = function(valeur)
			if etat == valeur then return end
			etat = valeur
			afficher()
			rappel(etat)
		end,
	}
end
