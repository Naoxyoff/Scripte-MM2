local ServiceContenu = game:GetService("ContentProvider")

-- Charge l'animation dans un fil séparé avec un délai maximum : LoadAnimation peut rester
-- bloqué indéfiniment sur un asset inaccessible.
local function chargerAvecDelai(animator, anim, delai)
    local fini, ok, res = false, false, nil
    task.spawn(function()
        local o, r = pcall(function() return animator:LoadAnimation(anim) end)
        ok, res, fini = o, r, true
    end)
    local t0 = os.clock()
    while not fini and os.clock() - t0 < delai do task.wait(0.05) end
    if not fini then return false, "délai dépassé au chargement" end
    return ok, res
end

-- Demande à Roblox si l'asset est réellement accessible (Success / Failure).
local function statutAsset(anim, delai)
    local statut, fini = nil, false
    task.spawn(function()
        pcall(function()
            ServiceContenu:PreloadAsync({ anim }, function(_, st) statut = st end)
        end)
        fini = true
    end)
    local t0 = os.clock()
    while not fini and os.clock() - t0 < delai do task.wait(0.05) end
    return statut, fini
end

-- Les IDs du catalogue (emotes de type EmoteAnimation) ne sont pas des IDs d'animation :
-- on récupère l'objet Animation réel via GetObjects pour obtenir le bon AnimationId.
local function resoudreCatalogue(id, delai)
    local fini, resultat = false, nil
    task.spawn(function()
        local ok, objets = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if ok and type(objets) == "table" then
            for _, o in ipairs(objets) do
                local a = nil
                pcall(function()
                    a = o:IsA("Animation") and o or o:FindFirstChildWhichIsA("Animation", true)
                end)
                if a and a.AnimationId ~= "" then
                    resultat = a.AnimationId
                    break
                end
            end
        end
        fini = true
    end)
    local t0 = os.clock()
    while not fini and os.clock() - t0 < delai do task.wait(0.05) end
    return resultat
end

local function corpsEmote(emote, hum, monJeton)
    local estR6 = hum.RigType == Enum.HumanoidRigType.R6
    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    if monJeton ~= jetonEmote then return end

    local ids = { (estR6 and emote.idR6) or emote.id }
    for _, alt in ipairs(emote.alt or {}) do ids[#ids + 1] = alt end
    local raison = "inconnue"

    for _, id in ipairs(ids) do
        if monJeton ~= jetonEmote then return end
        local anim = Instance.new("Animation")
        anim.Name = "Tenebres_" .. emote.nom
        anim.AnimationId = "rbxassetid://" .. id

        local st, termine = statutAsset(anim, 6)
        if monJeton ~= jetonEmote then detruire(anim) return end
        if st == Enum.AssetFetchStatus.Failure or st == Enum.AssetFetchStatus.TimedOut then
            local reel = resoudreCatalogue(id, 8)
            if monJeton ~= jetonEmote then detruire(anim) return end
            if reel then
                anim.AnimationId = reel
                st, termine = statutAsset(anim, 6)
                if monJeton ~= jetonEmote then detruire(anim) return end
            end
        end
        if st == Enum.AssetFetchStatus.Failure or st == Enum.AssetFetchStatus.TimedOut then
            raison = "asset inaccessible (inexistant ou non autorisé) : " .. tostring(st)
            detruire(anim)
        elseif not termine then
            raison = "Roblox ne répond pas pour cet asset (délai dépassé)"
            detruire(anim)
        else
            local ok, track = chargerAvecDelai(animator, anim, 6)
            if monJeton ~= jetonEmote then detruire(anim) return end
            if not ok or not track then
                raison = "chargement refusé : " .. string.sub(tostring(track), 1, 70)
                detruire(anim)
            else
                local t0 = os.clock()
                while monJeton == jetonEmote and track.Length <= 0 and os.clock() - t0 < 4 do
                    task.wait(0.05)
                end
                if monJeton ~= jetonEmote then
                    detruire(track)
                    detruire(anim)
                    return
                end
                if track.Length <= 0 then
                    raison = "animation vide ou non autorisée"
                    detruire(track)
                    detruire(anim)
                else
                    track.Priority = Enum.AnimationPriority.Action
                    track.Looped = true
                    local lectureOK = pcall(function() track:Play(0.2, 1, 1) end)
                    if lectureOK then
                        task.wait(0.2)
                        if monJeton ~= jetonEmote then
                            pcall(function() track:Stop(0) end)
                            detruire(track)
                            detruire(anim)
                            return
                        end
                        if track.IsPlaying then
                            piste, animationCourante = track, anim
                            local txt = "Vérifiée à l'exécution (" .. (estR6 and "R6" or "R15") .. ")"
                            local douteux = estR6 and not emote.idR6
                            if douteux then txt = txt .. " · R6 : rendu non garanti" end
                            definirStatut(emote, txt, douteux and COL.ORANGE or COL.VERT)
                            noterEmote("Danse lancée : " .. emote.nom, COL.ORCHIDEE)
                            return
                        end
                        raison = "lecture impossible"
                    else
                        raison = "lecture refusée"
                    end
                    pcall(function() track:Stop(0) end)
                    detruire(track)
                    detruire(anim)
                end
            end
        end
    end

    if monJeton == jetonEmote then
        emoteCourante = nil
        definirStatut(emote, "Échec : " .. raison, COL.ROUGE)
        noterEmote(emote.nom .. " : " .. raison, COL.ROUGE)
    end
end

local function jouerEmote(emote)
    if fermee then return end
