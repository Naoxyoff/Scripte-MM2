            local rotation = CFrame.Angles(math.rad(angleX), math.rad(angleY), math.rad(angleZ))
            local cframeImpact = CFrame.new(positionBase) * rotation
            dernierOffset, dernierRot, dernierVCible = positionBase - posCible, rotation, vCible
            -- Caméra fixée sur la cible : plus de tremblement dû à la rotation de mon personnage.
            pcall(function()
