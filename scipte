local function resetAutoFarmSilencieux(h)
	if not h or not h.Parent or h.Health <= 0 then return end
	resetAutoSilencieuxActif = true
	local personnage = h.Parent
	local volumesOriginaux, connexionAjout, connexionMort = {}, nil, nil
	local termine = false
	local function neutraliser(objet)
		if not estSonMort(objet) then return end
		if volumesOriginaux[objet] == nil then volumesOriginaux[objet] = objet.Volume end
		pcall(function() objet.Volume = 0; objet:Stop() end)
	end
	local function nettoyer()
		if termine then return end
		termine = true
		if connexionAjout then deconnecter(connexionAjout); connexionAjout = nil end
		if connexionMort then deconnecter(connexionMort); connexionMort = nil end
		for son, volume in pairs(volumesOriginaux) do
			if son and son.Parent then pcall(function() son.Volume = volume end) end
		end
		resetAutoSilencieuxActif = false
	end
	for _, objet in ipairs(personnage:GetDescendants()) do neutraliser(objet) end
	connexionAjout = connecter(personnage.DescendantAdded, neutraliser)
	connexionMort = connecter(h.Died, function()
		for _, objet in ipairs(personnage:GetDescendants()) do neutraliser(objet) end
		task.delay(1.5, nettoyer)
	end)
	task.delay(5, nettoyer)
	pcall(function() h.Health = 0 end)
end
