	end
	if racine ~= r then racine, humanoide = r, h end
	if flingActif then
		if maintien then
			pcall(function() maintien:Destroy() end)
			maintien = nil
		end
		etatTexte = "Fling en cours"
		return
	end
	local t = os.clock()
	if generationManche ~= generationMancheVue then
		generationMancheVue = generationManche
		nouvelleManche()
	end
	if latchFinManche and dernierRoleServeur > tFinManche + 8 then
		latchFinManche = false
		nouvelleManche()
	end
	if t >= prochaineAnalyse then
        prochaineAnalyse = t + 0.1
		DIAG.mesure("analyse", analyser, r.Position)
	end
	if t >= prochainCompact then
		prochainCompact = t + 5
		compacterListe()
	end
	local auLobby = estAuLobby()
	if latchFinManche then
		if auLobby then
			vuLobbyApresFin = true
		elseif (vuLobbyApresFin and t - tFinManche > 8) or t - tFinManche > 120 then
			latchFinManche, vuLobbyApresFin = false, false
			nouvelleManche()
		end
	end
	if sacPlein and t >= prochainVerifSacPlein then
		prochainVerifSacPlein = t + 0.5
		local ui = sacPleinUI()
		if ui == false then
			sacPlein = false
			resetFaitManche = false
			resetEffectue = false
			echecs = 0
			etatResetSac.sacPlein = false
			etatResetSac.resetFait = false
			notif("Sac vidé : farm repris", VERT_ON)
		elseif ui == true and farmCfg.resetPlein and not resetEffectue and not flingSacEnCours
			and (t - (etatResetSac.dernierReset or 0)) > COOLDOWN_RESET then
			resetEffectue = true
			etatResetSac.resetFait = true
			etatResetSac.dernierReset = t
			dernierReset = t
			notif("Sac plein : reset", COL.ORANGE)
			resetAutoFarmSilencieux(h)
		end
	end
	-- L'etat elimine verrouille les roles, mais ne doit pas bloquer le farm apres un respawn.
	local mort = h.Health <= 0
	local horsManche = flyControl.arriveeManuelle == true
	local finMurder = false
	if infoMurder ~= "—" then
		murderVu, tMurderAbsent = true, nil
	elseif murderVu then
		tMurderAbsent = tMurderAbsent or t
		if t - tMurderAbsent >= DELAI_MURDER_ABSENT then finMurder = true end
	end
	for nom, role in pairs(rolesServeur) do
		if role == "murder" then murderNom = nom end
	end
	for pj, role in pairs(rolesParJoueur) do
		if role == "murder" then murderNom = pj.Name end
	end
	if murderNom then
		local pm = Players:FindFirstChild(murderNom)
		local hm = pm and pm.Character and pm.Character:FindFirstChildOfClass("Humanoid")
		if joueursElimines[murderNom] or not pm or (hm and hm.Health <= 0) then
			finMurder = true
		end
	end
	local finManche = finMurder or latchFinManche
	if restantes < restantesAvant then derniereRecolte = t end
	restantesAvant = restantes
	if enFarm and t - derniereRecolte > DELAI_SANS_RECOLTE then
		pauseStallJusqua = t + 25
		derniereRecolte = t
	end
	local engage = restantes > 0 and not auLobby and distanceMin <= RAYON_ENGAGE and not sacPlein and not mort and not horsManche
		and not finManche and t >= pauseStallJusqua
	local raisonFerme = sacPlein or mort or horsManche or auLobby or latchFinManche or t < pauseStallJusqua
	if engage then
		perduDepuis = nil
	elseif enFarm and not raisonFerme then
		perduDepuis = perduDepuis or t
		if t - perduDepuis < GRACE_PERTE then engage = true end
	end
	if not engage then
		perduDepuis = nil
		if enFarm then
			if t - dernierArretConsigne > 3 then
				dernierArretConsigne = t
				local raison = (sacPlein and "sac plein") or (mort and "éliminé") or (horsManche and "hors manche (téléporté)") or (auLobby and "lobby")
					or (latchFinManche and "fin de manche") or (t < pauseStallJusqua and "aucune pièce récoltée depuis 25 s")
					or (restantes == 0 and "plus de pièces") or (finManche and "murder absent")
					or "pièces trop loin"
				DIAG.consigner("Farm en pause : " .. raison)
			end
			quitterFarm()
		end
		if restantes == 0 then
			etatTexte = "En attente de la prochaine manche"
			if aFarme and not finTraitee then
				finTraitee = true
				actionFin()
			end
		elseif finManche then
			etatTexte = "Manche terminée : farm en pause jusqu'à la prochaine manche"
		elseif t < pauseStallJusqua then
			etatTexte = "Aucune pièce récoltable : pause avant nouvel essai"
		elseif mort then
			etatTexte = "Éliminé : collecte en pause jusqu'à la prochaine manche"
		elseif horsManche then
			etatTexte = "Hors manche (téléporté) : collecte en pause jusqu'à la prochaine manche"
		elseif sacPlein then
			etatTexte = "Sac plein"
		elseif auLobby then
			etatTexte = "Au lobby, en attente de la manche"
		else
			etatTexte = "Trop loin des pièces, en attente"
		end
		return
	end
	if not enFarm then
		entrerFarm(r, h)
		derniereRecolte = t
