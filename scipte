local DIAG = { suspect = "", tSuspect = 0, derniers = {}, msEvts = 0, nbEvts = 0 }
function DIAG.consigner(texte)
	table.insert(historiqueNotifications, 1, { message = texte, heure = os.date("%H:%M:%S") })
	while #historiqueNotifications > 12 do table.remove(historiqueNotifications) end
	if majHistoriqueNotifications then pcall(majHistoriqueNotifications) end
end
function DIAG.mesure(nom, f, ...)
	local t0 = os.clock()
	local args = table.pack(...)
	local ok, resultat = pcall(f, table.unpack(args, 1, args.n))
	local ms = (os.clock() - t0) * 1000
	DIAG.msEvts = DIAG.msEvts + ms
	DIAG.nbEvts = DIAG.nbEvts + 1
	local maintenant = os.clock()
	if not ok then
		DIAG.suspect, DIAG.tSuspect = nom, maintenant
		if not DIAG.derniers["erreur_" .. nom] or maintenant - DIAG.derniers["erreur_" .. nom] > 5 then
			DIAG.derniers["erreur_" .. nom] = maintenant
			local detail = tostring(resultat):gsub("[\r\n]+", " ")
			DIAG.consigner(string.format("Erreur %s : %s", nom, string.sub(detail, 1, 180)))
		end
	elseif ms > 12 then
		DIAG.suspect, DIAG.tSuspect = nom, maintenant
		if not DIAG.derniers[nom] or maintenant - DIAG.derniers[nom] > 5 then
			DIAG.derniers[nom] = maintenant
			DIAG.consigner(string.format("Lent : %s %d ms", nom, math.floor(ms + 0.5)))
		end
	end
	return ok, resultat
end
