local cibleRaycastSolCachee, prochainRaycastSol, viseeSolCachee = nil, 0, nil
local function pas(dt)
	if fermee or not armee then return end
	local perso = joueur.Character
	local h = perso and perso:FindFirstChildOfClass("Humanoid")
	local r = perso and perso:FindFirstChild("HumanoidRootPart")
	if not h or not r or not r.Parent or h.Health <= 0 then
		if enFarm then quitterFarm() end
