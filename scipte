local function majChamsZombie(p)
    if not flyControl.Z.actif or not modeZombie() then flyControl.Z.retirer(p); return end
    local perso = p.Character
    local hum = perso and perso:FindFirstChildOfClass("Humanoid")
    local rp = perso and perso:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not rp or (racine and (rp.Position-racine.Position).Magnitude > DISTANCE_MAX_CHAMS) then
        flyControl.Z.retirer(p); return
    end
    local estZombie = estZombieOuSurvivant(p)
    if estZombie == nil then flyControl.Z.retirer(p); return end
    local h = flyControl.Z.halos[p]
    if not h or not h.Parent or h.Adornee ~= perso then
        flyControl.Z.retirer(p)
