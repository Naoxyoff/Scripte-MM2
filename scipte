local rolesServeur = {}
do
	local RS = game:GetService("ReplicatedStorage")
	local function normaliser(v)
		if type(v) ~= "string" then return nil end
		local t = string.lower(v)
		if string.find(t, "murder", 1, true) then return "murder" end
		if string.find(t, "sher", 1, true) then return "sherif" end
		if string.find(t, "hero", 1, true) then return "heros" end
		if string.find(t, "innocent", 1, true) then return "innocent" end
		return nil
	end
	-- Cherche une table du type { [nomJoueur] = { Role = "Murderer", ... }, ... }
	local function lireTable(t)
		if type(t) ~= "table" then return nil end
		local res, trouve = {}, false
		for k, v in pairs(t) do
			if type(k) == "string" and type(v) == "table" then
				local r = normaliser(v.Role or v.role)
				if r then res[k] = r trouve = true end
			end
		end
		return trouve and res or nil
	end
	local function brancher(o)
		if not o:IsA("RemoteEvent") then return end
		local nomEvt = string.lower(o.Name)
		local finManche = string.find(nomEvt, "roundend", 1, true) or string.find(nomEvt, "endround", 1, true)
			or string.find(nomEvt, "winner", 1, true) or string.find(nomEvt, "gameover", 1, true)
		pcall(function()
			o.OnClientEvent:Connect(function(...)
				if fermee then return end
				if finManche then rolesServeur = {} return end
				for i = 1, select("#", ...) do
					local res = lireTable((select(i, ...)))
					if res then rolesServeur = res end
				end
			end)
		end)
	end
	task.spawn(function()
		local remotes = RS:WaitForChild("Remotes", 15)
		if not remotes then return end
		for _, o in ipairs(remotes:GetDescendants()) do brancher(o) end
		remotes.DescendantAdded:Connect(brancher)
	end)
end
