local function choisirCible(position, murderPos)
	local t = os.clock()
	local meilleure, meilleureD = nil, math.huge
	local meilleureDifferee, meilleureDiffereeD = nil, math.huge
	for i = 1, #piecesListe do
		local p = piecesListe[i]
		local finAbandon = abandonnees[p]
		local enDelai = finAbandon and finAbandon > t
		if recoltable(p) then
			local pp = p.Position
			if math.abs(pp.Y - referenceY) <= farmCfg.margeVerticale
				and not pieceDangereuse(pp, murderPos) then
				-- Pièce "volée" par un autre farmeur : choix de secours seulement (jamais exclue),
				-- sinon le farm reste immobile dès qu'un autre farmeur est à côté.
				local volee = pieceVolee(p, position)
				local d = (pp - position).Magnitude
				if enDelai then d = d + 12 end
				if enDelai or volee then
					if d < meilleureDiffereeD then meilleureDifferee, meilleureDiffereeD = p, d end
				elseif d < meilleureD then
					meilleure, meilleureD = p, d
				end
			end
		end
	end
	return meilleure or meilleureDifferee
end
