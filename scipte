function definirActif(valeur)
	actif = valeur == true
	if actif then

		for _, autre in ipairs(Players:GetPlayers()) do
			if autre ~= joueur and autre.Character then
				suivre(autre, autre.Character)
			end
		end
		derniereSure = racine and racine.CFrame or nil
		derniereMaj = os.clock()
	else
		restaurerCollisions()
	end
end

