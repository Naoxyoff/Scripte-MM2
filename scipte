local COULEUR_ZOMBIE = Color3.fromRGB(255, 0, 0)
local COULEUR_SURVIVANT = Color3.fromRGB(0, 255, 0)

local MOTS_ZOMBIE = { "zombie", "infect", "undead", "claw", "bite" }
local MOTS_SURVIVANT = { "uninfect", "surviv", "human", "innocent" }
local function contientMot(texte, liste)
    texte = string.lower(tostring(texte or ""))
    for _, mot in ipairs(liste) do
        if string.find(texte, mot, 1, true) then return true end
    end
    return false
end
local function estNomZombie(texte)
    return contientMot(texte, MOTS_ZOMBIE) and not contientMot(texte, MOTS_SURVIVANT)
end
local function attributZombie(objet)
    if not objet then return false end
    for nom, valeur in pairs(objet:GetAttributes()) do
        if estNomZombie(nom) and valeur == true then return true end
        if type(valeur) == "string" and estNomZombie(valeur) then return true end
    end
    return false
end
local function nomEquipeZombie(nom)
    nom = string.lower(tostring(nom or ""))
    if string.find(nom, "surviv", 1, true)
        or string.find(nom, "uninfect", 1, true)
        or string.find(nom, "human", 1, true) then
        return false
    end
    return estNomZombie(nom)
end
local function nomEquipeSurvivant(nom)
    nom = string.lower(tostring(nom or ""))
    return string.find(nom, "surviv", 1, true) ~= nil
        or string.find(nom, "uninfect", 1, true) ~= nil
        or string.find(nom, "human", 1, true) ~= nil
        or string.find(nom, "humain", 1, true) ~= nil
        or nom == "innocent" or nom == "innocents"
end
local function possedeCouteauZombie(p)
    if not p then return false end
    local function chercher(conteneur)
        if not conteneur then return false end
        for _, objet in ipairs(conteneur:GetChildren()) do
            if objet:IsA("Tool") then
                local nom = string.lower(objet.Name)
                if nom == "knife" or string.find(nom, "knife", 1, true) then
                    return true
                end
            end
        end
        return false
    end
    return chercher(p.Character) or chercher(p:FindFirstChildOfClass("Backpack"))
end

-- Déclaration anticipée : modeZombie est défini plus bas, mais appelé ici.
local modeZombie
local function estZombieOuSurvivant(p)
    if not p then return nil end
    local Z = flyControl.Z
    if Z.vusGen ~= generationManche then
        Z.vusGen = generationManche
        Z.vus = {}
    end
    local perso = p.Character
    if perso and estDansLobby(perso) then
        Z.vus[p.Name] = nil
        return nil
    end
    if Z.vus[p.Name] then return true end
    local zombie = false
    if p.Team and estNomZombie(p.Team.Name) then
        zombie = true
    elseif attributZombie(p) or attributZombie(perso) then
        zombie = true
    else
        for _, conteneur in ipairs({ perso, p:FindFirstChildOfClass("Backpack") }) do
            if conteneur then
                for _, objet in ipairs(conteneur:GetChildren()) do
                    if objet:IsA("Tool") and estNomZombie(objet.Name) then zombie = true break end
                end
            end
            if zombie then break end
        end
        -- Infection : plusieurs porteurs de couteau en même temps = zombies.
        if not zombie and (Z.nbCouteaux or 0) >= 2 and possedeCouteauZombie(p) then zombie = true end
    end
    if zombie then Z.vus[p.Name] = true end
    return zombie
end
