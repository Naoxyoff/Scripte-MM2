local function rayonSolide(origine, direction, params)
	local exclusions = params.FilterDescendantsInstances
	for _ = 1, 6 do
		local hit = workspace:Raycast(origine, direction, params)
		if not hit then return nil end
		if hit.Instance.CanCollide then return hit end
		table.insert(exclusions, hit.Instance)
		params.FilterDescendantsInstances = exclusions
	end
	return nil
end
local function posePropre(r)
	local pos = r.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local exclusions = {}
	for _, joueur in ipairs(Players:GetPlayers()) do
		if joueur.Character then table.insert(exclusions, joueur.Character) end
	end
	params.FilterDescendantsInstances = exclusions
	local perso = r.Parent
	local hauteurPerso = 6
	if perso then
		local ok, taille = pcall(function() return perso:GetExtentsSize() end)
		if ok and taille then hauteurPerso = math.max(4, taille.Y) end
	end
	local origine = pos
	local sol = rayonSolide(origine, Vector3.new(0, -2000, 0), params)
	local y
	if sol then
		y = sol.Position.Y + hauteurPerso * 0.5 + 0.35
	else
		y = pos.Y + hauteurPerso * 0.5 + 1
	end
	local cam = workspace.CurrentCamera
	local regard = cam and Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) or Vector3.new(0, 0, -1)
	if regard.Magnitude < 0.05 then regard = Vector3.new(0, 0, -1) end
	local p = Vector3.new(pos.X, y, pos.Z)
	return CFrame.lookAt(p, p + regard.Unit)
end
