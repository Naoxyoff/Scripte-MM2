-- Réglages
-- Un nom de touche venant du fichier JSON peut être invalide : on le valide
-- avant d'indexer Enum.KeyCode, sinon tout le script s'arrête au chargement.
local function lireTouche(nom, defaut)
    local v = valeurConfig(nom, defaut.Name)
    local ok, code = pcall(function() return Enum.KeyCode[v] end)
    if ok and typeof(code) == "EnumItem" then return code end
    return defaut
end
