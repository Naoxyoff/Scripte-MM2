    local function statut(message, couleur)
        if labelStatut and labelStatut.Parent then
            labelStatut.Text = message
            labelStatut.TextColor3 = couleur or COL.MUET
        end
    end

    local function afficherArme(message)
        if labelArme and labelArme.Parent then
            labelArme.Text = message
        end
    end

    local function trouverGunDrop()

        if armeCache and armeCache.Parent and armeCache:IsA("BasePart")
            and armeCache:IsDescendantOf(workspace) then
            return armeCache
        end

        local maintenant = os.clock()
        if maintenant - derniereRecherche < 0.25 then
            return nil
        end
        derniereRecherche = maintenant
        armeCache = nil

        local objet = workspace:FindFirstChild("GunDrop", true)
        if not objet then return nil end

        if objet:IsA("BasePart") then
            armeCache = objet
        else
            armeCache = objet:FindFirstChildWhichIsA("BasePart", true)
        end
        return armeCache
    end

    local function possedeGun()
        local personnage = joueur.Character
        local sac = joueur:FindFirstChildOfClass("Backpack")

        local function verifier(conteneur)
            if not conteneur then return false end

            for _, objet in ipairs(conteneur:GetChildren()) do
                if objet:IsA("Tool")
                    and string.find(string.lower(objet.Name), "gun", 1, true) then
                    return true
                end
            end

            return false
        end

        return verifier(personnage) or verifier(sac)
    end

    local function grabGun()
        if grabEnCours then return end

        if os.clock() - dernierGrab < COOLDOWN_GRAB then
            return
        end

        if possedeGun() then
            statut("Tu possèdes déjà une arme", COL.MUET)
            return
        end

        local gunDrop = trouverGunDrop()
        if not gunDrop then
            statut("Aucune arme au sol", COL.ROUGE)
            afficherArme("Arme : introuvable")
            return
        end

        local personnage = joueur.Character
        local root = personnage and personnage:FindFirstChild("HumanoidRootPart")
        local humanoide = personnage and personnage:FindFirstChildOfClass("Humanoid")
        if not root or not humanoide or humanoide.Health <= 0 then
            statut("Personnage indisponible", COL.ROUGE)
            return
        end

        local distance = (root.Position - gunDrop.Position).Magnitude
        afficherArme(string.format("Arme : GunDrop · %.1f studs", distance))

        dernierGrab = os.clock()
        grabEnCours = true
        statut("Tentative à distance — sans déplacement", COL.ORANGE)

        local toucheDisponible = typeof(firetouchinterest) == "function"
        if toucheDisponible and gunDrop.Parent then
            pcall(firetouchinterest, root, gunDrop, 0)
            pcall(firetouchinterest, root, gunDrop, 1)
        end

        task.wait(0.7)
        if possedeGun() then
            statut("Revolver récupéré !", COL.VERT)
            afficherArme("Arme : dans ton inventaire")
        elseif not toucheDisponible then
            statut("Impossible : contact distant non disponible", COL.ROUGE)
        else
            statut("Refusé par MM2 : le serveur exige la proximité", COL.ORANGE)
        end

        grabEnCours = false
    end

    section(pageGun, "Récupération")

    carteBouton(
        pageGun,
        "Grab Gun",
        "Tente le contact à distance sans déplacer ton personnage (le serveur peut refuser)",
        "GRAB",
        COL.VIOLET,
        function()
            grabGun()
        end
    )

    interrupteur(
        pageGun,
        "Auto Grab Gun",
        "Surveille automatiquement l'apparition d'une arme au sol",
        false,
        function(v)
            autoGrab = v

            if v then
                statut("Surveillance activée", COL.VERT)
            else
                statut("Surveillance désactivée", COL.MUET)
            end
        end
    )

    task.spawn(function()
        while not fermee do
            if autoGrab then
                if not possedeGun() then
                    local arme = trouverGunDrop()

                    if arme then
                        afficherArme("Arme : GunDrop détectée")
                        grabGun()
                    else
                        afficherArme("Arme : aucune")
                    end
                else
                    afficherArme("Arme : déjà possédée")
                end
            end

            task.wait(INTERVALLE_SCAN)
        end
    end)

    connecter(joueur.CharacterAdded, function()
        armeCache = nil
        grabEnCours = false
        dernierGrab = 0
    end)
end

