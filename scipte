local function recoltable(p)
	if not piecesConnues[p] or not p:IsDescendantOf(workspace) then return false end
	if avaitTI[p] and not p:FindFirstChildOfClass("TouchTransmitter") then return false end
	return true
end

local function analyser(position)
	local n, dMin = 0, math.huge
	for i = 1, #piecesListe do
		local p = piecesListe[i]
		if recoltable(p) then
			n = n + 1
			local d = (p.Position - position).Magnitude
			if d < dMin then dMin = d end
		end
	end
	restantes, distanceMin = n, dMin
end

