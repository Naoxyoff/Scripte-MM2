local function calculerEchelleEcran()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local largeurCible = (conteneur and conteneur.Size.X.Offset > 0) and conteneur.Size.X.Offset or LARGEUR
    local hauteurCible = (conteneur and conteneur.Size.Y.Offset > 0) and conteneur.Size.Y.Offset or HAUTEUR
    local auto = math.min(1, (viewport.X - 28) / (largeurCible + 20), (viewport.Y - 28) / (hauteurCible + 20))
    auto = math.clamp(auto, 0.58, 1)
    scaleFenetre.Scale = auto * (echelleInterface / 100)
    if scaleBarre then scaleBarre.Scale = auto * (echelleInterface / 100) end
end
