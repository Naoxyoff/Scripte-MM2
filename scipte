                    if glisse and not bouge and surClic then surClic() end
                    glisse = false
                    deconnecter(finConnexion)
                    finConnexion = nil
                end
            end)
		end
	end)
	connecter(UserInputService.InputChanged, function(e)
		if glisse and (e.UserInputType == Enum.UserInputType.MouseMovement or e.UserInputType == Enum.UserInputType.Touch) then
			local d = e.Position - depart
			if d.Magnitude > 3 then bouge = true end
			cible.Position = UDim2.new(posDepart.X.Scale, posDepart.X.Offset + d.X, posDepart.Y.Scale, posDepart.Y.Offset + d.Y)
		end
	end)
