flyControl.activerFly = function(etat, silencieux)
    etat = etat == true

    -- Pendant un fling, les BodyMovers du vol entreraient en conflit avec
    -- le cube d'impact : on refuse l'activation manuelle.
    if etat and flingActif then
        if notifierInterface and not silencieux then
            notifierInterface("Fling en cours : fly bloqué", Color3.fromRGB(255, 150, 50), "fly_fling_" .. tostring(os.clock()))
        end
        if flyControl.synchroniserFly then flyControl.synchroniserFly(flyOn) end
        return
    end

    -- Le fly est prioritaire sur l'auto farm : on l'arrête proprement au lieu
    -- de laisser deux systèmes écrire la même CFrame/les mêmes vitesses.
    if etat and flyControl.farm and flyControl.farm.desactiver then
        pcall(flyControl.farm.desactiver)
    end

    flyOn = etat
    flyControl.flyOn = flyOn
    if flyOn then preparerFly() else nettoyerFly() end
    if flyControl.synchroniserFly then flyControl.synchroniserFly(flyOn) end
    if notifierInterface and not silencieux then
        notifierInterface(flyOn and "Fly activé" or "Fly désactivé",
            flyOn and Color3.fromRGB(74, 222, 128) or Color3.fromRGB(57, 52, 76),
            "fly_" .. tostring(os.clock()))
    end
end
flyControl.activerNoclip = function(etat, silencieux)
    etat = etat == true

    if etat and flingActif then
        if notifierInterface and not silencieux then
            notifierInterface("Fling en cours : noclip bloqué", Color3.fromRGB(255, 150, 50), "noclip_fling_" .. tostring(os.clock()))
        end
        if flyControl.synchroniserNoclip then flyControl.synchroniserNoclip(noclipOn) end
        return
    end

    -- Désactiver le noclip pendant le farm rendrait le déplacement à travers
    -- les murs incohérent : on arrête d'abord le farm.
    if not etat and flyControl.farm and flyControl.farm.desactiver then
        pcall(flyControl.farm.desactiver)
    end

    noclipOn = etat
    flyControl.noclipOn = noclipOn
    if noclipOn then attacherNoclip(joueur.Character) else viderNoclip() end
    if resynchroniserCollisionsFarm then pcall(resynchroniserCollisionsFarm) end
    if flyControl.synchroniserNoclip then flyControl.synchroniserNoclip(noclipOn) end
    if notifierInterface and not silencieux then
        notifierInterface(noclipOn and "Noclip activé" or "Noclip désactivé",
            noclipOn and Color3.fromRGB(74, 222, 128) or Color3.fromRGB(57, 52, 76),
            "noclip_" .. tostring(os.clock()))
    end
end
-- CORRECTION : permet à l'auto farm de connaître la vraie valeur de CanCollide d'une part
-- (celle d'avant le noclip), pour la restaurer correctement.
flyControl.collisionOriginale = function(part)
    local v = noclipOriginal[part]
    if v ~= nil then return v end
    return part.CanCollide
end
flyControl.setSpeed = function(v)
    flySpeed = v
    flyControl.flySpeed = v
end
flyControl.setNoclipTransp = function(v)
    noclipTransparence = math.clamp(v, 0, 100) / 100
    flyControl.noclipTransp = v
end

-- Après une téléportation, la hauteur de référence du noclip et le gyro du
-- fly appartiennent encore à l'ancienne position : on les recale.
flyControl.reinitialiserNoclipY = function()
    noclipRefY = racine and racine.Position.Y or nil
end
flyControl.reinitialiserApresTeleport = function()
    if flyVelocity then flyVelocity.Velocity = Vector3.zero end
    if flyGyro and racine and racine.Parent then flyGyro.CFrame = racine.CFrame end
end
end

