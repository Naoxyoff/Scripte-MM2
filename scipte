end
local function nomEquipeZombie(nom)
    nom = string.lower(tostring(nom or ""))
    if string.find(nom, "surviv", 1, true)
        or string.find(nom, "uninfect", 1, true)
        or string.find(nom, "human", 1, true) then
        return false
    end
    return estNomZombie(nom)
end
local function nomEquipeSurvivant(nom)
    nom = string.lower(tostring(nom or ""))
    return string.find(nom, "surviv", 1, true) ~= nil
        or string.find(nom, "uninfect", 1, true) ~= nil
        or string.find(nom, "human", 1, true) ~= nil
        or string.find(nom, "humain", 1, true) ~= nil
