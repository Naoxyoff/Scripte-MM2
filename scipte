-- Paramètres visuels centralisés : fréquence, épaisseur, opacité et portée.
local TRACEUR_HZ = 20
local TRACEUR_EPAISSEUR = 2
local TRACEUR_TRANSPARENCE = 0.22
local TRACEUR_DISTANCE_MAX = DISTANCE_MAX_CHAMS
local traceurs = {}

local function retirerTraceur(p)
    local ligne = traceurs[p]
    if ligne then
        traceurs[p] = nil
        pcall(function() ligne:Destroy() end)
    end
end

local function nettoyerTraceurs()
    for p in pairs(traceurs) do
        retirerTraceur(p)
    end
end

connecter(Players.PlayerRemoving, retirerTraceur)

local accumulateurTraceurs = 0
local intervalleTraceurs = 1 / TRACEUR_HZ

connecter(RunService.RenderStepped, function(dt)
    if fermee then
        nettoyerTraceurs()
        return
    end

    accumulateurTraceurs = accumulateurTraceurs + math.max(0, dt)
    if accumulateurTraceurs < intervalleTraceurs then return end
    -- Conserve le reliquat pour stabiliser la fréquence sans accumuler de dérive.
    accumulateurTraceurs = accumulateurTraceurs % intervalleTraceurs

    local camera = workspace.CurrentCamera
    if not tracersActifs or not rolesActifs or not camera or not gui or not gui.Parent then
        if next(traceurs) then nettoyerTraceurs() end
        return
    end

    -- Retire aussi les références devenues invalides avant de dessiner.
    for p, ligne in pairs(traceurs) do
        if not p.Parent or not ligne or not ligne.Parent then
            retirerTraceur(p)
        end
    end

    local viewport = camera.ViewportSize
    local origine = Vector2.new(viewport.X * 0.5, viewport.Y)
    for _, p in ipairs(Players:GetPlayers()) do
        local role = rolesParJoueur[p]
        local personnage = p.Character
        local root = personnage and personnage:FindFirstChild("HumanoidRootPart")
        local roleAutorise = role == "murder" or role == "sherif" or role == "heros"
        local dessine = false

        if p ~= joueur and roleAutorise and root and root:IsA("BasePart") then
            local distance = (root.Position - camera.CFrame.Position).Magnitude
            if distance <= TRACEUR_DISTANCE_MAX then
                local point, visible = camera:WorldToViewportPoint(root.Position)
                if visible and point.Z > 0 then
                    local arrivee = Vector2.new(point.X, point.Y)
                    local delta = arrivee - origine
                    if delta.Magnitude > 1 then
                        dessine = true
                        local ligne = traceurs[p]
                        if not ligne then
                            ligne = creer("Frame", {
                                Name = "TenebresTraceur",
                                AnchorPoint = Vector2.new(0.5, 0.5),
                                BorderSizePixel = 0,
                                BackgroundColor3 = couleurRole(role),
                                BackgroundTransparency = TRACEUR_TRANSPARENCE,
                                ZIndex = 5,
                            }, gui)
                            creer("UICorner", {
                                CornerRadius = UDim.new(1, 0),
                            }, ligne)
                            creer("UIGradient", {
                                Transparency = NumberSequence.new({
                                    NumberSequenceKeypoint.new(0, 0.12),
                                    NumberSequenceKeypoint.new(1, 0.38),
                                }),
                            }, ligne)
                            traceurs[p] = ligne
                        end

                        ligne.BackgroundColor3 = couleurRole(role)
                        ligne.Size = UDim2.fromOffset(delta.Magnitude, TRACEUR_EPAISSEUR)
                        ligne.Position = UDim2.fromOffset(
                            (origine.X + arrivee.X) * 0.5,
                            (origine.Y + arrivee.Y) * 0.5
                        )
                        ligne.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                    end
                end
            end
        end

        if not dessine then retirerTraceur(p) end
    end
end)
end

