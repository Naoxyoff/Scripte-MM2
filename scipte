		BackgroundTransparency = 1, TextColor3 = COL.TEXTE, Font = Enum.Font.Gotham,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Text = "",
	}
	for k, v in pairs(props) do base[k] = v end
	return creer("TextLabel", base, parent)
end

-- Correctif affichage : fige un texte statique (titres, onglets). Si une couche externe
-- le réécrit, il est restauré. Garde-fou anti-boucle : 25 restaurations maximum.
local function figerTexte(objet, valeur)
	if not objet then return objet end
	objet.Text = valeur
	local restaurations = 0
	connecter(objet:GetPropertyChangedSignal("Text"), function()
		if objet.Text ~= valeur and restaurations < 25 then
			restaurations = restaurations + 1
			objet.Text = valeur
		end
	end)
	return objet
end

