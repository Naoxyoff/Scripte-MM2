local function carteTouche(page, nom, description, lire, ecrire)
	local c = carte(page, 56)
	texte(c, {
		Size = UDim2.new(1, -140, 0, 18), Position = UDim2.fromOffset(22, 11),
		Text = nom, Font = Enum.Font.GothamBold, TextSize = 12,
	})
	texte(c, {
