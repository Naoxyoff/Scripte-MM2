local finMancheEnAttente = false
-- Correctif : verrou de fin de manche pour l'Auto Farm. Il reste actif même si un événement
-- de rôles arrive juste après la fin et remet mancheTerminee à false.
local latchFinManche, tFinManche = false, 0
local nouvelleMancheAnnoncee = false
-- Compteur fiable : il avance uniquement après une fin de manche confirmée
-- puis la réception des rôles de la manche suivante.
local generationManche = 0
local dernierRoleServeur = 0
local connexionsMort = {}
do
	local RS = game:GetService("ReplicatedStorage")
	local function normaliser(v)
		if type(v) ~= "string" then return nil end
		local t = string.lower(v)
		if string.find(t, "murder", 1, true) then return "murder" end

		if string.find(t, "sher", 1, true) then return "sherif" end
		if string.find(t, "hero", 1, true) then return "heros" end
		if string.find(t, "innocent", 1, true) then return "innocent" end
		return nil
	end

	local function lireTable(t)
		if type(t) ~= "table" then return nil end
		local res, trouve, visites = {}, false, {}
		local function parcourir(tab, profondeur)
			if type(tab) ~= "table" or profondeur > 5 or visites[tab] then return end
			visites[tab] = true
			for k, v in pairs(tab) do
				if type(k) == "string" and type(v) == "table" then
					local r = normaliser(v.Role or v.role or v.RoleName or v.roleName or v.PlayerRole or v.playerRole)
					if r then res[k] = r trouve = true else parcourir(v, profondeur + 1) end
				elseif type(k) == "string" and type(v) == "string" then
					local r = normaliser(v)
					if r then res[k] = r trouve = true end
				end
			end
		end
		parcourir(t, 0)
		return trouve and res or nil
	end
	local function brancher(o)
		if not o:IsA("RemoteEvent") then return end
		local nomEvt = string.lower(o.Name)
		local finManche = string.find(nomEvt, "roundend", 1, true) or string.find(nomEvt, "endround", 1, true)
			or string.find(nomEvt, "winner", 1, true) or string.find(nomEvt, "gameover", 1, true)
		pcall(function()
			connecter(o.OnClientEvent, function(...)
				if fermee then return end
				if finManche then

					mancheTerminee = true
					latchFinManche, tFinManche = true, os.clock()
					finMancheEnAttente = true
					table.clear(rolesServeur)
					table.clear(joueursElimines)
					for _, p in ipairs(Players:GetPlayers()) do
						rolesParJoueur[p] = "innocent"
						local h = halos[p]
						if h and h.Parent then
							h.FillColor = COL.COULEUR_INNOCENT
							h.OutlineColor = COL.COULEUR_INNOCENT:Lerp(Color3.new(1, 1, 1), 0.3)
						end
						local b = boites[p]
						if b and b.Parent then b.Color3 = COL.COULEUR_INNOCENT end
					end
					return
				end
				for i = 1, select("#", ...) do
					local res = lireTable((select(i, ...)))
					if res then

						if mancheTerminee then
							mancheTerminee = false
							nouvelleMancheAnnoncee = true
							generationManche = generationManche + 1
						end
						dernierRoleServeur = os.clock()

						for nom, role in pairs(res) do
							if not joueursElimines[nom] then rolesServeur[nom] = role end
						end
					end
				end
			end)
		end)
	end
	task.spawn(function()
		local remotes = RS:WaitForChild("Remotes", 15)
		if not remotes then return end
		for _, o in ipairs(remotes:GetDescendants()) do brancher(o) end
		connecter(remotes.DescendantAdded, brancher)
	end)
end
