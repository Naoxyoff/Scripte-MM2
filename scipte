local cacheInventaireRoles = setmetatable({}, { __mode = "k" })
local DUREE_CACHE_INVENTAIRE = 0.35
local function nomOutilNormalise(nom)
    return string.gsub(string.lower(tostring(nom or "")), "[%s_%-]", "")
end
local function aOutil(joueurCible, nom)
    if not joueurCible then return false end
    local perso = joueurCible.Character
    local sac = joueurCible:FindFirstChildOfClass("Backpack") or joueurCible:FindFirstChild("Backpack")
    local maintenant = os.clock()
    local cache = cacheInventaireRoles[joueurCible]
    if not cache or cache.personnage ~= perso or cache.sac ~= sac
        or maintenant - cache.temps >= DUREE_CACHE_INVENTAIRE then
        local noms = {}
        local function analyser(conteneur)
            if not conteneur then return end
            -- Les armes MM2 sont des Tools directement équipés ou dans le Backpack.
            -- Ne pas parcourir les accessoires, modèles et descendants décoratifs.
            for _, objet in ipairs(conteneur:GetChildren()) do
                if objet:IsA("Tool") then
                    noms[nomOutilNormalise(objet.Name)] = true
                end
            end
        end
        analyser(perso)
        analyser(sac)
        cache = { personnage = perso, sac = sac, temps = maintenant, noms = noms }
        cacheInventaireRoles[joueurCible] = cache
    end
    local attendu = nomOutilNormalise(nom)
    if attendu == "knife" then
        return cache.noms.knife == true or cache.noms.defaultknife == true
    elseif attendu == "gun" then
        return cache.noms.gun == true or cache.noms.defaultgun == true
            or cache.noms.revolver == true
    end
    return cache.noms[attendu] == true
end
local function joueurVivant(p)
	if not p then return false end
