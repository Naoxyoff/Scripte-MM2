    local pointDepart, tailleDepart
    connecter(poigneeRedimensionnement.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            redimensionne = true
            pointDepart = input.Position
            tailleDepart = conteneur.Size
            connecter(input.Changed, function()
                if input.UserInputState == Enum.UserInputState.End then redimensionne = false end
            end)
        end
    end)
    connecter(UserInputService.InputChanged, function(input)
        if not redimensionne then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - pointDepart
        local largeur = math.clamp(tailleDepart.X.Offset + delta.X, 560, 1000)
        local hauteur = math.clamp(tailleDepart.Y.Offset + delta.Y, 360, 760)
        conteneur.Size = UDim2.fromOffset(largeur, hauteur)
        calculerEchelleEcran()
    end)
end

