local function choisirCible(position, murderPos)
	local t = os.clock()
	local meilleure, meilleureD = nil, math.huge

	for passe = 1, 2 do
		meilleure, meilleureD = nil, math.huge
		for i = 1, #piecesListe do
			local p = piecesListe[i]
			local finAbandon = abandonnees[p]
			local enDelai = finAbandon and finAbandon > t
			if recoltable(p) and ((passe == 1 and not enDelai) or passe == 2) then
				local pp = p.Position
				if math.abs(pp.Y - referenceY) <= farmCfg.margeVerticale
					and not (murderPos and (pp - murderPos).Magnitude < RAYON_MURDER) then
					local d = (pp - position).Magnitude

					if enDelai then d = d + 12 end
					if d < meilleureD then meilleure, meilleureD = p, d end
				end
			end
		end
		if meilleure then return meilleure end
	end
	return nil
end

local lobbyCentreCache = nil
local prochainCalculLobby = 0

local function centreLobby()
	for _, nom in ipairs({ "Lobby", "lobby" }) do
		local lobby = workspace:FindFirstChild(nom)
		if lobby then
			local spawn = lobby:FindFirstChildWhichIsA("SpawnLocation", true)
			if spawn then return spawn.Position end
			local ok, cf = pcall(function() return lobby:GetBoundingBox() end)
			if ok and cf then return cf.Position end
		end
	end
	return nil
end

local function estAuLobby()
	if not racine or not racine.Parent then return false end
	local t = os.clock()
	if t > prochainCalculLobby then
		prochainCalculLobby = t + 3
		lobbyCentreCache = centreLobby()
	end
	if not lobbyCentreCache then return false end
	return (racine.Position - lobbyCentreCache).Magnitude < RAYON_LOBBY
end

verifierLobbyPourIndex = estAuLobby

local function trouverLobby()
	local centre = centreLobby()
	if centre then return CFrame.new(centre + Vector3.new(0, 5, 0)) end
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then return CFrame.new(spawn.Position + Vector3.new(0, 5, 0)) end
	return CFrame.new(-6, 10, 2)
end

local ROT_FIXE = CFrame.fromMatrix(
	Vector3.zero,
	Vector3.new(0, 0, -1):Cross(Vector3.new(0, -1, 0)),
	Vector3.new(0, 0, -1),
	Vector3.new(0, -1, 0)
)
local function cframeOriente(position)
	return CFrame.new(position) * ROT_FIXE
end

