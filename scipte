local function appliquerStyleSuivi(mode)
    retirerStyleSuivi()
    local r, h = racine, humanoide
    if not r or not h then return end
    local perso = r.Parent
    pcall(function()
        local animate = perso and perso:FindFirstChild("Animate")
        if animate and animate:IsA("LocalScript") then
            animate.Disabled = true
            animateDesactive = animate
        end
        local animator = h:FindFirstChildOfClass("Animator")
        if animator then
            for _, piste in ipairs(animator:GetPlayingAnimationTracks()) do piste:Stop(0.1) end
        else
            animator = Instance.new("Animator")
            animator.Parent = h
        end
        local estR6 = h.RigType == Enum.HumanoidRigType.R6
        local ids = (mode == "epaules") and ANIM_ASSIS or ANIM_COURSE
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. (estR6 and ids.r6 or ids.r15)
        local piste = animator:LoadAnimation(anim)
        piste.Priority = Enum.AnimationPriority.Action4
        piste.Looped = true
        piste:Play(0.25)
        pisteSuivi, animSuivi = piste, anim
    end)
end
local function noterSuivi(message, couleur)
    if notifierInterface then
        pcall(notifierInterface, message, couleur or COL.GRIS, "suivi_" .. tostring(os.clock()))
    end
end
local function majLabelSuivi()
    if not labelSuivi then return end
    if suiviMode and suiviCible then
        labelSuivi.Text = (suiviMode == "epaules" and "Sur les épaules de " or "Orbite autour de ") .. suiviCible.DisplayName
    else
        labelSuivi.Text = "Aucune cible"
    end
end
local function arreterSuivi(silencieux)
    if not suiviMode then return end
    suiviMode, suiviCible = nil, nil
    flyControl.suiviActif = false
    retirerStyleSuivi()
    local r, h = racine, humanoide
    if r and r.Parent then
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if h and h.Parent and h.Health > 0 then
        pcall(function()
            h.PlatformStand = false
            h:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    if noclipParSuivi then
        noclipParSuivi = false
        if flyControl.noclipOn then flyControl.activerNoclip(false, true) end
    end
    majLabelSuivi()
    if not silencieux then noterSuivi("Suivi arrêté", COL.GRIS) end
end
flyControl.arreterSuivi = arreterSuivi
local function demarrerSuivi(mode, cible)
    if fermee or not cible or cible == joueur or cible.Parent ~= Players then return end
    if suiviMode == mode and suiviCible == cible then
        arreterSuivi()
        return
    end
    if flingActif or flyControl.farmActif then
        noterSuivi("Fling / Auto Farm en cours : suivi bloqué", COL.ORANGE)
        return
    end
    local perso = cible.Character
    local rp = perso and perso:FindFirstChild("HumanoidRootPart")
    if not rp then
        noterSuivi(cible.DisplayName .. " est introuvable", COL.ROUGE)
        return
    end
    if not racine or not racine.Parent or not humanoide or humanoide.Health <= 0 then
        noterSuivi("Ton personnage n'est pas prêt", COL.ROUGE)
        return
    end
    if flyControl.flyOn then flyControl.activerFly(false, true) end
    suiviMode, suiviCible = mode, cible
    flyControl.suiviActif = true
    angleOrbite = 0
    appliquerStyleSuivi(mode)
    if not flyControl.noclipOn then
        noclipParSuivi = true
        flyControl.activerNoclip(true, true)
    end
    majLabelSuivi()
    noterSuivi((mode == "epaules" and "Sur les épaules de " or "Orbite autour de ") .. cible.DisplayName, COL.VERT)
end
connecter(RunService.Heartbeat, function(dt)
    if not suiviMode or fermee then return end
    local r, h = racine, humanoide
    if flingActif or flyControl.farmActif or not r or not r.Parent or not h or h.Health <= 0 then
        arreterSuivi(true)
        return
    end
    local perso = suiviCible and suiviCible.Character
    local rp = perso and perso:FindFirstChild("HumanoidRootPart")
    local hc = perso and perso:FindFirstChildOfClass("Humanoid")
    if not suiviCible or not suiviCible.Parent or not rp or not hc or hc.Health <= 0 then
        arreterSuivi()
        noterSuivi("Cible perdue", COL.ORANGE)
        return
    end
    pcall(function()
        if not h.PlatformStand then h.PlatformStand = true end
        local cf
        local souplesse = 1 - math.exp(-dt * 16)
        if suiviMode == "epaules" then
            cf = rp.CFrame * CFrame.new(0, 2.25, 0.1)
            souplesse = 1 - math.exp(-dt * 24)
        else

            local vitesseLineaire = math.clamp(orbiteVitesse * 2.2, 4, 22)
            angleOrbite = (angleOrbite + (vitesseLineaire / math.max(orbiteRayon, 1)) * dt) % (math.pi * 2)
            local centre = rp.Position + Vector3.new(0, orbiteHauteur, 0)
            local pos = centre + Vector3.new(math.cos(angleOrbite) * orbiteRayon, 0, math.sin(angleOrbite) * orbiteRayon)
            local tangente = Vector3.new(-math.sin(angleOrbite), 0, math.cos(angleOrbite))
            cf = CFrame.lookAt(pos, pos + tangente)
            souplesse = 1 - math.exp(-dt * 22)
            if pisteSuivi then pcall(function() pisteSuivi:AdjustSpeed(math.clamp(vitesseLineaire / 14, 0.5, 1.6)) end) end
        end

        if (r.Position - cf.Position).Magnitude > 20 then souplesse = 1 end
        cf = r.CFrame:Lerp(cf, math.clamp(souplesse, 0, 1))
        r.CFrame = cf
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)

    if flyControl.reinitialiserNoclipY then pcall(flyControl.reinitialiserNoclipY) end
    if reinitialiserAntiFling then pcall(reinitialiserAntiFling) end
end)
