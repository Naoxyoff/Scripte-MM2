local function creer(classe, props, parent)
	local o = Instance.new(classe)
	-- Correctif affichage : empêche la retraduction automatique Roblox / hook d'exécuteur
	if classe == "TextLabel" or classe == "TextButton" or classe == "TextBox" then
		pcall(function() o.AutoLocalize = false end)
	end
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

