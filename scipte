end

function basculerReduit()
	reduit = not reduit
	if reduit then poserBarreEnHaut() end
	majEtat()
end

local function rendreDeplacable(poignee, cible, surClic)
	local glisse, depart, posDepart, bouge = false, nil, nil, false
	connecter(poignee.InputBegan, function(e)
		if e.UserInputType == Enum.UserInputType.MouseButton1 or e.UserInputType == Enum.UserInputType.Touch then
			glisse, depart, posDepart, bouge = true, e.Position, cible.Position, false
			connecter(e.Changed, function()
				if e.UserInputState == Enum.UserInputState.End then
					if glisse and not bouge and surClic then surClic() end
					glisse = false
				end
			end)
		end
	end)
	connecter(UserInputService.InputChanged, function(e)
		if glisse and (e.UserInputType == Enum.UserInputType.MouseMovement or e.UserInputType == Enum.UserInputType.Touch) then
			local d = e.Position - depart
			if d.Magnitude > 3 then bouge = true end
			cible.Position = UDim2.new(posDepart.X.Scale, posDepart.X.Offset + d.X, posDepart.Y.Scale, posDepart.Y.Offset + d.Y)
		end
	end)
end

