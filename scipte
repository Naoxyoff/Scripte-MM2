                    end
                end)
            end

            local intensite = VITESSE_COLLE
            if contactAt and not envoiDetecte then
                intensite = math.min(
                    VITESSE_COLLE_MAX,
                    VITESSE_COLLE + math.max(0, tNow - contactAt) * 150
                )
            end
            pcall(function()
                racineDepart.CFrame = cframeImpact

                racineDepart.AssemblyLinearVelocity = vCible + direction * (contactAt
                    and math.min(PUISSANCE_PIC_MAX, PUISSANCE_PIC + (tNow - contactAt) * 20000)
                    or intensite)
                racineDepart.AssemblyAngularVelocity = Vector3.new(VITESSE_ROTATION, VITESSE_ROTATION, VITESSE_ROTATION)
