local function desactiverPiece(info, p)
	if info.parts[p] == nil then
		info.parts[p] = p.CanCollide
		info.liste[#info.liste + 1] = p
	end
	p.CanCollide = false
end
local function oublier(autre, infoAttendue)
	local info = suivis[autre]
	if not info then return end
	if infoAttendue and info ~= infoAttendue then return end
	for _, c in ipairs(info.conns) do c:Disconnect() end
	for p, original in pairs(info.parts) do
		if p.Parent then p.CanCollide = original end
	end
	suivis[autre] = nil
end
local function suivre(autre, perso)
	oublier(autre)
	local info = { parts = {}, liste = {}, conns = {}, perso = perso }
	suivis[autre] = info
	local function ajouter(p)
		if p:IsA("BasePart") then
			if actif then
				desactiverPiece(info, p)
			elseif info.parts[p] == nil then
				info.parts[p] = p.CanCollide
				info.liste[#info.liste + 1] = p
			end
		end
	end
	for _, p in ipairs(perso:GetDescendants()) do ajouter(p) end
	table.insert(info.conns, connecter(perso.DescendantAdded, ajouter))
	table.insert(info.conns, connecter(perso.DescendantRemoving, function(p)
		if info.parts[p] ~= nil then
			info.parts[p] = nil
			for i = #info.liste, 1, -1 do
				if info.liste[i] == p then table.remove(info.liste, i) break end
			end
		end
	end))
	table.insert(info.conns, connecter(perso.AncestryChanged, function(_, parent)
		if not parent then oublier(autre, info) end
	end))
end
local function surveillerJoueur(autre)
	if autre == joueur or fermee then return end
	connecter(autre.CharacterAdded, function(perso)
		if fermee or not actif then return end
		suivre(autre, perso)
	end)
	connecter(autre.CharacterRemoving, function(perso)
		local info = suivis[autre]
		if info and info.perso == perso then oublier(autre, info) end
	end)
	if actif and autre.Character then suivre(autre, autre.Character) end
end
